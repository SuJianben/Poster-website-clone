<section class="hero-product"><div class="hero-product__inner"><div class="hero-product__media"><img src="{{ 'reference-hero.jpg' | asset_url }}" alt="" width="1920" height="1080" loading="eager"></div><article class="hero-product__card"><div class="hero-product__card-image"><img src="{{ 'reference-hero-card.jpg' | asset_url }}" alt="" width="1080" height="1080" loading="eager"></div><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p class="hero-product__price">{{ section.settings.price | escape }}</p><a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a></div></article></div></section>
{% schema %}{"name":"Hero with product","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Trending limited edition"},{"type":"text","id":"heading","label":"Heading","default":"Royal Duck 2.0"},{"type":"text","id":"price","label":"Price","default":"From $169.00"},{"type":"text","id":"button_label","label":"Button label","default":"Explore artwork"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Hero with product"}]}{% endschema %}
