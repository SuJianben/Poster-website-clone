<section class="newsletter"><div class="page-width newsletter__inner"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div>{{ section.settings.text }}</div></div>{% form 'customer', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="NewsletterEmail">Email</label><input id="NewsletterEmail" type="email" name="contact[email]" placeholder="Your email address" required><button class="button" type="submit">{{ section.settings.button_label | escape }}</button>{% if form.posted_successfully? %}<p>Thank you for subscribing.</p>{% endif %}{% endform %}</div></section>
{% schema %}{"name":"Newsletter","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"STAY IN THE LOOP"},{"type":"text","id":"heading","label":"Heading","default":"Never miss a new release."},{"type":"richtext","id":"text","label":"Text","default":"<p>Sign up for new collections, private offers and art inspiration.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Subscribe"}],"presets":[{"name":"Newsletter"}]}{% endschema %}
