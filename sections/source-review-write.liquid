{{ 'source-review-write.css' | asset_url | stylesheet_tag }}
{{ 'source-review-write-layout.css' | asset_url | stylesheet_tag }}
{{ 'source-product-reviews.css' | asset_url | stylesheet_tag }}
{{ 'source-reviews-summary.css' | asset_url | stylesheet_tag }}
<script src="{{ 'source-review-write.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'source-product-reviews.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'source-reviews-summary.js' | asset_url }}" defer="defer"></script>

{%- assign review_endpoint = section.settings.apps_script_endpoint | strip -%}
{%- assign form_id = 'ReviewContactForm-' | append: section.id -%}
{%- assign apps_script_target = 'ReviewAppsScriptTarget-' | append: section.id -%}
{%- assign form_action = '/contact' -%}
{%- if review_endpoint != blank -%}
  {%- assign form_action = review_endpoint -%}
{%- endif -%}

<section class="srw-page" {{ section.shopify_attributes }} data-srw-page data-analytics-page="review_write" data-srw-review-endpoint="{{ review_endpoint | escape }}">
  <h1 class="srw-page__title">{{ section.settings.title }}</h1>
  <h2 class="srw-page__heading">{{ section.settings.heading }}</h2>

  {%- if review_endpoint != blank -%}
    <iframe id="{{ apps_script_target }}" name="{{ apps_script_target }}" class="srw-submit-frame" title="Review submission" hidden aria-hidden="true" tabindex="-1"></iframe>
  {%- endif -%}
  <form action="{{ form_action | escape }}" method="post"{% if review_endpoint != blank %} target="{{ apps_script_target }}" data-srw-apps-script-form{% endif %} id="{{ form_id }}" class="srw-form">
    {%- if review_endpoint == blank -%}
      <input type="hidden" name="form_type" value="contact">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="return_to" value="{{ request.path | escape }}">
    {%- endif -%}
    <input type="hidden" name="submission_id" data-srw-submission-id value="">
    <input type="hidden" name="review_payload_version" value="1">
    <input type="hidden" name="review_shop_domain" value="{{ shop.permanent_domain | default: shop.domain | escape }}">
    <input type="hidden"{% if product != blank %} name="review_product_id"{% endif %} data-srw-product-id value="{% if product != blank %}{{ product.id }}{% endif %}">
    <input type="hidden" name="review_product_handle" value="{% if product != blank %}{{ product.handle | escape }}{% endif %}">
    <input type="hidden" name="review_product_title" value="{% if product != blank %}{{ product.title | escape }}{% endif %}">
    <input type="hidden" name="review_product_url" value="{% if product != blank %}{{ shop.url }}{{ product.url }}{% endif %}">
    <input type="hidden" name="review_started_at" data-srw-started-at value="">
    <input type="hidden" name="started_at" data-srw-started-at-alias value="">
    <input type="text" name="website" value="" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true">
    {%- if product == blank -%}
      <div class="srw-field srw-product-picker-field">
        <label for="srw-product-picker-{{ section.id }}">Produkt auswählen</label>
        <select id="srw-product-picker-{{ section.id }}" name="review_product_id" data-srw-product-picker required aria-describedby="srw-product-picker-hint-{{ section.id }}">
          <option value="">Bitte ein Produkt auswählen</option>
          {%- for picker_product in collections.all.products limit: 250 -%}
            <option
              value="{{ picker_product.id }}"
              data-product-id="{{ picker_product.id }}"
              data-product-handle="{{ picker_product.handle | escape }}"
              data-product-title="{{ picker_product.title | escape }}"
              data-product-url="{{ shop.url }}{{ picker_product.url }}"
            >{{ picker_product.title }}</option>
          {%- endfor -%}
        </select>
        <p id="srw-product-picker-hint-{{ section.id }}" class="srw-product-picker-field__hint">Bitte wähle das Produkt, auf das sich deine Bewertung bezieht.</p>
      </div>
    {%- endif -%}
    <fieldset class="srw-form__contact">
      <div class="srw-field">
        <label for="srw-author-{{ section.id }}">Name</label>
        <input id="srw-author-{{ section.id }}" name="contact[name]" type="text" placeholder="Gib deinen Namen ein" autocomplete="name" required>
      </div>
      <div class="srw-field">
        <label for="srw-email-{{ section.id }}">E-Mail</label>
        <input id="srw-email-{{ section.id }}" name="contact[email]" type="email" placeholder="john.smith@example.com" autocomplete="email" required>
      </div>
    </fieldset>

    <fieldset class="srw-rating">
      <legend class="srw-field__label">Bewertung</legend>
      <input data-srw-rating-input name="contact[Rating]" type="hidden" value="5">
      <div class="srw-rating__stars" role="group" aria-label="Bewertung auswaehlen">
        {% for star in (1..5) %}
          <button type="button" data-srw-rating="{{ star }}" aria-label="{{ star }} von 5 Sternen" aria-pressed="false">&#9734;</button>
        {% endfor %}
      </div>
    </fieldset>

    <div class="srw-field">
      <label for="srw-title-{{ section.id }}">Titel der Bewertung</label>
      <input id="srw-title-{{ section.id }}" name="contact[Review title]" type="text" placeholder="Der Bewertung einen Titel geben" required>
    </div>
    <div class="srw-field">
      <label for="srw-message-{{ section.id }}">Gefallen dir unsere Sachen?</label>
      <textarea id="srw-message-{{ section.id }}" name="contact[body]" required></textarea>
    </div>

    <fieldset class="srw-products">
      <legend><h3>Was hast du bestellt?</h3></legend>
      {% assign product_types = 'Leinwandbild|Acrylglasbild|Blattgold-/silberbild|Poster|Wandskulptur' | split: '|' %}
      {% for product_type in product_types %}
        <label><input type="checkbox" name="contact[Ordered product type {{ forloop.index }}]" value="{{ product_type }}">{{ product_type }}</label>
      {% endfor %}
    </fieldset>

    <div class="srw-field">
      <label for="srw-product-{{ section.id }}">Produktname</label>
      <input id="srw-product-{{ section.id }}" name="contact[Product name]" type="text" placeholder="Name des gekauften Produkts" required>
    </div>
    <div class="srw-field">
      <label for="srw-age-{{ section.id }}">Wie alt bist du?</label>
      <input id="srw-age-{{ section.id }}" name="contact[Age]" type="text">
    </div>
    <div class="srw-field">
      <label for="srw-job-{{ section.id }}">Was machst du beruflich?</label>
      <input id="srw-job-{{ section.id }}" name="contact[Job]" type="text">
    </div>
    <div class="srw-field">
      <label for="srw-room-{{ section.id }}">Wo haengt das Wandbild?</label>
      <input id="srw-room-{{ section.id }}" name="contact[Room]" type="text">
    </div>

    <div class="srw-scales">
      {% assign scale_prompts = 'Wie bewertest du die Druckqualitaet?|Wie bewertest du die Verarbeitung?|Wie bewertest du das Preis-Leistungs-Verhaeltnis?' | split: '|' %}
      {% for prompt in scale_prompts %}
        <fieldset class="srw-scale" data-srw-scale>
          <legend>{{ prompt }}</legend>
          <div class="srw-scale__options">
            {% for value in (1..5) %}
              <label class="srw-scale__option">
                <input type="radio" name="contact[Quality scale {{ forloop.parentloop.index }}]" value="{{ value }}" aria-label="{{ value }} von 5">
                <span class="visually-hidden">{{ value }} von 5</span>
              </label>
            {% endfor %}
          </div>
          <div class="srw-scale__caption"><span>Schlecht</span><span>Perfekt</span></div>
        </fieldset>
      {% endfor %}
    </div>

    <div class="srw-field">
      <label for="srw-instagram-{{ section.id }}">Instagram Account (Optional)</label>
      <input id="srw-instagram-{{ section.id }}" name="contact[Instagram]" type="text">
    </div>
    <div class="srw-field">
      <label for="srw-image-url-{{ section.id }}">Bild-Link (Optional)</label>
      <input id="srw-image-url-{{ section.id }}" name="contact[Image link]" type="url" placeholder="https://">
    </div>

    <div class="srw-form__actions"><button class="srw-submit" type="submit">Bewertung abgeben</button></div>
    <p class="srw-form__status" data-srw-status aria-live="polite"></p>
  </form>

  {%- if review_endpoint != blank -%}
    <script>
      (() => {
        const form = document.getElementById({{ form_id | json }});
        if (!form) return;
        const query = new URLSearchParams(window.location.search);
        const setQueryValue = (selector, key) => {
          const field = form.querySelector(selector);
          const value = query.get(key);
          if (field && value) field.value = value;
          return field;
        };
        const productHandle = setQueryValue('[name="review_product_handle"]', 'product_handle');
        const productId = setQueryValue('[data-srw-product-id]', 'product_id');
        setQueryValue('[name="review_product_title"]', 'product_title');
        const productPicker = form.querySelector('[data-srw-product-picker]');
        if (productPicker && productId?.value) productPicker.value = productId.value;
        const productUrl = form.querySelector('[name="review_product_url"]');
        if (productUrl && !productUrl.value && productHandle?.value) {
          productUrl.value = new URL(`/products/${encodeURIComponent(productHandle.value)}`, window.location.origin).href;
        }
        const createSubmissionId = () => {
          if (window.crypto?.randomUUID) return window.crypto.randomUUID();
          return `rvw_${Date.now()}_${Math.random().toString(36).slice(2)}`;
        };
        const submissionId = form.querySelector('[data-srw-submission-id]');
        const startedAt = form.querySelector('[data-srw-started-at]');
        const startedAtAlias = form.querySelector('[data-srw-started-at-alias]');
        if (submissionId && !submissionId.value) submissionId.value = createSubmissionId();
        if (startedAt && !startedAt.value) startedAt.value = String(Date.now());
        if (startedAtAlias && !startedAtAlias.value) startedAtAlias.value = startedAt?.value || String(Date.now());
        form.dataset.srwBootstrapReady = 'true';
      })();
    </script>
  {%- endif -%}

  <section class="sprv srw-page__reviews" data-sprv-root data-section-id="{{ section.id }}-reviews" aria-label="Customer review list">
    <div class="sprv__widget"><div class="sprv__inner">
      {% render 'source-product-reviews-list', review_count: section.settings.review_count, show_write: false %}
    </div></div>
  </section>
</section>

{% schema %}
{
  "name": "撰写评论",
  "settings": [
    { "type": "text", "id": "title", "label": "页面标题", "default": "Write a Review" },
    { "type": "text", "id": "heading", "label": "表单标题", "default": "Kundenbewertungen" },
    { "type": "text", "id": "review_count", "label": "评价数量", "default": "2625" },
    {
      "type": "url",
      "id": "apps_script_endpoint",
      "label": "Google Apps Script 审核地址",
      "info": "填入已部署的 Apps Script /exec 地址后，评论会进入 Google Sheet 待审核；留空则继续使用 Shopify 联系表单。"
    }
  ]
}
{% endschema %}
