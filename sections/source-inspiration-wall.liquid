{{ 'source-inspiration-wall.css' | asset_url | stylesheet_tag }}
<script src="{{ 'source-inspiration-wall.js' | asset_url }}" defer="defer"></script>
<style>
  .inspiration-wall__modal[hidden]{display:none}
  .inspiration-wall__tile{height:auto!important;min-height:0!important;border-radius:0!important}
  .inspiration-wall__modal{position:fixed;inset:0;z-index:2147483000;display:grid;place-items:center;width:100vw;max-width:none;height:100vh;max-height:none;background:rgba(0,0,0,.46);overflow:hidden}
  .inspiration-wall__modal-shell{width:min(1230px,calc(100vw - 170px));height:min(850px,calc(100vh - 40px));max-width:none;max-height:none}
  @media(max-width:989px){.inspiration-wall__modal-shell{width:calc(100vw - 64px);height:min(760px,calc(100vh - 32px))}}
  @media(max-width:549px){.inspiration-wall__modal{display:block;background:#fff}.inspiration-wall__modal-shell{width:100vw;height:100dvh}}
</style>

<section class="inspiration-wall" data-inspiration-wall>
  <header class="inspiration-wall__heading">
    <h1>{{ section.settings.heading }}</h1>
    <a class="inspiration-wall__instagram" href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/dotcomcanvas/' }}" target="_blank" rel="noopener" aria-label="Follow DOTCOMCANVAS on Instagram">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.8" r="1"></circle></svg>
    </a>
  </header>

  <div class="inspiration-wall__grid" data-inspiration-grid>
    {% assign tile_count = 0 %}
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% liquid
          assign tile_product = block.settings.product
          assign tile_image = block.settings.image | default: tile_product.featured_image
          assign tile_product_image = tile_product.featured_image
          assign tile_username = block.settings.username | default: shop.name
          assign tile_caption = block.settings.caption
          assign tile_alt = block.settings.image_alt | default: tile_product.title | default: section.settings.image_alt
        %}
        {% if tile_image != blank %}
          {% assign tile_count = tile_count | plus: 1 %}
          <button class="inspiration-wall__tile{% if tile_count > 12 %} is-hidden{% endif %}" type="button" data-inspiration-tile data-index="{{ tile_count | minus: 1 }}" data-image="{{ tile_image | image_url: width: 1600 }}" data-username="{{ tile_username | escape }}" data-caption="{{ tile_caption | escape }}" data-date="{{ block.settings.date_label | escape }}" data-product-title="{{ tile_product.title | escape }}" data-product-image="{% if tile_product_image != blank %}{{ tile_product_image | image_url: width: 600 }}{% endif %}" data-product-url="{{ tile_product.url }}" data-likes="{{ block.settings.likes | default: 0 | escape }}" data-comments="{{ block.settings.comments | default: 0 | escape }}" {{ block.shopify_attributes }}>
            {{ tile_image | image_url: width: 900 | image_tag: alt: tile_alt, loading: 'lazy', widths: '240, 360, 500, 720, 900', sizes: '(max-width: 549px) 50vw, (max-width: 989px) 33vw, 17vw' }}
            <span>{{ section.settings.tile_label }}</span>
          </button>
        {% endif %}
      {% endfor %}
    {% else %}
      {% assign source_collection = section.settings.collection | default: collections.all %}
      {% for tile_product in source_collection.products limit: 18 %}
        {% if tile_product.featured_image != blank %}
          {% assign tile_count = tile_count | plus: 1 %}
          {% assign tile_caption = tile_product.description | strip_html | truncate: 220 %}
          <button class="inspiration-wall__tile{% if tile_count > 12 %} is-hidden{% endif %}" type="button" data-inspiration-tile data-index="{{ tile_count | minus: 1 }}" data-image="{{ tile_product.featured_image | image_url: width: 1600 }}" data-username="{{ shop.name | escape }}" data-caption="{{ tile_caption | escape }}" data-date="" data-product-title="{{ tile_product.title | escape }}" data-product-image="{{ tile_product.featured_image | image_url: width: 600 }}" data-product-url="{{ tile_product.url }}" data-likes="0" data-comments="0">
            {{ tile_product.featured_image | image_url: width: 900 | image_tag: alt: tile_product.title, loading: 'lazy', widths: '240, 360, 500, 720, 900', sizes: '(max-width: 549px) 50vw, (max-width: 989px) 33vw, 17vw' }}
            <span>{{ section.settings.tile_label }}</span>
          </button>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>

  {% if tile_count > 12 %}
    <div class="inspiration-wall__more-wrap">
      <button class="inspiration-wall__more" type="button" data-inspiration-more>{{ section.settings.load_more_label }}</button>
    </div>
  {% endif %}

  <div class="inspiration-wall__modal" data-inspiration-modal role="dialog" aria-modal="true" aria-label="Instagram image details" hidden>
    <div class="inspiration-wall__modal-shell">
      <button class="inspiration-wall__close" type="button" data-inspiration-close aria-label="Close image details">×</button>
      <button class="inspiration-wall__nav inspiration-wall__nav--prev" type="button" data-inspiration-prev aria-label="Previous photo">‹</button>
      <div class="inspiration-wall__modal-image"><img src="" alt="" width="1200" height="1200" data-inspiration-modal-image></div>
      <article class="inspiration-wall__modal-content">
        <p class="inspiration-wall__source">{{ section.settings.source_label }}</p>
        <h2 data-inspiration-username></h2>
        <p class="inspiration-wall__date" data-inspiration-date></p>
        <p class="inspiration-wall__caption" data-inspiration-caption></p>
        <div class="inspiration-wall__votes"><button type="button" data-inspiration-like aria-pressed="false">♥ <span data-inspiration-likes>0</span></button><span>● <span data-inspiration-comments>0</span></span></div>
        <a class="inspiration-wall__product" href="#" data-inspiration-product hidden>
          <img src="" alt="" width="190" height="125" data-inspiration-product-image>
          <span data-inspiration-product-title></span>
        </a>
      </article>
      <button class="inspiration-wall__nav inspiration-wall__nav--next" type="button" data-inspiration-next aria-label="Next photo">›</button>
      <div class="inspiration-wall__thumbs" data-inspiration-thumbs></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "灵感图片墙",
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "Shop the Look" },
    { "type": "collection", "id": "collection", "label": "自动商品系列", "info": "未添加灵感图片区块时，自动显示这个系列的商品；留空时显示全部商品。" },
    { "type": "text", "id": "image_alt", "label": "默认图片替代文字", "default": "Interior inspiration" },
    { "type": "text", "id": "tile_label", "label": "图片悬停文字", "default": "SHOP THE LOOK" },
    { "type": "text", "id": "load_more_label", "label": "加载更多按钮文字", "default": "Load More" },
    { "type": "text", "id": "source_label", "label": "弹窗来源文字", "default": "Instagram" },
    { "type": "url", "id": "instagram_url", "label": "Instagram 链接" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "灵感图片",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "灵感图片", "info": "未选择时使用关联商品的主图。" },
        { "type": "product", "id": "product", "label": "关联商品" },
        { "type": "text", "id": "image_alt", "label": "图片替代文字" },
        { "type": "text", "id": "username", "label": "用户名或作者", "default": "My shop" },
        { "type": "textarea", "id": "caption", "label": "图片说明" },
        { "type": "text", "id": "date_label", "label": "日期文字" },
        { "type": "text", "id": "likes", "label": "点赞数", "default": "0" },
        { "type": "text", "id": "comments", "label": "评论数", "default": "0" }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [{ "name": "灵感图片墙" }]
}
{% endschema %}
