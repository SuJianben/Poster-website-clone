{{ 'source-inspiration-wall.css' | asset_url | stylesheet_tag }}
<script src="{{ 'source-inspiration-wall.js' | asset_url }}" defer="defer"></script>
<style>
  .inspiration-wall__modal[hidden]{display:none}
  .inspiration-wall__tile{height:auto!important;min-height:0!important;border-radius:0!important}
  .inspiration-wall__modal{position:fixed;inset:0;z-index:2147483000;display:grid;place-items:center;width:100vw;max-width:none;height:100vh;max-height:none;background:rgba(0,0,0,.46);overflow:hidden}
  .inspiration-wall__modal-shell{width:min(1230px,calc(100vw - 170px));height:min(850px,calc(100vh - 40px));max-width:none;max-height:none}
  @media(max-width:989px){.inspiration-wall__modal-shell{width:calc(100vw - 64px);height:min(760px,calc(100vh - 32px))}}
  @media(max-width:549px){.inspiration-wall__modal{display:block;background:#fff}.inspiration-wall__modal-shell{width:100vw;height:100dvh}}
</style>

{% liquid
  assign fallback_images = 'https://cdn.stamped.io/uploads/instagram/228253_17982961991632197_high.jpg?tr=h-500|https://cdn.stamped.io/uploads/instagram/228253_17983635983465494_high.jpg?tr=h-500|https://cdn.stamped.io/uploads/instagram/228253_18027296926740370_high.jpg?tr=h-500|https://cdn.stamped.io/uploads/instagram/228253_18409242106058899_high.jpg?tr=h-500|https://cdn.stamped.io/uploads/instagram/228253_17849629965132991_high.jpg?tr=h-500|https://cdn.stamped.io/uploads/instagram/228253_17887485995917154_high.jpg?tr=h-500|https://cdn.stamped.io/uploads/instagram/228253_17985448340402894_high.jpg?tr=h-500|https://cdn.stamped.io/uploads/instagram/228253_17985703427386591_high.jpg?tr=h-500|https://cdn.stamped.io/uploads/instagram/228253_17996421116240631_high.jpg?tr=h-500|https://cdn.stamped.io/uploads/instagram/228253_18215387413283079_high.jpg?tr=h-500|https://cdn.stamped.io/uploads/instagram/228253_17918667689842490_high.jpg?tr=h-500|https://cdn.stamped.io/uploads/instagram/228253_18077767885439204_high.jpg?tr=h-500|https://cdn.stamped.io/uploads/instagram/228253_18032030818741035_high.jpg?tr=h-500|https://cdn.stamped.io/uploads/instagram/228253_18305893477131358_high.jpg?tr=h-500|https://cdn.stamped.io/uploads/instagram/228253_17969030990652784_high.jpg?tr=h-500|https://cdn.stamped.io/uploads/instagram/228253_17982301946406867_high.jpg?tr=h-500|https://cdn.stamped.io/uploads/instagram/228253_17928248822715182_high.jpg?tr=h-500|https://cdn.stamped.io/uploads/instagram/228253_17981617157405940_high.jpg?tr=h-500'
  assign fallback_images = fallback_images | split: '|'
%}

<section class="inspiration-wall" data-inspiration-wall>
  <header class="inspiration-wall__heading">
    <h1>{{ section.settings.heading }}</h1>
    <a class="inspiration-wall__instagram" href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/dotcomcanvas/' }}" target="_blank" rel="noopener" aria-label="Follow DOTCOMCANVAS on Instagram">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.8" r="1"></circle></svg>
    </a>
  </header>

  <div class="inspiration-wall__grid" data-inspiration-grid>
    {% for image in fallback_images %}
      {% liquid
        assign username = 'dotcomcanvas'
        assign product_title = 'DOTCOMCANVAS Wall Art'
        assign product_image = image
        assign caption = 'Discover original wall art, created to bring personality and colour to your space.'
        if forloop.first
          assign product_title = 'Smells like Success'
          assign product_image = 'https://cdn.shopify.com/s/files/1/0601/1253/5810/files/LeinwandbildSmellslikeSuccessCocoChanelParfumPopArt10.jpg?tr=h-180'
          assign caption = 'SMELLS LIKE SUCCESS - New Art 🔥 Artist: STEFAN BAMERT 🎨 BUY 1 - GET 1 for FREE. Each week new art drops here — do not miss your chance to get your favourite art. Premium Acrylic Glass • Premium Canvas. Do you like this art?'
        elsif forloop.index == 9
          assign username = 'julianhelbigecom'
          assign caption = 'A special customer interior featuring DOTCOMCANVAS art.'
        endif
      %}
      <button class="inspiration-wall__tile{% if forloop.index > 12 %} is-hidden{% endif %}" type="button" data-inspiration-tile data-index="{{ forloop.index0 }}" data-image="{{ image }}" data-username="{{ username }}" data-caption="{{ caption | escape }}" data-product-title="{{ product_title }}" data-product-image="{{ product_image }}" data-likes="{{ forloop.index | times: 7 | plus: 8 }}">
        <img src="{{ image }}" alt="{{ section.settings.image_alt }} {{ forloop.index }}" loading="{% if forloop.index < 7 %}eager{% else %}lazy{% endif %}" width="500" height="500">
        <span>SHOP THE LOOK</span>
      </button>
    {% endfor %}
  </div>

  <div class="inspiration-wall__more-wrap">
    <button class="inspiration-wall__more" type="button" data-inspiration-more>{{ section.settings.load_more_label }}</button>
  </div>

  <div class="inspiration-wall__modal" data-inspiration-modal role="dialog" aria-modal="true" aria-label="Instagram image details" hidden>
    <div class="inspiration-wall__modal-shell">
      <button class="inspiration-wall__close" type="button" data-inspiration-close aria-label="Close image details">×</button>
      <button class="inspiration-wall__nav inspiration-wall__nav--prev" type="button" data-inspiration-prev aria-label="Previous photo">‹</button>
      <div class="inspiration-wall__modal-image"><img src="" alt="" data-inspiration-modal-image></div>
      <article class="inspiration-wall__modal-content">
        <p class="inspiration-wall__source">Instagram</p>
        <h2 data-inspiration-username></h2>
        <p class="inspiration-wall__date">30 months ago</p>
        <p class="inspiration-wall__caption" data-inspiration-caption></p>
        <div class="inspiration-wall__votes"><button type="button" data-inspiration-like aria-pressed="false">♥ <span data-inspiration-likes>0</span></button><span>● 0</span></div>
        <a class="inspiration-wall__product" href="/products/berit-mogensen-lopez-improvise" data-inspiration-product>
          <img src="" alt="" data-inspiration-product-image>
          <span data-inspiration-product-title></span>
        </a>
      </article>
      <button class="inspiration-wall__nav inspiration-wall__nav--next" type="button" data-inspiration-next aria-label="Next photo">›</button>
      <div class="inspiration-wall__thumbs" data-inspiration-thumbs></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "灵感图片墙",
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "Shop the Look" },
    { "type": "text", "id": "image_alt", "label": "图片替代文字前缀", "default": "DOTCOMCANVAS interior inspiration" },
    { "type": "text", "id": "load_more_label", "label": "加载更多按钮文字", "default": "Load More" },
    { "type": "url", "id": "instagram_url", "label": "Instagram 链接" }
  ],
  "presets": [{ "name": "灵感图片墙" }]
}
{% endschema %}
