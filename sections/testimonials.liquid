<section class="testimonials section"><div class="page-width"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div></div><div class="testimonials__grid">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><p class="testimonial-stars">★★★★★</p><h3>{{ block.settings.title | escape }}</h3><div>{{ block.settings.text }}</div><p class="testimonial-author">{{ block.settings.author | escape }}</p></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Testimonials","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CUSTOMER FAVORITES"},{"type":"text","id":"heading","label":"Heading","default":"Loved in real homes"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"text","id":"title","label":"Title","default":"A beautiful focal point"},{"type":"richtext","id":"text","label":"Review","default":"<p>The colors are incredible and the quality feels special from the moment it arrives.</p>"},{"type":"text","id":"author","label":"Author","default":"Verified customer"}]}],"presets":[{"name":"Testimonials","blocks":[{"type":"review"},{"type":"review","settings":{"title":"Exceeded expectations","author":"A. Customer"}},{"type":"review","settings":{"title":"The room feels complete","author":"M. Customer"}}]}]}{% endschema %}
