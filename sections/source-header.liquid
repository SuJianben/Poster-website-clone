{% if section.settings.enabled %}
<style>.cart-icon cart-count { visibility: hidden; }</style>
{{ 'source-header-logo.css' | asset_url | stylesheet_tag }}
{% render 'source-header-1' %}
{% render 'source-header-2' %}
{% render 'source-header-config', section: section %}
{{ 'source-menu-drawer.css' | asset_url | stylesheet_tag }}
{{ 'source-mobile-header-search.css' | asset_url | stylesheet_tag }}
<script src="{{ 'source-header-config.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'source-menu-drawer.js' | asset_url }}" defer="defer"></script>
<script id="SourceMobileSearchData" type="application/json">
  {
    "products": [
      {% for product in collections.all.products limit: 50 %}
        {"title": {{ product.title | json }}, "url": {{ product.url | json }}}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ],
    "collections": [
      {% for collection in collections limit: 50 %}
        {"title": {{ collection.title | json }}, "url": {{ collection.url | json }}}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
</script>
<script src="{{ 'source-mobile-header-search.js' | asset_url }}&amp;source_search=5" defer="defer"></script>
{% endif %}
{% schema %}
{
  "name": "页头",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "显示模块", "default": true },
    { "type": "image_picker", "id": "logo", "label": "Logo 图片" },
    { "type": "range", "id": "logo_width", "label": "Logo 宽度", "min": 80, "max": 500, "step": 10, "unit": "px", "default": 400 },
    { "type": "range", "id": "logo_width_mobile", "label": "移动端 Logo 宽度", "min": 60, "max": 280, "step": 10, "unit": "px", "default": 200 },
    { "type": "url", "id": "logo_link", "label": "Logo 链接" },
    { "type": "text", "id": "search_placeholder", "label": "搜索框提示文字", "default": "Wonach suchst du?" },
    { "type": "link_list", "id": "menu", "label": "主导航菜单", "info": "使用包含六个菜单项的菜单替换参考站顶部导航，布局保持不变。" }
  ],
  "presets": [{ "name": "页头" }]
}
{% endschema %}
