{% if section.settings.enabled %}
{% render 'source-footer-1' %}
<template data-source-footer-localization>
  <div class="country-switcher no-js-hidden" style="--f-max-width: 220px">
    <localization-form class="disclosure no-js-hidden disclosure--up disclosure--plain" data-disclosure-country>
      <form method="post" action="/localization" id="FooterCountry-{{ section.id }}" accept-charset="UTF-8" class="selectors-form" enctype="multipart/form-data" data-disclosure-form>
        <input type="hidden" name="form_type" value="localization">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="_method" value="put">
        <input type="hidden" name="return_to" value="{{ request.path }}">
        <h2 class="visually-hidden">Country/region</h2>
        <button type="button" class="disclosure__toggle btn--plain text-normal font-body" aria-expanded="false" aria-controls="FooterCountryList-{{ section.id }}" data-disclosure-toggle>
          <span class="f-country-flags f-country-flags--{{ localization.country.iso_code }}" style="--background-image: url(//cdn.shopify.com/static/images/flags/{{ localization.country.iso_code | downcase }}.svg?width=20)"></span>
          {{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})
          <svg class="icon icon-caret-up icon--medium icon--thick" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3.75 12.5L10 6.25L16.25 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <ul id="FooterCountryList-{{ section.id }}" class="disclosure-list v-scrollable text-left">
          {% for country in localization.available_countries %}
            <li class="disclosure-list__item{% if country.iso_code == localization.country.iso_code %} disclosure-list__item--current{% endif %}">
              <a class="disclosure-list__option" href="#"{% if country.iso_code == localization.country.iso_code %} aria-current="true"{% endif %} data-value="{{ country.iso_code }}" data-disclosure-option>
                <span class="f-country-flags f-country-flags--{{ country.iso_code }}" style="--background-image: url(//cdn.shopify.com/static/images/flags/{{ country.iso_code | downcase }}.svg?width=20)"></span>{{ country.name }}<span class="localization-form__currency">({{ country.currency.iso_code }} {{ country.currency.symbol }})</span>
              </a>
            </li>
          {% endfor %}
        </ul>
        <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}" data-disclosure-input>
      </form>
    </localization-form>
  </div>
  <div class="language-switcher no-js-hidden">
      <localization-form class="disclosure no-js-hidden disclosure--up disclosure--plain" data-disclosure-locale>
        <form method="post" action="/localization" id="FooterLanguage-{{ section.id }}" accept-charset="UTF-8" class="selectors-form" enctype="multipart/form-data" data-disclosure-form>
          <input type="hidden" name="form_type" value="localization">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="_method" value="put">
          <input type="hidden" name="return_to" value="{{ request.path }}">
          <h2 class="visually-hidden">Language</h2>
          <button type="button" class="disclosure__toggle btn--plain text-normal font-body" aria-expanded="false" aria-controls="FooterLanguageList-{{ section.id }}" data-disclosure-toggle>
            {{ localization.language.endonym_name }}
            <svg class="icon icon-caret-up icon--medium icon--thick" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3.75 12.5L10 6.25L16.25 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <ul id="FooterLanguageList-{{ section.id }}" class="disclosure-list v-scrollable text-left">
            {% for language in localization.available_languages %}
              <li class="disclosure-list__item{% if language.iso_code == localization.language.iso_code %} disclosure-list__item--current{% endif %}" tabindex="-1">
                <a class="disclosure-list__option" href="#" hreflang="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} aria-current="true"{% endif %} data-value="{{ language.iso_code }}" data-disclosure-option>{{ language.endonym_name }}</a>
              </li>
            {% endfor %}
          </ul>
          <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}" data-disclosure-input>
        </form>
      </localization-form>
  </div>
</template>
<template data-source-footer-payments>
  <span class="visually-hidden">Payment methods</span>
  <ul class="list list-payment" role="list">
    {% for payment_type in shop.enabled_payment_types %}
      <li class="list-payment__item">{{ payment_type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
    {% endfor %}
  </ul>
</template>
<script src="{{ 'source-footer-content.js' | asset_url }}" defer="defer"></script>
{% if section.settings.menu_service != blank or section.settings.menu_information != blank or section.settings.menu_collaboration != blank or section.settings.menu_general != blank or section.settings.contact_heading != blank or section.settings.contact_address != blank or section.settings.contact_email != blank or section.settings.awards_image != blank or section.settings.facebook_url != blank or section.settings.instagram_url != blank or section.settings.tiktok_url != blank %}
  <script type="application/json" data-source-footer-overrides>
    {
      "menus": {
        "service": {
          "heading": {{ section.settings.service_heading | json }},
          "links": [{% for link in section.settings.menu_service.links %}{"title": {{ link.title | json }}, "url": {{ link.url | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
        },
        "information": {
          "heading": {{ section.settings.information_heading | json }},
          "links": [{% for link in section.settings.menu_information.links %}{"title": {{ link.title | json }}, "url": {{ link.url | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
        },
        "collaboration": {
          "heading": {{ section.settings.collaboration_heading | json }},
          "links": [{% for link in section.settings.menu_collaboration.links %}{"title": {{ link.title | json }}, "url": {{ link.url | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
        },
        "general": {
          "heading": {{ section.settings.general_heading | json }},
          "links": [{% for link in section.settings.menu_general.links %}{"title": {{ link.title | json }}, "url": {{ link.url | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
        }
      },
      "contact": {
        "heading": {{ section.settings.contact_heading | json }},
        "address": {{ section.settings.contact_address | json }},
        "email": {{ section.settings.contact_email | json }}
      },
      "awardsImage": {% if section.settings.awards_image != blank %}{{ section.settings.awards_image | image_url: width: 800 | json }}{% else %}null{% endif %},
      "social": {
        "facebook": {{ section.settings.facebook_url | json }},
        "instagram": {{ section.settings.instagram_url | json }},
        "tiktok": {{ section.settings.tiktok_url | json }}
      }
    }
  </script>
{% endif %}
{% endif %}
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show section", "default": true },
    { "type": "header", "content": "Footer menus" },
    { "type": "text", "id": "service_heading", "label": "Service heading", "default": "Service" },
    { "type": "link_list", "id": "menu_service", "label": "Service menu" },
    { "type": "text", "id": "information_heading", "label": "Information heading", "default": "Mehr Infos" },
    { "type": "link_list", "id": "menu_information", "label": "Information menu" },
    { "type": "text", "id": "collaboration_heading", "label": "Collaboration heading", "default": "Zusammenarbeit" },
    { "type": "link_list", "id": "menu_collaboration", "label": "Collaboration menu" },
    { "type": "text", "id": "general_heading", "label": "General heading", "default": "Allgemein" },
    { "type": "link_list", "id": "menu_general", "label": "General menu" },
    { "type": "header", "content": "Contact information" },
    { "type": "text", "id": "contact_heading", "label": "Heading", "default": "Über Uns" },
    { "type": "textarea", "id": "contact_address", "label": "Address", "default": "Palmstraße 17, 09130 Chemnitz, Germany" },
    { "type": "text", "id": "contact_email", "label": "Email", "default": "service@dotcomcanvas.de" },
    { "type": "image_picker", "id": "awards_image", "label": "Awards image" },
    { "type": "header", "content": "Social links" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
