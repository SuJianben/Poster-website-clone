<section class="hero" {% if section.settings.image != blank %}style="--hero-image: url('{{ section.settings.image | image_url: width: 2400 }}')"{% endif %}>
  <div class="page-width hero__content"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><div class="hero__text">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div>
</section>
{% schema %}{"name":"Hero","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ART THAT STAYS WITH YOU"},{"type":"text","id":"heading","label":"Heading","default":"Make your walls impossible to ignore."},{"type":"richtext","id":"text","label":"Text","default":"<p>Curated artwork for expressive, lived-in spaces.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Shop bestsellers"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Hero"}]}{% endschema %}
