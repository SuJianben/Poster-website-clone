{% if section.settings.enabled %}
  {% render 'source-bestsellers-configurable', section: section %}
{% endif %}
{% schema %}
{
  "name": "畅销商品",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "显示模块", "default": true },
    { "type": "text", "id": "heading_prefix", "label": "标题前缀", "default": "VÅRA" },
    { "type": "text", "id": "heading_highlight", "label": "标题高亮文字", "default": "BÄSTSÄLJARE" },
    { "type": "text", "id": "collection_label", "label": "系列按钮文字", "default": "Till kollektionen" },
    { "type": "url", "id": "collection_button_link", "label": "按钮链接", "info": "填写后应用于所有系列标签；留空时使用各标签的自定义链接" }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "系列标签",
      "settings": [
        { "type": "collection", "id": "collection", "label": "系列" },
        { "type": "url", "id": "custom_link", "label": "自定义链接", "info": "留空时使用所选系列链接" },
        { "type": "text", "id": "label", "label": "标签名称" },
        { "type": "image_picker", "id": "promo_image", "label": "推广图片" },
        { "type": "text", "id": "promo_heading", "label": "推广标题" },
        { "type": "text", "id": "promo_button_label", "label": "推广按钮文字" },
        { "type": "url", "id": "promo_link", "label": "推广链接" }
      ]
    }
  ],
  "presets": [{ "name": "畅销商品" }]
}
{% endschema %}
