{% if section.settings.enabled %}
  {% if section.blocks.size > 0 %}
    {% render 'source-bestsellers-configurable', section: section %}
  {% else %}
    {% render 'source-bestsellers-1' %}
    {% render 'source-bestsellers-2' %}
    {% render 'source-bestsellers-3' %}
  {% endif %}
{% endif %}
{% schema %}
{
  "name": "Best sellers",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show section", "default": true },
    { "type": "text", "id": "heading_prefix", "label": "Heading prefix", "default": "UNSERE" },
    { "type": "text", "id": "heading_highlight", "label": "Heading highlight", "default": "BESTSELLER" },
    { "type": "text", "id": "collection_label", "label": "Collection button label", "default": "Zur Kollektion" }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "Collection tab",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Tab label" },
        { "type": "image_picker", "id": "promo_image", "label": "Promotion image" },
        { "type": "text", "id": "promo_heading", "label": "Promotion heading" },
        { "type": "text", "id": "promo_button_label", "label": "Promotion button label" },
        { "type": "url", "id": "promo_link", "label": "Promotion link" }
      ]
    }
  ],
  "presets": [{ "name": "Best sellers" }]
}
{% endschema %}
