{% comment %}Mobile predictive search results rendered from this store.{% endcomment %}
{% if predictive_search.performed %}
  <div data-source-predictive-results>
    {% if predictive_search.resources.queries.size > 0 %}
      <section class="source-predictive-group">
        <h3 class="source-predictive-group__title">Vorschläge</h3>
        <div class="source-predictive-group__list" role="group">
          {% for query in predictive_search.resources.queries %}
            <a class="source-predictive-result" href="{{ query.url }}" role="option">
              <svg class="source-predictive-result__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="7" cy="7" r="4.75" stroke="currentColor" stroke-width="1.5"></circle>
                <path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
              <span class="source-predictive-query-mark">{{ query.styled_text }}</span>
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if predictive_search.resources.collections.size > 0 %}
      <section class="source-predictive-group">
        <h3 class="source-predictive-group__title">Sammlungen</h3>
        <div class="source-predictive-group__list" role="group">
          {% for collection in predictive_search.resources.collections %}
            <a class="source-predictive-result" href="{{ collection.url }}" role="option">
              {{ collection.title | escape }}
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% assign page_result_count = predictive_search.resources.articles.size | plus: predictive_search.resources.pages.size %}
    {% if page_result_count > 0 %}
      <section class="source-predictive-group">
        <h3 class="source-predictive-group__title">Artikel und Seiten</h3>
        <div class="source-predictive-group__list" role="group">
          {% for article in predictive_search.resources.articles %}
            <a class="source-predictive-result" href="{{ article.url }}" role="option">
              {{ article.title | escape }}
            </a>
          {% endfor %}
          {% for page in predictive_search.resources.pages %}
            <a class="source-predictive-result" href="{{ page.url }}" role="option">
              {{ page.title | escape }}
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if predictive_search.resources.products.size > 0 %}
      <section class="source-predictive-group">
        <h3 class="source-predictive-group__title">Produkte</h3>
        <div class="source-predictive-group__list" role="group">
          {% for product in predictive_search.resources.products %}
            <a class="source-predictive-result" href="{{ product.url }}" role="option">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 76 | image_tag: class: 'source-predictive-result__image', loading: 'lazy', alt: '' }}
              {% endif %}
              <span>{{ product.title | escape }}</span>
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}
  </div>
{% endif %}
