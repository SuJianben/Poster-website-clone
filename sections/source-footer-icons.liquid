{% if section.settings.enabled %}
  {{ 'source-footer-icons-base.css' | asset_url | stylesheet_tag }}
  {% render 'source-footer-icons-1' %}
  <script src="{{ 'source-footer-icons-content.js' | asset_url }}" defer="defer"></script>
  {% if section.settings.heading_prefix != blank or section.settings.heading_highlight != blank or section.blocks.size > 0 %}
    <script type="application/json" data-source-footer-icons-overrides>
      {
        "headingPrefix": {{ section.settings.heading_prefix | json }},
        "headingHighlight": {{ section.settings.heading_highlight | json }},
        "items": [
          {% for block in section.blocks %}
            {
              "index": {{ forloop.index0 }},
              "blockId": {{ block.id | json }},
              "shopifyAttributes": {{ block.shopify_attributes | json }},
              "icon": {{ block.settings.icon | json }},
              "title": {{ block.settings.title | json }},
              "text": {{ block.settings.text | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }
    </script>
  {% endif %}
{% endif %}
{% schema %}
{
  "name": "页脚保障图标",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "显示模块", "default": true },
    { "type": "text", "id": "heading_prefix", "label": "标题前缀（覆盖默认）" },
    { "type": "text", "id": "heading_highlight", "label": "标题高亮文字（覆盖默认）" }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "保障项目",
      "settings": [
        { "type": "paragraph", "content": "区块会按顺序对应参考站的五项保障内容。字段留空即可保留原内容。" },
        { "type": "select", "id": "icon", "label": "图标", "default": "", "options": [
          { "value": "", "label": "保留参考站图标" },
          { "value": "heart", "label": "爱心" },
          { "value": "package", "label": "包裹" },
          { "value": "truck", "label": "物流" },
          { "value": "currency-circle-dollar", "label": "安全支付" },
          { "value": "smiley", "label": "客户服务" }
        ] },
        { "type": "text", "id": "title", "label": "标题（覆盖默认）" },
        { "type": "textarea", "id": "text", "label": "说明（覆盖默认）" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "页脚保障图标" }]
}
{% endschema %}
