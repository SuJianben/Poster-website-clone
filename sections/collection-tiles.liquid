<section class="collection-tiles section"><div class="page-width"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div></div><div class="collection-tiles__grid">{% for block in section.blocks %}<a href="{{ block.settings.link }}" class="collection-tile" {{ block.shopify_attributes }}><img src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.title | escape }}" width="1080" height="1080" loading="lazy"><span>{{ block.settings.title | escape }}</span></a>{% endfor %}</div></div></section>
{% schema %}{"name":"Collection tiles","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"EXPLORE THE COLLECTION"},{"type":"text","id":"heading","label":"Heading","default":"More ways to find your art"}],"blocks":[{"type":"tile","name":"Tile","settings":[{"type":"select","id":"asset","label":"Snapshot image","options":[{"value":"reference-collection-motivation.jpg","label":"Motivation"},{"value":"reference-collection-cars.jpg","label":"Cars"},{"value":"reference-collection-abstract.jpg","label":"Abstract"},{"value":"reference-collection-crypto.jpg","label":"Crypto"},{"value":"reference-collection-pop.jpg","label":"Pop art"},{"value":"reference-material-canvas.jpg","label":"Canvas"}]},{"type":"text","id":"title","label":"Title","default":"Collection"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Collection tiles","blocks":[{"type":"tile","settings":{"asset":"reference-collection-motivation.jpg","title":"Motivation"}},{"type":"tile","settings":{"asset":"reference-collection-cars.jpg","title":"Cars"}},{"type":"tile","settings":{"asset":"reference-collection-abstract.jpg","title":"Abstract"}},{"type":"tile","settings":{"asset":"reference-collection-crypto.jpg","title":"Crypto"}},{"type":"tile","settings":{"asset":"reference-collection-pop.jpg","title":"Pop art"}},{"type":"tile","settings":{"asset":"reference-material-canvas.jpg","title":"Canvas"}}]}]}{% endschema %}
