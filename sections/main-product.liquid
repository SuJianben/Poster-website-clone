<section class="product-page section" data-product-section><div class="page-width product-page__grid"><div class="product-gallery">{% for image in product.images %}{{ image | image_url: width: 1200 | image_tag: widths: '500,800,1200', loading: 'lazy', alt: product.title }}{% endfor %}</div><div class="product-page__info"><p class="eyebrow">{{ product.vendor | escape }}</p><h1>{{ product.title | escape }}</h1><p class="product-price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</p><div class="product-description">{{ product.description }}</div>{% form 'product', product, class: 'product-form' %}{% if product.has_only_default_variant == false %}<label for="VariantSelect">Style</label><select id="VariantSelect" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" data-variant='{{ variant | json | escape }}' {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title | escape }} - {{ variant.price | money }}</option>{% endfor %}</select>{% endif %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><label for="Quantity">{{ 'product.quantity' | t }}</label><input id="Quantity" type="number" name="quantity" value="1" min="1"><button class="button" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}{{ 'product.add_to_cart' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</button><p class="form-error" data-product-form-error role="alert"></p>{% endform %}<div class="product-assurances"><p>Free shipping on orders over $49</p><p>30-day at-home trial</p><p>Secure Shopify checkout</p></div></div></div></section>
{% schema %}{"name":"Main product","settings":[]}{% endschema %}
