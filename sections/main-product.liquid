<section class="product-page section"><div class="page-width product-page__grid"><div>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | image_tag: widths: '500,800,1200', alt: product.title }}{% endif %}</div><div><p class="eyebrow">{{ product.vendor | escape }}</p><h1>{{ product.title | escape }}</h1><p class="product-price">{{ product.selected_or_first_available_variant.price | money }}</p><div>{{ product.description }}</div>{% form 'product', product %}<label for="Quantity">{{ 'product.quantity' | t }}</label><input id="Quantity" type="number" name="quantity" value="1" min="1"><button class="button" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}{{ 'product.add_to_cart' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</button>{% endform %}</div></div></section>
{% schema %}{"name":"Main product","settings":[]}{% endschema %}
