<iframe
  id="source-homepage-frame"
  src="{{ 'source-homepage.html' | asset_url }}"
  title="Dotcom Canvas"
  scrolling="no"
  style="display:block;width:100%;height:100vh;border:0"
></iframe>

<script>
  (function () {
    var frame = document.getElementById('source-homepage-frame');

    window.addEventListener('message', function (event) {
      if (!event.data || event.data.type !== 'source-homepage-height') return;
      frame.style.height = event.data.height + 'px';
    });
  })();
</script>

{% schema %}
{
  "name": "Source homepage",
  "settings": []
}
{% endschema %}
