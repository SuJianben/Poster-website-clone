    },
    {
      "type": "text",
      "id": "fair_logo_alt",
      "label": "品牌图标替代文本"
    },
    {
      "type": "text",
      "id": "fair_heading",
      "label": "公平定价主标题",
      "default": "Fair Pricing"
    },
    {
      "type": "richtext",
      "id": "fair_content",
      "label": "公平定价正文"
    },
    {
      "type": "header",
      "content": "艺术家信息"
    },
    {
      "type": "image_picker",
      "id": "artist_image",
      "label": "艺术家图片"
    },
    {
      "type": "text",
      "id": "artist_image_alt",
      "label": "艺术家图片替代文本"
    },
    {
      "type": "text",
      "id": "artist_heading",
      "label": "艺术家名称"
    },
    {
      "type": "richtext",
      "id": "artist_content",
      "label": "艺术家介绍正文"
    },
    {
      "type": "header",
      "content": "材质与工艺"
    },
    {
      "type": "image_picker",
      "id": "materials_main_image",
      "label": "材质主图"
    },
    {
