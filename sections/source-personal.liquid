{% if section.settings.enabled %}
  {% if section.blocks.size > 0 %}
    {% render 'source-personal-configurable', section: section %}
  {% else %}
    {% render 'source-personal-1' %}
    {% render 'source-personal-2' %}
  {% endif %}
{% endif %}
{% schema %}
{
  "name": "个性化作品",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "显示模块", "default": true },
    { "type": "text", "id": "eyebrow", "label": "标题上方文字", "default": "Mit jedem Bild erzählst du deine ganz eigene Geschichte." },
    { "type": "text", "id": "heading_prefix", "label": "标题前缀", "default": "DEIN PERSÖNLICHES" },
    { "type": "text", "id": "heading_highlight", "label": "标题高亮文字", "default": "MEISTERWERK" },
    { "type": "text", "id": "link_label", "label": "标题链接文字", "default": "Zu Allen Personalisierbaren Motiven" },
    { "type": "url", "id": "link", "label": "标题链接" },
    { "type": "text", "id": "collection_label", "label": "系列按钮文字", "default": "Zur Kollektion" }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "系列标签",
      "settings": [
        { "type": "collection", "id": "collection", "label": "系列" },
        { "type": "text", "id": "label", "label": "标签名称" },
        { "type": "image_picker", "id": "promo_image", "label": "推广图片" },
        { "type": "text", "id": "promo_heading", "label": "推广标题" },
        { "type": "text", "id": "promo_button_label", "label": "推广按钮文字" },
        { "type": "url", "id": "promo_link", "label": "推广链接" }
      ]
    }
  ],
  "presets": [{ "name": "个性化作品" }]
}
{% endschema %}
