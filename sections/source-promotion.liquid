{% if section.settings.enabled %}
{% render 'source-promotion-1', section: section %}
{% endif %}
{% schema %}
{
  "name": "Promotion",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show section", "default": true }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text item",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "select", "id": "text_style", "label": "Text style", "options": [{ "value": "h4", "label": "Small" }, { "value": "h2", "label": "Large" }], "default": "h2" }
      ]
    },
    {
      "type": "image",
      "name": "Image item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Image link" },
        { "type": "range", "id": "image_height", "label": "Image height", "min": 40, "max": 120, "step": 5, "unit": "px", "default": 80 },
        { "type": "range", "id": "mobile_image_height", "label": "Mobile image height", "min": 30, "max": 80, "step": 5, "unit": "px", "default": 50 }
      ]
    }
  ],
  "presets": [{ "name": "Promotion" }]
}
{% endschema %}
