{% if section.settings.enabled %}
{% render 'source-promotion-1', section: section %}
{% endif %}
{% schema %}
{
  "name": "推广横幅",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "显示模块", "default": true }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "文字项",
      "settings": [
        { "type": "textarea", "id": "text", "label": "文字" },
        { "type": "select", "id": "text_style", "label": "文字样式", "options": [{ "value": "h4", "label": "小号" }, { "value": "h2", "label": "大号" }], "default": "h2" }
      ]
    },
    {
      "type": "image",
      "name": "图片项",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片" },
        { "type": "url", "id": "link", "label": "图片链接" },
        { "type": "range", "id": "image_height", "label": "图片高度", "min": 40, "max": 120, "step": 5, "unit": "px", "default": 80 },
        { "type": "range", "id": "mobile_image_height", "label": "移动端图片高度", "min": 30, "max": 80, "step": 5, "unit": "px", "default": 50 }
      ]
    }
  ],
  "presets": [{ "name": "推广横幅" }]
}
{% endschema %}
