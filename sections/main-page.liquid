<div class="section section--padding dw-page">
  <div class="page-width" style="max-width: 820px; margin: 0 auto; padding: 48px 20px 64px;">
    <h1 class="dw-page__title">{{ page.title }}</h1>
    <div class="dw-page__content">{{ page.content }}</div>
    {% if page.handle == 'contact' %}
      {% form 'contact', class: 'dw-contact-form' %}
        {% if form.posted_successfully? %}
          <p class="dw-form__success" style="padding:12px 16px;border:1px solid #2e7d32;border-radius:8px;margin:24px 0;">Tack för ditt meddelande! Vi återkommer så snart vi kan.</p>
        {% endif %}
        {% if form.errors %}
          <p class="dw-form__error" style="padding:12px 16px;border:1px solid #c62828;border-radius:8px;margin:24px 0;">{{ form.errors | default_errors }}</p>
        {% endif %}
        <div style="display:grid;gap:14px;margin-top:32px;">
          <label>Namn<br><input type="text" name="contact[name]" required></label>
          <label>E-post<br><input type="email" name="contact[email]" required></label>
          <label>Ordernummer (om det gäller en beställning)<br><input type="text" name="contact[order]"></label>
          <label>Meddelande<br><textarea name="contact[body]" rows="6" required></textarea></label>
          <button type="submit">Skicka meddelande</button>
        </div>
      {% endform %}
    {% endif %}
  </div>
</div>
<style>
  body .dw-page .dw-page__title { font-size: 38px !important; line-height: 1.2 !important; font-weight: 700 !important; margin: 0 0 28px !important; letter-spacing: -0.01em; }
  body .dw-page .dw-page__content h2 { font-size: 23px !important; line-height: 1.3 !important; font-weight: 700 !important; margin: 32px 0 12px !important; }
  body .dw-page .dw-page__content h3 { font-size: 18px !important; line-height: 1.35 !important; font-weight: 700 !important; margin: 26px 0 8px !important; }
  body .dw-page .dw-page__content p,
  body .dw-page .dw-page__content li { font-size: 16px !important; line-height: 1.7 !important; font-weight: 400 !important; margin: 0 0 12px !important; }
  body .dw-page .dw-page__content strong { font-weight: 700 !important; }
  body .dw-page .dw-page__content ul { padding-left: 1.25em !important; margin: 0 0 16px !important; list-style: disc !important; }
  body .dw-page .dw-page__content a { text-decoration: underline; }
  body .dw-page label { font-size: 15px !important; font-weight: 600 !important; }
  body .dw-page input, body .dw-page textarea { width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 8px; font-size: 16px !important; }
  body .dw-page button { padding: 14px 24px; background: #111; color: #fff; border: 0; border-radius: 8px; font-weight: 600; font-size: 16px !important; cursor: pointer; }
</style>
{% schema %}
{ "name": "Page content", "settings": [] }
{% endschema %}