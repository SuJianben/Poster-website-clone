{% if section.settings.enabled %}
  {% render 'source-collection-list-secondary-1' %}
  <script src="{{ 'source-secondary-collection-content.js' | asset_url }}" defer="defer"></script>
  {% if section.settings.heading != blank or section.blocks.size > 0 %}
    <script type="application/json" data-source-secondary-collection-overrides>
      {
        "heading": {{ section.settings.heading | json }},
        "cards": [
          {% for block in section.blocks %}
            {% assign collection = block.settings.collection %}
            {
              "index": {{ forloop.index0 }},
              "title": {{ block.settings.title | json }},
              "collection": {% if collection != blank %}{
                "url": {{ collection.url | json }},
                "title": {{ collection.title | json }},
                "image": {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1080 | json }}{% elsif collection.featured_image != blank %}{{ collection.featured_image | image_url: width: 1080 | json }}{% else %}null{% endif %}
              }{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }
    </script>
  {% endif %}
{% endif %}
{% schema %}
{
  "name": "Secondary collection list",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show section", "default": true },
    { "type": "text", "id": "heading", "label": "Heading override" }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        { "type": "paragraph", "content": "Blocks are mapped to the five source cards in order. Leave a field empty to retain the source content." },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image" },
        { "type": "text", "id": "title", "label": "Title override" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Secondary collection list" }]
}
{% endschema %}
