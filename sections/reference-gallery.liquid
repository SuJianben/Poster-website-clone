<section class="reference-gallery section"><div class="page-width"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div></div><div class="reference-gallery__rail">{% for block in section.blocks %}<figure {{ block.shopify_attributes }}><img src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.alt | escape }}" width="1080" height="1350" loading="lazy"><figcaption>{{ block.settings.caption | escape }}</figcaption></figure>{% endfor %}</div></div></section>
{% schema %}{"name":"Reference gallery","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"AS SEEN IN REAL SPACES"},{"type":"text","id":"heading","label":"Heading","default":"Over 60,000 happy customers"}],"blocks":[{"type":"image","name":"Image","settings":[{"type":"select","id":"asset","label":"Snapshot image","options":[{"value":"reference-ugc-mo.jpg","label":"Mo"},{"value":"reference-ugc-geissens.jpg","label":"Geissens"},{"value":"reference-ugc-knossi.webp","label":"Knossi"}]},{"type":"text","id":"alt","label":"Alt text","default":"Customer artwork"},{"type":"text","id":"caption","label":"Caption","default":"Inspiration"}]}],"presets":[{"name":"Reference gallery","blocks":[{"type":"image","settings":{"asset":"reference-ugc-mo.jpg","caption":"Mo Vlogs"}},{"type":"image","settings":{"asset":"reference-ugc-geissens.jpg","caption":"Die Geissens"}},{"type":"image","settings":{"asset":"reference-ugc-knossi.webp","caption":"Knossi"}}]}]}{% endschema %}
