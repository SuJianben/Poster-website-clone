{% if section.settings.enabled %}
  {% render 'source-favorite-products-1' %}
  {% if section.settings.heading != blank or section.blocks.size > 0 %}
    <script type="application/json" data-source-favorite-overrides>
      {
        "heading": {{ section.settings.heading | json }},
        "slides": [
          {% for block in section.blocks %}
            {% assign product = block.settings.product %}
            {
              "index": {{ forloop.index0 }},
              "title": {{ block.settings.title | json }},
              "body": {{ block.settings.body | json }},
              "name": {{ block.settings.customer_name | json }},
              "location": {{ block.settings.customer_location | json }},
              "sceneImage": {% if block.settings.scene_image != blank %}{{ block.settings.scene_image | image_url: width: 2000 | json }}{% else %}null{% endif %},
              "product": {% if product != blank %}{
                "url": {{ product.url | json }},
                "title": {{ product.title | json }},
                "material": {{ product.type | default: 'Leinwand' | json }},
                "price": {{ product.price_min | money | json }},
                "priceVaries": {{ product.price_varies | json }},
                "primaryImage": {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 1080 | json }}{% else %}null{% endif %},
                "secondaryImage": {% if product.media[1].preview_image != blank %}{{ product.media[1].preview_image | image_url: width: 900 | json }}{% else %}null{% endif %}
              }{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }
    </script>
  {% endif %}
{% endif %}
{% schema %}
{
  "name": "Favorite products",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show section", "default": true },
    { "type": "text", "id": "heading", "label": "Heading override" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Source slide override",
      "settings": [
        { "type": "paragraph", "content": "Blocks override source slides from 1 to 7 in their current order. Leave a field blank to retain the original source content." },
        { "type": "text", "id": "title", "label": "Review title" },
        { "type": "textarea", "id": "body", "label": "Review text" },
        { "type": "text", "id": "customer_name", "label": "Customer name" },
        { "type": "text", "id": "customer_location", "label": "Customer location" },
        { "type": "product", "id": "product", "label": "Related product" },
        { "type": "image_picker", "id": "scene_image", "label": "Customer scene image" }
      ]
    }
  ],
  "max_blocks": 7,
  "presets": [{ "name": "Favorite products" }]
}
{% endschema %}
