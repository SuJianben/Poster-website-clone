{% if section.settings.enabled %}
  {{ 'source-favorite-products-base.css' | asset_url | stylesheet_tag }}
  {% render 'source-favorite-products-1' %}
  {% if section.settings.heading != blank or section.blocks.size > 0 %}
    <script type="application/json" data-source-favorite-overrides>
      {
        "heading": {{ section.settings.heading | json }},
        "slides": [
          {% for block in section.blocks %}
            {% assign product = block.settings.product %}
            {
              "index": {{ forloop.index0 }},
              "blockId": {{ block.id | json }},
              "shopifyAttributes": {{ block.shopify_attributes | json }},
              "title": {{ block.settings.title | json }},
              "body": {{ block.settings.body | json }},
              "name": {{ block.settings.customer_name | json }},
              "location": {{ block.settings.customer_location | json }},
              "sceneImage": {% if block.settings.scene_image != blank %}{{ block.settings.scene_image | image_url: width: 2000 | json }}{% else %}null{% endif %},
              "product": {% if product != blank %}{
                "url": {{ product.url | json }},
                "title": {{ product.title | json }},
                "material": {{ product.type | default: 'Canvas' | json }},
                "price": {{ product.price_min | money | json }},
                "priceVaries": {{ product.price_varies | json }},
                "primaryImage": {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 1080 | json }}{% else %}null{% endif %},
                "secondaryImage": {% if product.media[1].preview_image != blank %}{{ product.media[1].preview_image | image_url: width: 900 | json }}{% else %}null{% endif %}
              }{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }
    </script>
  {% endif %}
{% endif %}
{% schema %}
{
  "name": "客户喜爱商品",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "显示模块", "default": true },
    { "type": "text", "id": "heading", "label": "自定义标题" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "轮播内容",
      "settings": [
        { "type": "paragraph", "content": "区块按当前顺序覆盖原始轮播的第 1 至 7 项；字段留空则保留原始内容。" },
        { "type": "text", "id": "title", "label": "评价标题" },
        { "type": "textarea", "id": "body", "label": "评价内容" },
        { "type": "text", "id": "customer_name", "label": "客户姓名" },
        { "type": "text", "id": "customer_location", "label": "客户所在地" },
        { "type": "product", "id": "product", "label": "关联商品" },
        { "type": "image_picker", "id": "scene_image", "label": "客户场景图" }
      ]
    }
  ],
  "max_blocks": 7,
  "presets": [{ "name": "客户喜爱商品" }]
}
{% endschema %}
