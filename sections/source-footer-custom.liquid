{% if section.settings.enabled %}
  {% render 'source-footer-custom-1', section: section %}
{% endif %}

{% schema %}
{
  "name": "页脚自定义内容",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "显示模块", "default": true },
    { "type": "image_picker", "id": "logo_image", "label": "Logo 图片" },
    { "type": "range", "id": "logo_width", "label": "桌面端 Logo 宽度", "min": 40, "max": 100, "step": 1, "unit": "%", "default": 95 },
    { "type": "range", "id": "logo_width_mobile", "label": "移动端 Logo 宽度", "min": 40, "max": 100, "step": 1, "unit": "%", "default": 90 },
    { "type": "text", "id": "logo_alt", "label": "Logo 替代文本" },
    { "type": "url", "id": "logo_link", "label": "Logo 链接" }
  ],
  "presets": [{ "name": "页脚自定义内容" }]
}
{% endschema %}
