        { "type": "text", "id": "option_2", "label": "Option 2", "default": "Canvas" },
        { "type": "text", "id": "option_3", "label": "Option 3", "default": "Acrylic Glass" }
      ]
    },
    {
      "type": "size_picker",
      "name": "Size picker",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Sizes" },
        { "type": "text", "id": "guide_label", "label": "Guide button", "default": "SIZE GUIDE" },
        { "type": "text", "id": "popular_label", "label": "Popular badge", "default": "MOST POPULAR" },
        { "type": "text", "id": "size_1_cm", "label": "Size 1 CM", "default": "A4 (30 X 21 CM)" },
        { "type": "text", "id": "size_1_in", "label": "Size 1 IN", "default": "12\" × 8\"" },
        { "type": "text", "id": "size_2_cm", "label": "Size 2 CM", "default": "40 X 30 CM" },
        { "type": "text", "id": "size_2_in", "label": "Size 2 IN", "default": "16\" × 12\"" },
        { "type": "text", "id": "size_3_cm", "label": "Size 3 CM", "default": "76 X 51 CM" },
        { "type": "text", "id": "size_3_in", "label": "Size 3 IN", "default": "30\" × 20\"" },
        { "type": "text", "id": "size_4_cm", "label": "Size 4 CM", "default": "102 X 76 CM" },
        { "type": "text", "id": "size_4_in", "label": "Size 4 IN", "default": "40\" × 30\"" },
        { "type": "text", "id": "size_5_cm", "label": "Size 5 CM", "default": "119 X 81 CM" },
        { "type": "text", "id": "size_5_in", "label": "Size 5 IN", "default": "47\" × 32\"" }
      ]
    },
    {
      "type": "buy_button",
      "name": "Buy button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Button label", "default": "Add To Cart" }
      ]
    },
    {
      "type": "volume_discount",
      "name": "Volume discount",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "🌞 SUMMER-SALE: Get more, save more! 🎉" },
        { "type": "text", "id": "note", "label": "Supporting text", "default": "Can be combined with already discounted items!" }
      ]
    },
    {
      "type": "benefits",
      "name": "Benefits",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "benefit_1", "label": "Benefit 1", "default": "Immediately Ready to hang" },
        { "type": "text", "id": "benefit_2", "label": "Benefit 2", "default": "Free worldwide shipping over €49" },
        { "type": "text", "id": "benefit_3", "label": "Benefit 3", "default": "Estimated delivery: August 15 - August 17" }
      ]
    },
    {
      "type": "payment_trust",
      "name": "Payment trust",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "SECURELY PACKAGED & PAID" },
        { "type": "text", "id": "note", "label": "Supporting text", "default": "Special packaging for art galleries" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Save Water viewport",
      "blocks": [
        { "type": "top_badge" },
        { "type": "brand_banner" },
        { "type": "reviews" },
        { "type": "title" },
        { "type": "artist" },
        { "type": "price" },
        { "type": "material_picker" },
        { "type": "size_picker" },
        { "type": "buy_button" },
        { "type": "volume_discount" },
        { "type": "benefits" },
        { "type": "payment_trust" }
      ]
    }
  ]
