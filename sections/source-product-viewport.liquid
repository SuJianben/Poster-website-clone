{% comment %} Source product viewport render revision: 2026-08-11 native-variant-unit-toggle {% endcomment %}
{{ 'source-product-static.css' | asset_url | stylesheet_tag }}
<script src="{{ 'source-product-static.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'source-product-unit-toggle.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'source-product-add-to-cart.js' | asset_url }}" defer="defer"></script>
{% render 'source-product-save-water-core', section: section, product: product %}

{% schema %}
{
  "name": "Save Water viewport",
  "settings": [],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "top_badge",
      "name": "Top badge",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Trending" }
      ]
    },
    {
      "type": "brand_banner",
      "name": "Brand banner",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Supporting text", "default": "und 60.000+ Kunden lieben unsere Premium Wandbilder." }
      ]
    },
    {
      "type": "reviews",
      "name": "Reviews",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "count", "label": "Review count", "default": "2,860" },
        { "type": "text", "id": "label", "label": "Label", "default": "Verified Reviews" }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "use_product_title", "label": "Use product title", "default": false },
        { "type": "text", "id": "heading", "label": "Fallback title", "default": "Save Water - Poster" }
      ]
    },
    {
      "type": "artist",
      "name": "Artist",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Artist:" },
        { "type": "checkbox", "id": "use_product_vendor", "label": "Use product vendor", "default": false },
        { "type": "text", "id": "name", "label": "Fallback artist", "default": "Sabrina Seck" },
        { "type": "url", "id": "url", "label": "Artist link" },
        { "type": "checkbox", "id": "show_atelier_badge", "label": "Show Atelier badge", "default": true },
        { "type": "text", "id": "atelier_text", "label": "Atelier badge text", "default": "ATELIER EXCLUSIVE" }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "use_product_price", "label": "Use product price", "default": false },
        { "type": "text", "id": "price_text", "label": "Fallback price", "default": "$29.00" },
        { "type": "text", "id": "shipping_text", "label": "Shipping text", "default": "Free Shipping." }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "label": "Picker type",
          "options": [
            { "value": "button", "label": "Buttons" },
            { "value": "dropdown", "label": "Dropdown" }
          ],
          "default": "button"
        },
        { "type": "checkbox", "id": "show_size_guide", "label": "Show size guide for size options", "default": true },
        { "type": "text", "id": "size_guide_label", "label": "Size guide label", "default": "SIZE GUIDE" }
      ]
    },
    {
      "type": "buy_button",
      "name": "Buy button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Button label", "default": "Add To Cart" }
      ]
    },
    {
      "type": "volume_discount",
      "name": "Volume discount",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "🌞 SUMMER-SALE: Get more, save more! 🎉" },
        { "type": "text", "id": "note", "label": "Supporting text", "default": "Can be combined with already discounted items!" }
      ]
    },
    {
      "type": "benefits",
      "name": "Benefits",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "benefit_1", "label": "Benefit 1", "default": "Immediately Ready to hang" },
        { "type": "text", "id": "benefit_2", "label": "Benefit 2", "default": "Free worldwide shipping over €49" },
        { "type": "text", "id": "benefit_3", "label": "Benefit 3", "default": "Estimated delivery: August 15 - August 17" }
      ]
    },
    {
      "type": "payment_trust",
      "name": "Payment trust",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "SECURELY PACKAGED & PAID" },
        { "type": "text", "id": "note", "label": "Supporting text", "default": "Special packaging for art galleries" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Save Water viewport",
      "blocks": [
        { "type": "top_badge" },
        { "type": "brand_banner" },
        { "type": "reviews" },
        { "type": "title" },
        { "type": "artist" },
        { "type": "price" },
        { "type": "variant_picker" },
        { "type": "buy_button" },
        { "type": "volume_discount" },
        { "type": "benefits" },
        { "type": "payment_trust" }
      ]
    }
  ]
}
{% endschema %}
