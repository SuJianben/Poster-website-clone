{% comment %} Source product viewport render revision: 2026-08-10 accordion-motion {% endcomment %}
{{ 'source-product-static.css' | asset_url | stylesheet_tag }}
<script src="{{ 'source-product-static.js' | asset_url }}" defer="defer"></script>
{% render 'source-product-save-water-core', section: section, product: product %}

{% schema %}
{
  "name": "Save Water viewport",
  "settings": [],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "top_badge",
      "name": "Top badge",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Trending" }
      ]
    },
    {
      "type": "brand_banner",
      "name": "Brand banner",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Supporting text", "default": "and 60,000+ customers love our premium wall art." }
      ]
    },
    {
      "type": "reviews",
      "name": "Reviews",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "count", "label": "Review count", "default": "2,860" },
        { "type": "text", "id": "label", "label": "Label", "default": "Verified Reviews" }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "use_product_title", "label": "Use product title", "default": false },
        { "type": "text", "id": "heading", "label": "Fallback title", "default": "Save Water - Poster" }
      ]
    },
    {
      "type": "artist",
      "name": "Artist",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Artist:" },
        { "type": "checkbox", "id": "use_product_vendor", "label": "Use product vendor", "default": false },
        { "type": "text", "id": "name", "label": "Fallback artist", "default": "Sabrina Seck" },
        { "type": "url", "id": "url", "label": "Artist link" },
        { "type": "checkbox", "id": "show_atelier_badge", "label": "Show Atelier badge", "default": true },
        { "type": "text", "id": "atelier_text", "label": "Atelier badge text", "default": "ATELIER EXCLUSIVE" }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "use_product_price", "label": "Use product price", "default": false },
        { "type": "text", "id": "price_text", "label": "Fallback price", "default": "$29.00" },
        { "type": "text", "id": "shipping_text", "label": "Shipping text", "default": "Free Shipping." }
      ]
    },
    {
      "type": "material_picker",
      "name": "Material picker",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Material" },
