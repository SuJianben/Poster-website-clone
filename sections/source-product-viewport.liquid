{% comment %} Source product viewport render revision: 2026-08-11 native-variant-unit-toggle {% endcomment %}
{{ 'source-product-static.css' | asset_url | stylesheet_tag }}
<script src="{{ 'source-product-static.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'source-product-unit-toggle.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'source-product-add-to-cart.js' | asset_url }}" defer="defer"></script>
{% render 'source-product-save-water-core', section: section, product: product %}

{% schema %}
{
  "name": "商品主信息",
  "settings": [
    { "type": "header", "content": "商品详情配置" },
    { "type": "text", "id": "product_details_heading", "label": "商品详情标题", "default": "Product Details" },
    { "type": "richtext", "id": "product_details_content", "label": "商品详情自定义内容", "info": "留空时显示当前商品的描述（description）。也可通过动态来源连接产品元字段。" },
    { "type": "header", "content": "配送与退换货配置" },
    { "type": "text", "id": "shipping_returns_heading", "label": "配送与退换货标题", "default": "Shipping and Returns" },
    { "type": "richtext", "id": "shipping_returns_content", "label": "配送与退换货自定义内容", "info": "留空时使用当前配送与退换货说明。也可通过动态来源连接产品元字段。" }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "top_badge",
      "name": "顶部标签",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "文案", "default": "Trending" }
      ]
    },
    {
      "type": "brand_banner",
      "name": "品牌提示栏",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "辅助说明", "default": "und 60.000+ Kunden lieben unsere Premium Wandbilder." }
      ]
    },
    {
      "type": "reviews",
      "name": "商品评价",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "count", "label": "评价数量", "default": "2,861" },
        { "type": "text", "id": "label", "label": "标签文字", "default": "Verifizierte Bewertungen" }
      ]
    },
    {
      "type": "title",
      "name": "商品标题",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "use_product_title", "label": "使用商品标题", "default": false },
        { "type": "text", "id": "heading", "label": "备用标题", "default": "Save Water - Poster" }
      ]
    },
    {
      "type": "artist",
      "name": "艺术家信息",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "标签文字", "default": "Künstler:" },
        { "type": "checkbox", "id": "use_product_vendor", "label": "使用商品供应商", "default": false },
        { "type": "text", "id": "name", "label": "备用艺术家", "default": "Sabrina Seck" },
        { "type": "url", "id": "url", "label": "艺术家链接" },
        { "type": "checkbox", "id": "show_atelier_badge", "label": "显示工作室专属标签", "default": true },
        { "type": "text", "id": "atelier_text", "label": "工作室专属标签文字", "default": "ATELIER EXCLUSIVE" }
      ]
    },
    {
      "type": "price",
      "name": "商品价格",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "use_product_price", "label": "使用商品价格", "default": false },
        { "type": "text", "id": "price_text", "label": "备用价格", "default": "$29.00" },
        { "type": "text", "id": "shipping_text", "label": "配送说明", "default": "Kostenloser Versand." }
      ]
    },
    {
      "type": "variant_picker",
      "name": "规格选择器",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "label": "选择器类型",
          "options": [
            { "value": "button", "label": "按钮" },
            { "value": "dropdown", "label": "下拉菜单" }
          ],
          "default": "button"
        },
        { "type": "checkbox", "id": "show_size_guide", "label": "尺寸选项显示尺码指南", "default": true },
        { "type": "text", "id": "size_guide_label", "label": "尺码指南文字", "default": "SIZE GUIDE" },
        { "type": "image_picker", "id": "size_guide_image", "label": "尺码指南弹窗图片" },
        { "type": "text", "id": "popular_size", "label": "热门规格值", "default": "" },
        { "type": "text", "id": "popular_size_label", "label": "热门规格标签", "default": "Bestseller" }
      ]
    },
    {
      "type": "buy_button",
      "name": "购买按钮",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "按钮文字", "default": "Add To Cart" },
        { "type": "checkbox", "id": "show_hanging_kit", "label": "显示可选挂件", "default": false },
        { "type": "text", "id": "hanging_kit_heading", "label": "可选项目标题", "default": "Optional" },
        { "type": "text", "id": "hanging_kit_label", "label": "挂件标签", "default": "Hanging kit" },
        { "type": "text", "id": "hanging_kit_note", "label": "挂件说明", "default": "" },
        { "type": "text", "id": "hanging_kit_property_name", "label": "购物车属性名称", "default": "Hanging kit" },
        { "type": "text", "id": "hanging_kit_property_value", "label": "购物车属性值", "default": "Yes" },
        { "type": "text", "id": "hanging_kit_variant_id", "label": "可选附加商品变体 ID", "default": "" }
      ]
    },
    {
      "type": "volume_discount",
      "name": "多件优惠",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "标题", "default": "🌞 SUMMER-SALE: Get more, save more! 🎉" },
        { "type": "text", "id": "note", "label": "辅助说明", "default": "Can be combined with already discounted items!" }
      ]
    },
    {
      "type": "benefits",
      "name": "商品卖点",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "benefit_1", "label": "卖点 1", "default": "Immediately Ready to hang" },
        { "type": "text", "id": "benefit_2", "label": "卖点 2", "default": "Free worldwide shipping over €49" },
        { "type": "text", "id": "benefit_3", "label": "卖点 3", "default": "Estimated delivery: August 15 - August 17" }
      ]
    },
    {
      "type": "payment_trust",
      "name": "支付保障",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "标题", "default": "SECURELY PACKAGED & PAID" },
        { "type": "text", "id": "note", "label": "辅助说明", "default": "Special packaging for art galleries" }
      ]
    }
  ],
  "presets": [
    {
      "name": "商品主信息",
      "blocks": [
        { "type": "top_badge" },
        { "type": "brand_banner" },
        { "type": "reviews" },
        { "type": "title" },
        { "type": "artist" },
        { "type": "price" },
        { "type": "variant_picker" },
        { "type": "buy_button" },
        { "type": "volume_discount" },
        { "type": "benefits" },
        { "type": "payment_trust" }
      ]
    }
  ]
}
{% endschema %}
