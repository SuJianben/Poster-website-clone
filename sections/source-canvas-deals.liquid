{% if section.settings.enabled %}
  {% if section.blocks.size > 0 %}
    {% render 'source-canvas-deals-configurable', section:section %}
  {% else %}
    {% render 'source-canvas-deals-1' %}
  {% endif %}
{% endif %}
{% schema %}
{
  "name": "画布优惠",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "显示模块", "default": true },
    { "type": "text", "id": "heading_prefix", "label": "标题前缀", "default": "LEINWAND" },
    { "type": "text", "id": "heading_highlight", "label": "标题高亮文字", "default": "DEALS" },
    { "type": "text", "id": "heading_suffix", "label": "标题后缀", "default": "SHOPPEN %" },
    { "type": "text", "id": "promotion_text", "label": "促销链接文字", "default": "20% auf alle Leinwand Neuheiten und mehr" },
    { "type": "url", "id": "promotion_link", "label": "促销链接" },
    { "type": "text", "id": "collection_label", "label": "系列按钮文字", "default": "Zur Kollektion" }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "系列标签",
      "settings": [
        { "type": "collection", "id": "collection", "label": "系列" },
        { "type": "text", "id": "label", "label": "标签名称" },
        { "type": "header", "content": "可选推广卡片" },
        { "type": "image_picker", "id": "promo_image", "label": "推广图片" },
        { "type": "text", "id": "promo_heading", "label": "推广标题", "default": "ALLE NEUHEITEN -20%" },
        { "type": "text", "id": "promo_button_label", "label": "推广按钮文字", "default": "ZUSCHLAGEN" },
        { "type": "url", "id": "promo_link", "label": "推广链接" }
      ]
    }
  ],
  "presets": [{ "name": "画布优惠" }]
}
{% endschema %}
