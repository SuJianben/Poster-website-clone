{% if section.settings.enabled %}
  {% render 'source-canvas-deals-configurable', section:section %}
{% endif %}
{% schema %}
{
  "name": "画布优惠",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "显示模块", "default": true },
    { "type": "text", "id": "heading_prefix", "label": "标题前缀", "default": "CANVAS" },
    { "type": "text", "id": "heading_highlight", "label": "标题高亮文字", "default": "ERBJUDANDEN" },
    { "type": "text", "id": "heading_suffix", "label": "标题后缀", "default": "SHOPPA −20%" },
    { "type": "text", "id": "promotion_text", "label": "促销链接文字", "default": "20 % rabatt på alla nya canvasmotiv och mer" },
    { "type": "url", "id": "promotion_link", "label": "促销链接" },
    { "type": "text", "id": "collection_label", "label": "系列按钮文字", "default": "Till kollektionen" }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "系列标签",
      "settings": [
        { "type": "collection", "id": "collection", "label": "系列" },
        { "type": "text", "id": "label", "label": "标签名称" },
        { "type": "header", "content": "可选推广卡片" },
        { "type": "image_picker", "id": "promo_image", "label": "推广图片" },
        { "type": "text", "id": "promo_heading", "label": "推广标题", "default": "ALLA NYHETER −20%" },
        { "type": "text", "id": "promo_button_label", "label": "推广按钮文字", "default": "HANDLA NU" },
        { "type": "url", "id": "promo_link", "label": "推广链接" }
      ]
    }
  ],
  "presets": [{ "name": "画布优惠" }]
}
{% endschema %}
