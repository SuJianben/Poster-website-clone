{{ 'source-reviews-page.css' | asset_url | stylesheet_tag }}
{{ 'source-reviews-hero.css' | asset_url | stylesheet_tag }}
{{ 'source-reviews-summary.css' | asset_url | stylesheet_tag }}
{{ 'source-reviews-content.css' | asset_url | stylesheet_tag }}
<script src="{{ 'source-reviews-page.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'source-reviews-hero.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'source-reviews-summary.js' | asset_url }}" defer="defer"></script>

<section class="srp-page" data-srp-page data-analytics-page="reviews_fallback">
  <header class="srp-page__heading"><h1>Reviews</h1></header>
  <section class="srp-page__hero" aria-label="Our happy customers">
    <img src="https://dotcomcanvas.de/cdn/shop/files/Trustpilot_Kunden_Bewertungen_Reviews_Fotos_Banner.png?v=1773373385&width=2400" width="3584" height="1184" alt="DOTCOMCANVAS customer artwork and reviews">
    <div class="srp-page__hero-copy" data-srp-hero-copy>
      <h2 data-srp-hero-heading>
        <em class="srp-page__hero-highlight" data-srp-hero-highlight>
          Our happy customers
          <svg viewBox="0 -55 800 420" class="srp-page__hero-highlight-svg" stroke="currentColor" fill="none" role="presentation" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path transform="matrix(0.9791300296783447,0,0,0.9791300296783447,400,179)" stroke-linejoin="miter" stroke-miterlimit="4" stroke-width="16" pathLength="1" d=" M253,-161 C253,-161 -284.78900146484375,-201.4600067138672 -376,-21 C-469,163 67.62300109863281,174.2100067138672 256,121 C564,34 250.82899475097656,-141.6929931640625 19.10700035095215,-116.93599700927734"/>
          </svg>
        </em>
      </h2>
      <p data-srp-hero-subtitle>Real reviews, real inspiration</p>
    </div>
  </section>

  <section class="srp-widget" aria-labelledby="srp-customer-reviews">
    <h2 class="srp-widget__access-title" id="srp-customer-reviews">Customer Reviews</h2>
    <div class="srp-widget__summary" data-srp-summary>
      <div class="srp-widget__overview">
        <span class="srp-widget__score"><strong>4.9</strong></span>
        <span class="srp-widget__summary-stars" role="img" aria-label="5 out of 5 stars"><i></i><i></i><i></i><i></i><i></i></span>
        <small>Based on 2,627 Reviews</small>
      </div>
      <div class="srp-widget__ratings" aria-label="Review rating distribution">
        {% assign ratings = '5|94|2462,4|6|157,3|0|5,2|0|0,1|0|1' | split: ',' %}
        {% for rating in ratings %}
          {% assign row = rating | split: '|' %}
          <button type="button" data-srp-rating-filter="{{ row[0] }}" aria-pressed="false">
            <span class="srp-widget__rating-stars srp-widget__rating-stars--{{ row[0] }}" aria-label="{{ row[0] }} out of 5 stars">{{ row[0] }} stars</span><i aria-hidden="true"><b style="width:{{ row[1] }}%"></b></i><em>({{ row[2] }})</em>
          </button>
        {% endfor %}
      </div>
      <div class="srp-widget__photos" data-srp-photo-strip>
        <p>Customer Photos</p>
        <div class="srp-widget__photo-viewport">
          <div class="srp-widget__photo-track">
            <button type="button" data-srp-summary-photo data-reviewer="Philipp H." data-verified="Verified Buyer" data-date="10.10.2021" data-title="Great designs in the best quality" data-body="First-class work! We are very satisfied!!!" data-product="Think outside the Box" data-product-image="https://cdn.shopify.com/s/files/1/0601/1253/5810/products/WandbildMotivationsspruchPosterThinkoutsidethebox1347-12_medium.jpg?v=1731603249" data-video="https://cdn1.stamped.io/uploads/videos/a8e34717bc9fe2f9f83292b1af39b519.mp4"><img src="https://cdn.stamped.io/uploads/videos/a8e34717bc9fe2f9f83292b1af39b519.jpg" width="70" height="55" alt="Think outside the Box customer photo"></button>
            <button type="button" data-srp-summary-photo data-reviewer="Oliver S." data-verified="Verified Buyer" data-title="An absolute eye-catcher" data-body="The quality and workmanship exceeded our expectations." data-product="Guernica Picasso"><img src="https://cdn.stamped.io/uploads/videos/a81216b4654bdcfbd850b985640f44c5.jpg" width="70" height="55" alt="Guernica Picasso customer photo"></button>
            <button type="button" data-srp-summary-photo data-reviewer="Stefanie W." data-verified="Verified Buyer" data-date="11.05.2026" data-title="Top Product" data-body="Great product, fast delivery and secure packaging." data-product="Save Water - Canvas"><img src="https://cdn.stamped.io/uploads/videos/6cab27b9e5a6e8abf7376643397e3aaf.jpg" width="70" height="55" alt="Save Water customer photo"></button>
            <button type="button" data-srp-summary-photo data-reviewer="Patrik F." data-verified="Verified Buyer" data-title="Perfect" data-body="The picture looks fantastic and arrived safely packaged." data-product="Royal American Canvas"><img src="https://cdn.stamped.io/uploads/videos/8c7e5f380f1f3173c8dd30029278b25a.jpg" width="70" height="55" alt="Royal American Canvas customer photo"></button>
            <button type="button" data-srp-summary-photo data-reviewer="Sükrü U." data-verified="Verified Buyer" data-title="Very good quality" data-body="Beautiful colors and an impressive finish." data-product="More Money Duck"><img src="https://cdn.stamped.io/uploads/videos/21a4e1daec458d792212652c1cf5085a.jpg" width="70" height="55" alt="More Money Duck customer photo"></button>
            <button type="button" data-srp-summary-photo data-reviewer="Carlos W." data-verified="Verified Buyer" data-title="Looks amazing" data-body="Exactly as shown and delivered quickly." data-product="Fast Bunny Limited"><img src="https://cdn.stamped.io/uploads/videos/8d136012af53db6d82ac7069af53cca7.jpg" width="70" height="55" alt="Fast Bunny customer photo"></button>
            <button type="button" data-srp-summary-photo data-reviewer="Nici" data-verified="Verified Buyer" data-title="Love it" data-body="A striking piece with excellent print quality." data-product="Get Rich"><img src="https://cdn.stamped.io/uploads/videos/256ca76b86bd47423f1e89aa58eb9d08.jpg" width="70" height="55" alt="Get Rich customer photo"></button>
            <button type="button" data-srp-summary-photo data-reviewer="Kurt K." data-verified="Verified Buyer" data-title="Motivation every day" data-body="The artwork brings the room to life." data-product="Mac Miller Creative"><img src="https://cdn.stamped.io/uploads/videos/bef1f5c940fc5baa3a4fcc3ccd787683.jpg" width="70" height="55" alt="Mac Miller Creative customer photo"></button>
          </div>
        </div>
      </div>
    </div>

    <div class="srp-widget__tabs" role="tablist"><button class="is-active" type="button" role="tab" aria-selected="true" data-srp-tab="reviews">Reviews <span>2624</span></button><button type="button" role="tab" aria-selected="false" data-srp-tab="questions">Questions <span>0</span></button></div>
    <form class="srp-widget__form" data-srp-form hidden>
      <button type="button" class="srp-widget__form-close" data-srp-close-form aria-label="Close">×</button><h3 data-srp-form-title>Write a review</h3>
      <div class="srp-widget__form-row"><label>Name<input required name="name" autocomplete="name" placeholder="Enter your name"></label><label>Email<input required type="email" name="email" autocomplete="email" placeholder="john.smith@example.com"></label><label>Location<input name="location" placeholder="e.g. Paris, France"></label></div>
      <label class="srp-widget__form-stars">Rating <span data-srp-rating-input><button type="button" data-value="1">★</button><button type="button" data-value="2">★</button><button type="button" data-value="3">★</button><button type="button" data-value="4">★</button><button type="button" data-value="5">★</button></span></label><label>Title of Review<input required name="title" placeholder="Give your review a title"></label><label>How was your overall experience?<textarea required name="message" rows="5"></textarea></label><button class="srp-widget__submit" type="submit">Submit</button>
    </form>

    <div class="srp-widget__filters" data-srp-review-controls><label>Sort<select data-srp-sort aria-label="Sort reviews"><option value="featured">Sort</option><option value="photos">With Photos</option><option value="recent">Most Recent</option><option value="highest">Highest Rating</option><option value="lowest">Lowest Rating</option><option value="helpful">Most Helpful</option></select></label><span>Filter Reviews:</span></div>

    <div class="srp-widget__review-grid" data-srp-grid>
      <article class="srp-review" data-srp-review data-srp-photo="true" data-srp-rating="5"><div class="srp-review__gallery"><img src="https://cdn.stamped.io/tr:w-350:/uploads/photos/228253_8264592785674_bbcf5af6_6d4e_4392_8109_868d996fa81e.jpg?" alt="Customer submitted artwork"><img src="https://cdn.stamped.io/tr:w-350:/uploads/photos/228253_8264592785674_adfda815_b601_4a92_ab18_bcb336669c34.jpg?" alt="Customer submitted artwork"><img src="https://cdn.stamped.io/tr:w-350:/uploads/photos/228253_8264592785674_3cc4f078_0a80_4335_a599_175c3974ca6b.jpg?" alt="Customer submitted artwork"><img src="https://cdn.stamped.io/tr:w-350:/uploads/photos/228253_8264592785674_85af7e91_7171_4fd5_81c6_e48557cb06fc.jpg?" alt="Customer submitted artwork"><img src="https://cdn.stamped.io/tr:w-350:/uploads/photos/228253_8264592785674_6b62d13f_3bca_4491_b59f_9dd2d48a635a.jpg?" alt="Customer submitted artwork"></div><div class="srp-review__meta"><span>★★★★★</span><time>16/06/2026</time></div><dl><dt>Was hast du bestellt?</dt><dd>Acrylglasbild, Blattgoldbild</dd><dt>Wie alt bist du?</dt><dd>60</dd><dt>Was machst du beruflich?</dt><dd>Entrepreneur</dd><dt>Wo hängt das Wandbild?</dt><dd>Livingroom, kitchen, toilet</dd><dt>Wie bewertest du die Druckqualität?</dt><dd>Schlecht <i>●●●●●</i> Perfekt</dd></dl><h3>7 beautiful acrylglas work in my home</h3><p>I have ordered paintings over the years and I am very proud of the acrylic glass work. They are my home decorations items. I have accumulated 7 of them over the year. Guests who visit my home are interested in them because acrylic glass work are immediately noticeable.</p><a href="/collections/all">Shit Happens - Acrylic Glass - 40 × 40 CM / Ohne Rahmen</a><footer><strong>Tapio V.</strong><span>Finland · Verified Buyer</span></footer><button type="button" data-srp-helpful>Was this helpful? <b>♧ 0</b> <b>♢ 0</b></button></article>
      <article class="srp-review" data-srp-review data-srp-photo="true" data-srp-rating="5"><img src="https://cdn.stamped.io/tr:h-800:/uploads/photos/228253_8264592785674_3cc4f078_0a80_4335_a599_175c3974ca6b.jpg?" alt="Customer submitted artwork"><div class="srp-review__meta"><span>★★★★★</span><time>07/06/2026</time></div><dl><dt>Bestellung</dt><dd>Acrylglasbild</dd><dt>Alter</dt><dd>52</dd><dt>Beruf</dt><dd>Carpenter</dd><dt>Anwendung</dt><dd>Will be the living room</dd><dt>Druckqualität</dt><dd>Schlecht <i>●●●●●</i> Perfekt</dd></dl><h3>Awesome company</h3><p>Yesterday I received my 6th piece of artwork from dotcomcanvas. Once again, the colours and attention to detail are top quality. Customer service is fantastic, shipping and delivery are fast and reliable.</p><footer><strong>James C.</strong><span>United Kingdom</span></footer><button type="button" data-srp-helpful>Was this helpful? <b>♧ 0</b> <b>♢ 0</b></button></article>
      <article class="srp-review" data-srp-review data-srp-photo="true" data-srp-rating="5"><img src="https://cdn.stamped.io/tr:h-800:/uploads/photos/228253_8202634854666_e52e860b_9db8_4f3c_8a81_0cd68bfa9de8.jpg?" alt="Customer submitted artwork"><div class="srp-review__meta"><span>★★★★★</span><time>06/06/2026</time></div><dl><dt>Was hast du bestellt?</dt><dd>Acrylglasbild</dd><dt>Wie bewertest du die Druckqualität?</dt><dd>Schlecht <i>●●●●●</i> Perfekt</dd><dt>Wie bewertest du die Verarbeitung?</dt><dd>Schlecht <i>●●●●●</i> Perfekt</dd></dl><h3>5/5</h3><p>Tilaaminen todella helppoa ja tuote tuli noin viikossa perille. Taulut vaikuttaa korkea laatuiselta.</p><a href="/collections/all">Queen Card - Acrylglas</a><footer><strong>Tomi K.</strong><span>Finland</span></footer><button type="button" data-srp-helpful>Was this helpful? <b>♧ 1</b> <b>♢ 0</b></button></article>
      <article class="srp-review" data-srp-review data-srp-photo="true" data-srp-rating="5"><img src="https://cdn.stamped.io/tr:h-800:/uploads/photos/228253_10484023623946_f6621af5_7a5c_4871_8105_f5465414762a_r1780202711687.jpg?v=1780202711" alt="Customer submitted artwork"><div class="srp-review__meta"><span>★★★★★</span><time>29/05/2026</time></div><dl><dt>Was hast du bestellt?</dt><dd>Leinwandbild</dd><dt>Wie alt bist du?</dt><dd>24</dd><dt>Was machst du beruflich?</dt><dd>Sales</dd><dt>Wo hängt das Wandbild?</dt><dd>Living Room</dd></dl><h3>Bild</h3><p>Hat alles super geklappt, Qualität ist gut und Lieferung war schnell!</p><a href="/collections/all">Old Money Duck</a><footer><strong>Daniel S.</strong><span>Switzerland · Verified Buyer</span></footer><button type="button" data-srp-helpful>Was this helpful? <b>♧ 2</b> <b>♢ 0</b></button></article>
    </div>
    <nav class="srp-widget__pagination" aria-label="Reviews pagination"><button disabled type="button">‹</button><button class="is-current" type="button">1</button><button type="button">2</button><button type="button">3</button><button type="button">4</button><button type="button">5</button><button type="button">6</button><button type="button">7</button><button type="button">8</button><button type="button">9</button><button type="button">10</button><button type="button">›</button></nav>
    <div class="srp-widget__questions" data-srp-questions hidden><p>There are no customer questions yet.</p><button type="button" data-srp-open-form="question">Ask a Question</button></div>
  </section>

  <section class="srp-community"><h2>Our community</h2><div class="srp-community__frame"><button type="button" data-srp-community-prev aria-label="Previous">‹</button><div data-srp-community-content></div><button type="button" data-srp-community-next aria-label="Next">›</button></div><button type="button" class="srp-community__more" data-srp-load-more>Load More</button></section>
  <section class="srp-instagram"><h2>Instagram</h2><div class="srp-instagram__empty" aria-label="Instagram feed fallback"></div></section>
  <section class="srp-write"><h2>Write a review</h2><p>We would appreciate feedback via <a href="/pages/contact">the contact form.</a><br>or look forward to an official review after placing an order!</p><button type="button" data-srp-open-form="review">Write a review <span>›</span></button></section>
</section>

