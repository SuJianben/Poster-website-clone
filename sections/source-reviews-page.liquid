{{ 'source-reviews-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'source-reviews-page.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign fallback_reviews = '7 beautiful acrylglas work in my home|I have ordered paintings over the years and I am very proud of the acrylic glass work. They are a beautiful part of my home decorations, and guests always ask about them.|Tapio V.|Finland|Shit Happens - Acrylic Glass 40 × 40 CM~Awesome company|Yesterday I received my 6th piece of artwork from DOTCOMCANVAS. The colours and attention to detail are top quality, and customer service was fantastic.|James C.|United Kingdom|Queen - Acrylic Glass~Top quality|The print quality and finish are perfect. It looks even better in our living room than we expected.|Tom K.|Germany|Donald Duck - Canvas' | split: '~'
%}

<section class="srp-page" data-srp-page data-analytics-page="reviews_fallback">
  <header class="srp-page__heading"><h1>Reviews</h1></header>

  <section class="srp-page__hero" aria-label="Our happy customers">
    <img src="https://dotcomcanvas.de/cdn/shop/files/Trustpilot_Kunden_Bewertungen_Reviews_Fotos_Banner.png?v=1773373385&width=2400" alt="DOTCOMCANVAS customer artwork and reviews">
    <div class="srp-page__hero-copy">
      <h2>Our happy customers</h2>
      <p>Real reviews, real inspiration</p>
    </div>
  </section>

  <section class="srp-page__reviews" aria-labelledby="srp-reviews-heading">
    <div class="srp-page__summary">
      <div class="srp-page__score"><strong>4.9</strong><span aria-label="5 out of 5 stars">★★★★★</span><small>Based on 2,624 Reviews</small></div>
      <div class="srp-page__breakdown" aria-label="Rating breakdown">
        <span>5 ★ <i style="--srp-fill:94%"></i><b>(2461)</b></span>
        <span>4 ★ <i style="--srp-fill:6%"></i><b>(157)</b></span>
        <span>3 ★ <i style="--srp-fill:1%"></i><b>(5)</b></span>
        <span>2 ★ <i style="--srp-fill:0%"></i><b>(0)</b></span>
        <span>1 ★ <i style="--srp-fill:1%"></i><b>(1)</b></span>
      </div>
      <div class="srp-page__photo-wall" aria-label="Customer photos">
        <img src="https://dotcomcanvas.de/cdn/shop/files/Trustpilot_Kunden_Bewertungen_Reviews_Fotos_Banner.png?v=1773373385&width=300" alt="Customer artwork">
        <img src="https://dotcomcanvas.de/cdn/shop/files/Trustpilot_Kunden_Bewertungen_Reviews_Fotos_Banner.png?v=1773373385&width=400" alt="Customer artwork">
        <img src="https://dotcomcanvas.de/cdn/shop/files/Trustpilot_Kunden_Bewertungen_Reviews_Fotos_Banner.png?v=1773373385&width=500" alt="Customer artwork">
        <img src="https://dotcomcanvas.de/cdn/shop/files/Trustpilot_Kunden_Bewertungen_Reviews_Fotos_Banner.png?v=1773373385&width=600" alt="Customer artwork">
      </div>
    </div>

    <div class="srp-page__review-toolbar">
      <h2 id="srp-reviews-heading">Reviews <span>2624</span></h2>
      <div class="srp-page__filter-wrap">
        <button type="button" class="srp-page__photos-toggle" data-srp-photos aria-pressed="false">With Photos</button>
        <label class="srp-page__sort-label">Sort
          <select data-srp-sort aria-label="Sort reviews"><option value="recent">Most Recent</option><option value="highest">Highest Rating</option><option value="lowest">Lowest Rating</option><option value="helpful">Most Helpful</option></select>
        </label>
      </div>
    </div>

    <div class="srp-page__review-grid" data-srp-grid>
      {% for item in fallback_reviews %}
        {% assign fields = item | split: '|' %}
        <article class="srp-page__review" data-srp-review data-srp-rating="5" data-srp-photo="{% if forloop.index == 1 %}true{% else %}false{% endif %}">
          {% if forloop.index == 1 %}<img class="srp-page__review-photo" src="https://dotcomcanvas.de/cdn/shop/files/Trustpilot_Kunden_Bewertungen_Reviews_Fotos_Banner.png?v=1773373385&width=640" alt="Customer submitted artwork">{% endif %}
          <div class="srp-page__review-stars">★★★★★ <time>{{ 'now' | date: '%d/%m/%Y' }}</time></div>
          <h3>{{ fields[0] }}</h3><p>{{ fields[1] }}</p>
          <p class="srp-page__review-product">{{ fields[4] }}</p>
          <footer><strong>{{ fields[2] }}</strong><span>{{ fields[3] }}</span></footer>
          <button type="button" class="srp-page__helpful" data-srp-helpful>Was this helpful? <span>♡ 0</span><span>♢ 0</span></button>
        </article>
      {% endfor %}
    </div>
    <nav class="srp-page__pagination" aria-label="Reviews pagination"><button type="button" disabled>‹</button><button class="is-current" type="button">1</button><button type="button">2</button><button type="button">3</button><span>…</span><button type="button">10</button><button type="button">›</button></nav>
  </section>

  <section class="srp-page__community" aria-labelledby="srp-community-heading">
    <h2 id="srp-community-heading">Our community</h2>
    <div class="srp-page__community-stage"><button type="button" aria-label="Previous community photos">‹</button><p>Customer photos and real homes are shown here when the review feed is connected.</p><button type="button" aria-label="Next community photos">›</button></div>
  </section>

  <section class="srp-page__write-review" aria-labelledby="srp-write-heading">
    <h2 id="srp-write-heading">Write a review</h2>
    <p>We would appreciate feedback via <a href="/pages/contact">the contact form.</a><br>Or leave an official review after placing an order.</p>
    <a href="/pages/contact" class="srp-page__write-button">Write a review <span>›</span></a>
  </section>
</section>

{% schema %}
{
  "name": "Source reviews page",
  "settings": []
}
{% endschema %}
