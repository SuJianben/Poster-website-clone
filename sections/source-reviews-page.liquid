{{ 'source-reviews-page.css' | asset_url | stylesheet_tag }}
{{ 'source-reviews-hero.css' | asset_url | stylesheet_tag }}
{{ 'source-reviews-summary.css' | asset_url | stylesheet_tag }}
{{ 'source-product-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'source-product-reviews.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'source-reviews-summary.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign page_label = section.settings.page_label | default: 'Bewertungen'
  assign reviews_list_rendered = false
-%}

<section
  class="srp-page"
  {{ section.shopify_attributes }}
  data-srp-page
  data-section-id="{{ section.id }}"
  data-analytics-page="reviews_fallback"
  aria-label="{{ page_label | escape }}"
>
  {%- if section.blocks.size == 0 and request.design_mode -%}
    <div class="srp-page__content-block srp-page__empty-block" role="status">
      请点击“添加块”，开始配置评价页面的标题、图片、文字和评价列表。
    </div>
  {%- endif -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'heading' -%}
        <header class="srp-page__heading" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h1>{{ block.settings.heading | escape }}</h1>
          {%- endif -%}
        </header>

      {%- when 'hero' -%}
        {%- liquid
          assign hero_image_src = block.settings.image_url | strip
          assign hero_image_width = 3584
          assign hero_image_height = 1184
          if block.settings.image != blank
            assign hero_image_src = block.settings.image | image_url: width: 2400
            assign hero_image_width = block.settings.image.width
            assign hero_image_height = block.settings.image.height
          endif
          if hero_image_src == blank
            assign hero_image_src = 'https://dotcomcanvas.de/cdn/shop/files/Trustpilot_Kunden_Bewertungen_Reviews_Fotos_Banner.png?v=1773373385&width=2400'
          endif
          assign hero_alt = block.settings.alt | default: 'DOTCOMCANVAS customer artwork and reviews'
        -%}
        <section
          class="srp-page__hero"
          style="--srp-highlight-color: {{ block.settings.highlight_color | default: '#a18d34' | escape }};"
          aria-label="{{ block.settings.aria_label | default: block.settings.heading | default: page_label | escape }}"
          {{ block.shopify_attributes }}
        >
          <img
            src="{{ hero_image_src | escape }}"
            width="{{ hero_image_width }}"
            height="{{ hero_image_height }}"
            alt="{{ hero_alt | escape }}"
            loading="eager"
          >
          <div class="srp-page__hero-copy image-with-text-ovelay__content-wrapper content-overlay content-overlay--middle-center-mobile content-overlay--middle-center color-scheme-inverse" data-srp-hero-copy>
            <div class="srp-page__hero-rich-text relative z-1 rich-text text-center md:text-center">
              {%- if block.settings.heading != blank -%}
                <h2 class="srp-page__hero-heading rich-text__heading hd2" data-srp-hero-heading>
                  <motion-element data-motion="fade-up" data-motion-delay="50" class="block">
                    {%- if block.settings.show_highlight -%}
                      <em is="highlight-text" class="srp-page__hero-highlight highlight-text relative inline-block font-normal highlight-text--hand-drawn-circle animate" data-srp-hero-highlight>
                        {{ block.settings.heading | escape }}
                        <svg viewBox="0 -55 800 420" class="srp-page__hero-highlight-svg absolute highlight-text__svg" stroke="currentColor" fill="none" role="presentation" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"><path transform="matrix(0.9791300296783447,0,0,0.9791300296783447,400,179)" stroke-linejoin="miter" stroke-miterlimit="4" stroke-width="16" pathLength="1" d=" M253,-161 C253,-161 -284.78900146484375,-201.4600067138672 -376,-21 C-469,163 67.62300109863281,174.2100067138672 256,121 C564,34 250.82899475097656,-141.6929931640625 19.10700035095215,-116.93599700927734"/></svg>
                      </em>
                    {%- else -%}
                      {{ block.settings.heading | escape }}
                    {%- endif -%}
                  </motion-element>
                </h2>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <motion-element data-motion="fade-up" data-motion-delay="100" class="srp-page__hero-subtitle block rich-text__text rte text-base">{{ block.settings.subheading }}</motion-element>
              {%- endif -%}
            </div>
          </div>
        </section>

      {%- when 'summary' -%}
        <section class="srp-widget srp-page__summary-block" aria-labelledby="srp-customer-reviews-{{ block.id }}" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h2 class="srp-page__block-heading">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          <h2 class="srp-widget__access-title" id="srp-customer-reviews-{{ block.id }}">{{ block.settings.accessible_heading | default: 'Customer Reviews' | escape }}</h2>
          {% render 'source-reviews-summary',
            variant: 'page',
            review_count: block.settings.review_count,
            average_rating: block.settings.average_rating,
            section: section,
            manual_review_photos: block.settings.use_manual_photos,
            use_manual_summary: true,
            use_custom_summary: block.settings.use_custom_summary
          %}
        </section>

      {%- when 'rich_text' -%}
        <section class="srp-page__content-block srp-page__text-block srp-page__text-block--{{ block.settings.alignment | default: 'left' }}" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h2>{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <div class="srp-page__text rte">{{ block.settings.body }}</div>
          {%- endif -%}
        </section>

      {%- when 'image' -%}
        {%- liquid
          assign content_image_src = block.settings.image_url | strip
          assign content_image_width = 1200
          assign content_image_height = 800
          if block.settings.image != blank
            assign content_image_src = block.settings.image | image_url: width: 2400
            assign content_image_width = block.settings.image.width
            assign content_image_height = block.settings.image.height
          endif
          assign content_image_alt = block.settings.alt | default: block.settings.caption | default: 'Review page image'
        -%}
        {%- if content_image_src != blank -%}
          <figure class="srp-page__content-block srp-page__image-block srp-page__image-block--{{ block.settings.width | default: 'content' }}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link | escape }}">{%- endif -%}
              <img src="{{ content_image_src | escape }}" width="{{ content_image_width }}" height="{{ content_image_height }}" alt="{{ content_image_alt | strip_html | escape }}" loading="lazy">
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
            {%- if block.settings.caption != blank -%}<figcaption class="srp-page__image-caption rte">{{ block.settings.caption }}</figcaption>{%- endif -%}
          </figure>
        {%- elsif request.design_mode -%}
          <div class="srp-page__content-block srp-page__empty-block" {{ block.shopify_attributes }}>请在此图片区块中选择图片，或粘贴图片链接。</div>
        {%- endif -%}

      {%- when 'reviews' -%}
        {%- if reviews_list_rendered == false -%}
          {%- liquid
            assign reviews_list_rendered = true
            assign reviews_write_heading = block.settings.write_heading | default: section.settings.write_heading
            assign reviews_contact_url = block.settings.contact_url | default: section.settings.contact_url
            assign reviews_append_to_existing = block.settings.append_to_existing
            if reviews_append_to_existing == nil
              assign reviews_append_to_existing = true
            endif
          -%}
          <section
            class="sprv srp-page__shared-reviews"
            data-sprv-root
            data-section-id="{{ section.id }}-reviews-{{ block.id }}"
            data-sprv-default-filter="{{ section.settings.default_filter | default: 'recent' }}"
            data-sprv-page-size="{{ section.settings.reviews_per_page | default: 12 }}"
            aria-label="{{ block.settings.aria_label | default: 'Customer review list' | escape }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.heading != blank -%}
              <div class="srp-page__reviews-heading"><h2>{{ block.settings.heading | escape }}</h2></div>
            {%- endif -%}
            <div class="sprv__widget"><div class="sprv__inner">
              {% render 'source-product-reviews-list',
                section: section,
                review_count: block.settings.review_count,
                show_write: block.settings.show_write,
                write_heading: reviews_write_heading,
                contact_url: reviews_contact_url,
                preserve_legacy: reviews_append_to_existing,
                legacy_count: 12
              %}
            </div></div>
          </section>
        {%- elsif request.design_mode -%}
          <div class="srp-page__content-block srp-page__empty-block srp-page__duplicate-reviews-block" {{ block.shopify_attributes }}>
            评价列表模块已经存在；客户评论块会自动加入现有评价区，请保留一个评价列表模块。
          </div>
        {%- endif -%}

      {%- when '@app' -%}
        <div class="srp-page__app-block" {{ block.shopify_attributes }}>{% render block %}</div>

      {%- when 'review' -%}
        {%- comment -%}Review blocks are rendered by the reviews block above.{%- endcomment -%}
    {%- endcase -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "评价页面",
  "settings": [
    { "type": "text", "id": "page_label", "label": "页面无障碍名称", "default": "Bewertungen" },
    { "type": "text", "id": "write_heading", "label": "默认写评价标题", "default": "Write a review" },
    { "type": "url", "id": "contact_url", "label": "默认写评价链接" },
    {
      "type": "select",
      "id": "default_filter",
      "label": "默认评价筛选",
      "default": "recent",
      "options": [
        { "value": "recent", "label": "最新评价" },
        { "value": "photos", "label": "带图片的评价" },
        { "value": "highest-rating", "label": "评分从高到低" },
        { "value": "lowest-rating", "label": "评分从低到高" },
        { "value": "most-votes", "label": "最有帮助" }
      ]
    },
    { "type": "range", "id": "reviews_per_page", "label": "每页评价数量", "min": 4, "max": 24, "step": 1, "default": 12 }
  ],
  "max_blocks": 50,
  "blocks": [
    {
      "type": "heading",
      "name": "页面标题",
      "settings": [
        { "type": "text", "id": "heading", "label": "标题", "default": "Bewertungen" }
      ]
    },
    {
      "type": "hero",
      "name": "评价 Hero 图片",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片" },
        { "type": "text", "id": "image_url", "label": "图片外链（可选）" },
        { "type": "text", "id": "alt", "label": "图片替代文本", "default": "DOTCOMCANVAS customer artwork and reviews" },
        { "type": "text", "id": "aria_label", "label": "模块无障碍名称", "default": "Unsere Glücklichen Kunden" },
        { "type": "text", "id": "heading", "label": "主标题", "default": "Unsere Glücklichen Kunden" },
        { "type": "richtext", "id": "subheading", "label": "副标题", "default": "<p>Echte Bewertungen, Echte Inspiration</p>" },
        { "type": "checkbox", "id": "show_highlight", "label": "显示标题手绘圈", "default": true },
        { "type": "color", "id": "highlight_color", "label": "高亮颜色", "default": "#A18D34" }
      ]
    },
    {
      "type": "summary",
      "name": "评价统计",
      "settings": [
        { "type": "text", "id": "heading", "label": "标题（可选）" },
        { "type": "text", "id": "accessible_heading", "label": "无障碍标题", "default": "Customer Reviews" },
        { "type": "text", "id": "review_count", "label": "评价总数", "default": "2626" },
        { "type": "text", "id": "average_rating", "label": "平均评分", "default": "4,9" },
        { "type": "checkbox", "id": "use_custom_summary", "label": "固定使用上面的评分和数量", "default": true },
        { "type": "checkbox", "id": "use_manual_photos", "label": "使用客户评论区块中的图片", "default": false }
      ]
    },
    {
      "type": "rich_text",
      "name": "说明文字（非评论）",
      "settings": [
        { "type": "text", "id": "heading", "label": "标题" },
        { "type": "richtext", "id": "body", "label": "正文", "default": "<p>在这里添加评价页面的说明文字。</p>" },
        {
          "type": "select",
          "id": "alignment",
          "label": "对齐方式",
          "default": "left",
          "options": [
            { "value": "left", "label": "左对齐" },
            { "value": "center", "label": "居中" },
            { "value": "right", "label": "右对齐" }
          ]
        }
      ]
    },
    {
      "type": "image",
      "name": "图片内容",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片" },
        { "type": "text", "id": "image_url", "label": "图片外链（可选）" },
        { "type": "text", "id": "alt", "label": "替代文本" },
        { "type": "url", "id": "link", "label": "图片链接（可选）" },
        { "type": "richtext", "id": "caption", "label": "图片说明" },
        {
          "type": "select",
          "id": "width",
          "label": "图片宽度",
          "default": "content",
          "options": [
            { "value": "content", "label": "内容宽度" },
            { "value": "wide", "label": "宽幅" },
            { "value": "full", "label": "全宽" }
          ]
        }
      ]
    },
    {
      "type": "reviews",
      "name": "评价列表（固定评论区）",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "标题（可选）" },
        { "type": "text", "id": "aria_label", "label": "无障碍名称", "default": "Customer review list" },
        { "type": "text", "id": "review_count", "label": "列表评价总数", "default": "2625" },
        { "type": "checkbox", "id": "append_to_existing", "label": "新增评论追加到现有评价区", "default": true, "info": "开启后，客户评论块会加入现有评论卡片集合，不会替换原有布局。" },
        { "type": "checkbox", "id": "show_write", "label": "显示写评价区域", "default": true },
        { "type": "text", "id": "write_heading", "label": "写评价标题", "default": "Write a review" },
        { "type": "url", "id": "contact_url", "label": "写评价链接" }
      ]
    },
    {
      "type": "review",
      "name": "添加评论（显示在评价列表）",
      "settings": [
        { "type": "checkbox", "id": "enabled", "label": "显示此评论", "default": true },
        { "type": "text", "id": "reviewer", "label": "客户姓名" },
        { "type": "text", "id": "review_date", "label": "评论日期", "info": "建议使用 YYYY-MM-DD 格式，方便按日期排序。" },
        { "type": "range", "id": "rating", "label": "星级", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "评论标题（可选）" },
        { "type": "textarea", "id": "body", "label": "评论正文（必填）", "info": "填写并保存后，这条评论会显示在现有评价列表中。" },
        { "type": "product", "id": "product", "label": "关联产品（可选）" },
        { "type": "text", "id": "product_name", "label": "关联产品名称（未选择产品时使用）" },
        { "type": "checkbox", "id": "verified", "label": "显示已验证买家", "default": true },
        { "type": "text", "id": "verified_label", "label": "已验证买家文案", "default": "Verified Buyer" },
        { "type": "text", "id": "country", "label": "国家或地区" },
        { "type": "image_picker", "id": "image_1", "label": "评论图片 1" },
        { "type": "image_picker", "id": "image_2", "label": "评论图片 2" },
        { "type": "image_picker", "id": "image_3", "label": "评论图片 3" },
        { "type": "text", "id": "image_1_url", "label": "评论图片 1 外链（可选）" },
        { "type": "text", "id": "image_2_url", "label": "评论图片 2 外链（可选）" },
        { "type": "text", "id": "image_3_url", "label": "评论图片 3 外链（可选）" },
        { "type": "range", "id": "helpful_count", "label": "初始有帮助数", "min": 0, "max": 100, "step": 1, "default": 0 }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "评价页面",
      "blocks": [
        { "type": "heading" },
        { "type": "hero" },
        { "type": "summary" },
        { "type": "reviews" }
      ]
    }
  ]
}
{% endschema %}
