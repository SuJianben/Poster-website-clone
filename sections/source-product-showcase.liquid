{{ 'source-product-followup.css' | asset_url | stylesheet_tag }}

{% liquid
  assign fallback_image = 'https://dotcomcanvas.de/cdn/shop/files/Frame_12.jpg?v=1774259481&width=3171'
%}

<section class="spf-showcase" aria-label="Save Water canvas in an interior">
  <div class="spf-showcase__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image
        | image_url: width: 3200
        | image_tag:
          widths: '400, 600, 800, 1000, 1200, 1600, 2000, 2400, 2800, 3200',
          sizes: '100vw',
          loading: 'lazy',
          alt: section.settings.image.alt | default: 'DOTCOMCANVAS®'
      }}
    {% else %}
      <img
        src="{{ fallback_image }}"
        srcset="
          https://dotcomcanvas.de/cdn/shop/files/Frame_12.jpg?v=1774259481&width=400 400w,
          https://dotcomcanvas.de/cdn/shop/files/Frame_12.jpg?v=1774259481&width=800 800w,
          https://dotcomcanvas.de/cdn/shop/files/Frame_12.jpg?v=1774259481&width=1200 1200w,
          https://dotcomcanvas.de/cdn/shop/files/Frame_12.jpg?v=1774259481&width=1600 1600w,
          https://dotcomcanvas.de/cdn/shop/files/Frame_12.jpg?v=1774259481&width=2000 2000w,
          https://dotcomcanvas.de/cdn/shop/files/Frame_12.jpg?v=1774259481&width=2400 2400w,
          https://dotcomcanvas.de/cdn/shop/files/Frame_12.jpg?v=1774259481&width=3000 3000w
        "
        sizes="100vw"
        width="3171"
        height="1345"
        loading="lazy"
        alt="DOTCOMCANVAS®"
      >
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Source product showcase",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Showcase image"
    }
  ],
  "presets": [
    {
      "name": "Source product showcase"
    }
  ]
}
{% endschema %}
