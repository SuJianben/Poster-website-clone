{{ 'source-product-followup.css' | asset_url | stylesheet_tag }}

{% assign showcase_image = section.settings.image | default: product.featured_image %}

<section class="spf-showcase" aria-label="Kunstwerk im Wohnraum">
  <div class="spf-showcase__media">
    {% if showcase_image != blank %}
      {{ showcase_image
        | image_url: width: 3200
        | image_tag:
          widths: '400, 600, 800, 1000, 1200, 1600, 2000, 2400, 2800, 3200',
          sizes: '100vw',
          loading: 'lazy',
          alt: showcase_image.alt | default: product.title
      }}
    {% elsif request.design_mode %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "商品场景展示",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "展示图片"
    }
  ],
  "presets": [
    {
      "name": "商品场景展示"
    }
  ]
}
{% endschema %}
