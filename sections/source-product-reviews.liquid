{{ 'source-product-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'source-product-reviews.js' | asset_url }}" defer="defer"></script>

<section class="sprv" data-sprv-root data-section-id="{{ section.id }}" aria-labelledby="sprv-heading-{{ section.id }}">
  <div class="sprv__heading-wrap">
    <h2 id="sprv-heading-{{ section.id }}" class="sprv__heading">{{ section.settings.heading }}</h2>
  </div>

  <div class="sprv__widget">
    <div class="sprv__inner">
      <div class="sprv__summary">
        <div class="sprv__score">
          <div><strong>4.9</strong> <span class="sprv__stars" aria-label="4.9 out of 5 stars">★★★★★</span></div>
          <p>Based on {{ section.settings.review_count }} Reviews</p>
        </div>

        <div class="sprv__ratings" aria-label="Rating distribution">
          {%- assign rating_counts = '2461,157,5,0,1' | split: ',' -%}
          {%- assign rating_widths = '94,6,1,0,1' | split: ',' -%}
          {%- for count in rating_counts -%}
            <div class="sprv__rating-row">
              <span class="sprv__rating-stars">★★★★★</span>
              <span class="sprv__rating-bar"><i style="width: {{ rating_widths[forloop.index0] }}%"></i></span>
              <span>({{ count }})</span>
            </div>
          {%- endfor -%}
        </div>

        <div class="sprv__summary-photos" aria-label="Customer photos">
          {%- assign summary_photos = 'https://cdn.stamped.io/uploads/videos/a8e34717bc9fe2f9f83292b1af39b519.jpg|https://cdn.stamped.io/uploads/videos/6cab27b9e5a6e8abf7376643397e3aaf.jpg|https://cdn.stamped.io/uploads/videos/8c7e5f380f1f3173c8dd30029278b25a.jpg|https://cdn.stamped.io/uploads/videos/21a4e1daec458d792212652c1cf5085a.jpg|https://cdn.stamped.io/uploads/videos/8d136012af53db6d82ac7069af53cca7.jpg|https://cdn.stamped.io/uploads/videos/256ca76b86bd47423f1e89aa58eb9d08.jpg|https://cdn.stamped.io/uploads/videos/bef1f5c940fc5baa3a4fcc3ccd787683.jpg|https://cdn.stamped.io/uploads/videos/f57c1dc2ad9757b42d490e4bd7e96398.jpg' | split: '|' -%}
          {%- for photo in summary_photos -%}
            <button class="sprv__summary-photo" type="button" data-sprv-photo="{{ photo }}" aria-label="Open customer photo {{ forloop.index }}">
              <img src="{{ photo }}" alt="Customer wall art photo" width="68" height="55" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="sprv__toolbar">
        <div class="sprv__tab" aria-current="page">Reviews <span>{{ section.settings.review_count }}</span></div>
        <div class="sprv__filter" data-sprv-filter>
          <button type="button" aria-expanded="false" data-sprv-filter-button>With Photos <span aria-hidden="true">⌄</span></button>
          <div class="sprv__filter-menu" hidden data-sprv-filter-menu>
            <button type="button" data-value="photos">With Photos</button>
            <button type="button" data-value="all">All Reviews</button>
          </div>
        </div>
      </div>

      <div class="sprv__cards" data-sprv-cards>
        {%- for index in (1..4) -%}
          {% render 'source-product-review-card', index: index %}
        {%- endfor -%}
      </div>

      <nav class="sprv__pagination" aria-label="Reviews pagination">
        <button type="button" data-sprv-page="previous" aria-label="Previous page">&lt;</button>
        {%- for page_number in (1..10) -%}
          <button type="button" data-sprv-page="{{ page_number }}"{% if page_number == 1 %} class="is-active" aria-current="page"{% endif %}>{{ page_number }}</button>
        {%- endfor -%}
        <button type="button" data-sprv-page="next" aria-label="Next page">&gt;</button>
      </nav>

      <div class="sprv__write">
        <h3>{{ section.settings.write_heading }}</h3>
        <p>We would appreciate feedback via the <a href="{{ section.settings.contact_url }}">contact form</a><br>or look forward to an official review after placing an order!</p>
        <a class="sprv__write-button" href="{{ section.settings.contact_url }}" data-sprv-write>Write A Review <span aria-hidden="true">›</span></a>
      </div>
    </div>
  </div>

  <dialog class="sprv__lightbox" data-sprv-lightbox aria-label="Customer photo preview">
    <button class="sprv__lightbox-close" type="button" data-sprv-lightbox-close aria-label="Close preview">×</button>
    <img data-sprv-lightbox-image alt="Customer wall art photo preview">
  </dialog>
</section>

{% schema %}
{
  "name": "Source product reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Over 60,000 satisfied customers" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "2624" },
    { "type": "text", "id": "write_heading", "label": "Write review heading", "default": "Write a review" },
    { "type": "url", "id": "contact_url", "label": "Write review link" }
  ],
  "presets": [{ "name": "Source product reviews" }]
}
{% endschema %}
