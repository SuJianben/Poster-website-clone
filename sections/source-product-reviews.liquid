{{ 'source-product-reviews.css' | asset_url | stylesheet_tag }}
{{ 'source-reviews-summary.css' | asset_url | stylesheet_tag }}
<script src="{{ 'source-product-reviews.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'source-reviews-summary.js' | asset_url }}" defer="defer"></script>

<section class="sprv" data-sprv-root data-section-id="{{ section.id }}" aria-labelledby="sprv-heading-{{ section.id }}">
  <div class="sprv__heading-wrap">
    <h2 id="sprv-heading-{{ section.id }}" class="sprv__heading">{{ section.settings.heading }}</h2>
  </div>

  <div class="sprv__widget">
    <div class="sprv__inner">
      {% if section.blocks.size > 0 %}
        <div class="sprv__app-blocks">
          {% for block in section.blocks %}
            {% if block.type == '@app' %}<div class="sprv__app-block" {{ block.shopify_attributes }}>{% render block %}</div>{% endif %}
          {% endfor %}
        </div>
      {% else %}
        {% render 'source-reviews-summary', variant: 'product', review_count: section.settings.review_count, write_heading: section.settings.write_heading, contact_url: section.settings.contact_url %}

        {% assign review_write_url = section.settings.contact_url | default: '/pages/write-a-review' %}
        {% render 'source-product-reviews-list',
          review_count: section.settings.review_count,
          show_write: true,
          write_heading: section.settings.write_heading,
          contact_url: review_write_url
        %}
      {% endif %}
    </div>
  </div>

</section>

{% schema %}
{
  "name": "商品评价",
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "Über 60.000 zufriedene Kunden" },
    { "type": "text", "id": "review_count", "label": "评价数量", "default": "2626" },
    { "type": "text", "id": "write_heading", "label": "写评价标题", "default": "Write a review" },
    { "type": "url", "id": "contact_url", "label": "写评价链接" }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "商品评价" }]
}
{% endschema %}

