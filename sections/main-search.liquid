<section class="section"><div class="page-width"><h1>{{ 'general.search' | t }}</h1><form action="{{ routes.search_url }}" method="get" role="search"><input name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search' | t }}"><button class="button">{{ 'general.search' | t }}</button></form>{% if search.performed %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}</div>{% endif %}</div></section>
{% schema %}{"name":"Main search","settings":[]}{% endschema %}
