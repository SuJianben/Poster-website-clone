{% paginate collection.products by 24 %}<section class="section"><div class="page-width"><p class="eyebrow">Collection</p><div class="collection-heading"><div><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div>{{ collection.description }}</div>{% endif %}</div><form><label class="visually-hidden" for="CollectionSort">Sort</label><select id="CollectionSort" name="sort_by" onchange="this.form.submit()">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select></form></div><div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>No products are available in this collection yet.</p>{% endfor %}</div>{% if paginate.pages > 1 %}{{ paginate | default_pagination }}{% endif %}</div></section>{% endpaginate %}
{% schema %}{"name":"Main collection","settings":[]}{% endschema %}
