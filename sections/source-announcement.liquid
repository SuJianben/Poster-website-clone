{% if section.settings.enabled %}
  {% render 'source-announcement-1' %}
  {% if section.settings.heading != blank or section.settings.review_count != blank or section.blocks.size > 0 %}
    <script type="application/json" data-source-announcement-overrides>
      {
        "heading": {{ section.settings.heading | json }},
        "reviewCount": {{ section.settings.review_count | json }},
        "reviews": [
          {% for block in section.blocks %}
            {% assign product = block.settings.product %}
            {
              "index": {{ forloop.index0 }},
              "date": {{ block.settings.date | json }},
              "rating": {{ block.settings.rating | json }},
              "title": {{ block.settings.title | json }},
              "message": {{ block.settings.message | json }},
              "author": {{ block.settings.author | json }},
              "link": {{ block.settings.link | json }},
              "product": {% if product != blank %}{
                "url": {{ product.url | json }},
                "title": {{ product.title | json }},
                "image": {% if block.settings.product_image != blank %}{{ block.settings.product_image | image_url: width: 160 | json }}{% elsif product.featured_image != blank %}{{ product.featured_image | image_url: width: 160 | json }}{% else %}null{% endif %}
              }{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }
    </script>
  {% endif %}
{% endif %}
{% schema %}
{
  "name": "Announcement",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show section", "default": true },
    { "type": "text", "id": "heading", "label": "Heading override" },
    { "type": "text", "id": "review_count", "label": "Review count override" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Source review override",
      "settings": [
        { "type": "paragraph", "content": "Blocks override source review cards from 1 to 6 in their current order. Leave a field blank to retain the original source content." },
        { "type": "text", "id": "date", "label": "Review date" },
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Review title" },
        { "type": "textarea", "id": "message", "label": "Review text" },
        { "type": "text", "id": "author", "label": "Customer name" },
        { "type": "product", "id": "product", "label": "Related product" },
        { "type": "image_picker", "id": "product_image", "label": "Review product image override" },
        { "type": "url", "id": "link", "label": "Review link override" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Announcement" }]
}
{% endschema %}
