{{ 'source-cart-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'source-cart-page.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign recommendation_collection = section.settings.recommendation_collection | default: collections.all
  assign cart_quantity = cart.item_count
  assign next_discount_count = 3
  assign next_discount_percent = 15
  if cart_quantity >= 3
    assign next_discount_count = 4
    assign next_discount_percent = 20
  endif
  if cart_quantity >= 4
    assign next_discount_count = 5
    assign next_discount_percent = 25
  endif
-%}

<section class="scc-cart" data-scc-cart data-cart-count="{{ cart.item_count }}" data-section-id="{{ section.id }}">
  <div class="scc-cart__wrap">
    <nav class="scc-cart__crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Start</a><span>Dein Warenkorb</span></nav>

    <section class="scc-cart__discount-track" aria-label="Mengenrabatt">
      <p data-scc-tier-copy>{% if cart_quantity >= 5 %}Du hast dir 25% Rabatt 🏷️ gesichert.{% else %}Kaufen Sie {{ next_discount_count | minus: cart_quantity }} weitere Artikel, um {{ next_discount_percent }}% Rabatt 🏷️ zu erhalten.{% endif %}</p>
      <ol data-scc-tiers>
        {% assign discounts = '15|20|25' | split: '|' %}
        {% assign quantities = '3|4|5' | split: '|' %}
        {% for discount in discounts %}
          {% assign quantity = quantities[forloop.index0] | plus: 0 %}
          <li data-scc-tier="{{ quantity }}"{% if cart_quantity >= quantity %} class="is-reached"{% endif %}><span>{{ discount }}% Rabatt 🏷️</span><i aria-hidden="true">{% if cart_quantity >= quantity %}✓{% else %}✦{% endif %}</i><b>{{ quantity }} Artikel kaufen</b></li>
        {% endfor %}
      </ol>
    </section>

    <h1 class="scc-cart__title">Ihr Warenkorb <span>({{ cart.item_count }})</span></h1>

    {% if cart.item_count == 0 %}
      <div class="scc-cart__empty"><h2>Ihr Warenkorb ist derzeit leer.</h2><a href="{{ routes.all_products_collection_url }}">Weiter einkaufen <span>→</span></a></div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" class="scc-cart__form" data-scc-form>
        <div class="scc-cart__layout">
          <div class="scc-cart__items" data-scc-items>
            {% for item in cart.items %}
              <article class="scc-cart__item" data-scc-item data-line-key="{{ item.key }}" data-quantity="{{ item.quantity }}">
                <button class="scc-cart__remove" type="button" data-scc-remove aria-label="{{ item.title | escape }} entfernen">×</button>
                <a class="scc-cart__image" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '180, 360', alt: item.title }}{% endif %}</a>
                <div class="scc-cart__item-main">
                  <a class="scc-cart__product-title" href="{{ item.url }}">{{ item.product.title }}</a>
                  {% unless item.product.has_only_default_variant %}<p>{{ item.variant.title }}</p>{% endunless %}
                  <div class="scc-cart__quantity" aria-label="Menge für {{ item.title | escape }}"><button type="button" data-scc-quantity="-1" aria-label="Menge verringern">−</button><input name="updates[]" value="{{ item.quantity }}" inputmode="numeric" aria-label="Menge" data-scc-quantity-input><button type="button" data-scc-quantity="1" aria-label="Menge erhöhen">+</button></div>
                </div>
                <div class="scc-cart__item-price">
                  {% if item.line_level_discount_allocations.size > 0 %}<p class="scc-cart__discount-label">◇ {% for discount in item.line_level_discount_allocations %}{{ discount.discount_application.title }}{% unless forloop.last %}, {% endunless %}{% endfor %}</p>{% endif %}
                  <strong>{{ item.final_line_price | money }}</strong>{% if item.original_line_price > item.final_line_price %}<s>{{ item.original_line_price | money }}</s>{% endif %}
                </div>
              </article>
            {% endfor %}
          </div>
          <aside class="scc-cart__summary">
            <div class="scc-cart__shipping"><strong>{% if cart.total_price >= 4900 %}Du hast Anspruch auf kostenlosen Versand.{% else %}Noch {{ 4900 | minus: cart.total_price | money }} bis zum kostenlosen Versand.{% endif %}</strong><span><i style="width:{% if cart.total_price >= 4900 %}100{% else %}{{ cart.total_price | times: 100 | divided_by: 4900 }}{% endif %}%"></i></span></div>
            <div class="scc-cart__subtotal"><strong>Zwischensumme</strong><b>{{ cart.total_price | money }}</b></div>
            <p>Steuer inbegriffen. <a href="{{ routes.cart_url }}">Versand</a> und Rabatte werden im nächsten Schritt berechnet.</p>
            <button class="scc-cart__checkout" type="submit" name="checkout">Sicher Zur Kasse <span>›</span></button>
            {% if additional_checkout_buttons %}<div class="scc-cart__express">{{ content_for_additional_checkout_buttons }}</div>{% endif %}
          </aside>
        </div>
      </form>
    {% endif %}

    {% if recommendation_collection.products_count > 0 %}
      <section class="scc-cart__recommendations" aria-label="Empfohlene Produkte">
        <div class="scc-cart__recommendation-track" data-scc-recommendation-track>
          {% for product in recommendation_collection.products limit: 3 %}
            <a class="scc-cart__recommendation" href="{{ product.url }}">
              <span class="scc-cart__recommendation-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', alt: product.title }}{% endif %}</span>
              {% if forloop.index == 1 %}<em>TRENDING</em>{% elsif forloop.index == 2 %}<em>PERSONALISIERBAR</em>{% elsif product.compare_at_price > product.price %}<em>-{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%</em>{% endif %}
              <small>{{ product.vendor | default: 'ATELIER EXCLUSIVE' }}</small><strong>{{ product.title }}</strong><b>Ab {{ product.price | money }}</b>
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}
  </div>
</section>

{% schema %}
{"name":"Source cart page","settings":[{"type":"collection","id":"recommendation_collection","label":"Recommendation collection"}]}
{% endschema %}

