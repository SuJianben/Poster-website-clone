{{ 'source-home-reveal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'source-home-reveal.js' | asset_url }}" defer="defer"></script>

{% if section.settings.enabled %}
{% render 'source-hero-1', section: section %}
{% endif %}
{% schema %}
{
  "name": "商品主视觉",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "显示模块", "default": true },
    { "type": "image_picker", "id": "desktop_image", "label": "桌面端图片" },
    { "type": "video", "id": "desktop_video", "label": "桌面端视频", "info": "设置后在桌面端优先播放视频。" },
    { "type": "image_picker", "id": "mobile_image", "label": "移动端图片" },
    { "type": "video", "id": "mobile_video", "label": "移动端视频", "info": "设置后在移动端优先播放视频；未设置时使用移动端图片。" },
    { "type": "url", "id": "link", "label": "主视觉链接" },
    { "type": "text", "id": "link_label", "label": "主视觉链接文字" },
    { "type": "product", "id": "product", "label": "推荐商品" },
    { "type": "text", "id": "primary_badge", "label": "商品标签一", "default": "Trending" },
    { "type": "text", "id": "secondary_badge", "label": "商品标签二", "default": "Limited Edition" },
    { "type": "text", "id": "price_prefix", "label": "价格前缀", "default": "Ab" }
  ],
  "presets": [{ "name": "商品主视觉" }]
}
{% endschema %}
