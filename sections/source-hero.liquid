{% if section.settings.enabled %}
{% render 'source-hero-1', section: section %}
{% endif %}
{% schema %}
{
  "name": "Hero with product",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show section", "default": true },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "url", "id": "link", "label": "Hero link" },
    { "type": "text", "id": "link_label", "label": "Hero link label" },
    { "type": "product", "id": "product", "label": "Featured product" },
    { "type": "text", "id": "primary_badge", "label": "First product badge", "default": "Trending" },
    { "type": "text", "id": "secondary_badge", "label": "Second product badge", "default": "Limited Edition" },
    { "type": "text", "id": "price_prefix", "label": "Price prefix", "default": "Ab" }
  ],
  "presets": [{ "name": "Hero with product" }]
}
{% endschema %}
