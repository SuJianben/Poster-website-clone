{% liquid
  assign recommendation_limit = section.settings.products_to_show | default: 10
  assign recommendation_heading = section.settings.heading | default: 'Recommendations for you'
  assign recommendation_url = ''
  if product != blank
    assign recommendation_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: recommendation_limit | append: '&intent=related'
  endif
  assign recommendations_ready = false
  if recommendations.performed? and recommendations.products_count > 0
    assign recommendations_ready = true
  endif
%}

{{ 'source-product-recommendations.css' | asset_url | stylesheet_tag }}
<script src="{{ 'source-product-recommendations.js' | asset_url }}" defer="defer"></script>

<section
  class="spr-recs"
  data-spr-recommendations
  {% if product != blank %}data-spr-url="{{ recommendation_url }}"{% endif %}
  data-spr-state="{% if recommendations_ready %}ready{% else %}loading{% endif %}"
  data-spr-design-mode="{{ request.design_mode }}"
  data-section-id="{{ section.id }}"
  aria-labelledby="spr-recs-heading-{{ section.id }}"
>
  <div class="spr-recs__divider" aria-hidden="true"></div>

  <div class="spr-recs__inner">
    <h2 id="spr-recs-heading-{{ section.id }}" class="spr-recs__heading" data-spr-heading>
      {{ recommendation_heading | escape }}
    </h2>

    <div class="spr-recs__slider">
      <div class="spr-recs__viewport" data-spr-viewport tabindex="0" aria-label="{{ recommendation_heading | escape }}">
        <div class="spr-recs__track" data-spr-track>
          {% if recommendations_ready %}
            {% for recommendation_product in recommendations.products limit: recommendation_limit %}
              <div class="spr-recs__slide" data-spr-slide>
                {% render 'source-product-recommendation-card', product: recommendation_product, position: forloop.index %}
              </div>
            {% endfor %}
          {% elsif request.design_mode %}
            <div class="spr-recs__empty" data-spr-empty>
              Shopify 将根据当前商品自动填充相关产品
            </div>
          {% endif %}
        </div>
      </div>

      <div class="spr-recs__controls" aria-label="Recommendation controls">
        <div class="spr-recs__progress" aria-hidden="true">
          <span class="spr-recs__progress-fill" data-spr-progress></span>
        </div>

        <button class="spr-recs__arrow spr-recs__arrow--prev" type="button" data-spr-prev aria-label="Previous products">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 16.25 6.25 10l6.25-6.25"></path></svg>
        </button>
        <button class="spr-recs__arrow spr-recs__arrow--next" type="button" data-spr-next aria-label="Next products">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 3.75 13.75 10 7.5 16.25"></path></svg>
        </button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "商品推荐",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Recommendations for you"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "推荐商品数量",
      "min": 4,
      "max": 10,
      "step": 1,
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "商品推荐"
    }
  ]
}
{% endschema %}
