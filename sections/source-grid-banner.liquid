{% if section.settings.enabled %}
  {% render 'source-grid-banner-configurable', section: section %}
{% endif %}
{% schema %}
{
  "name": "网格横幅",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "显示模块", "default": true },
    { "type": "text", "id": "heading", "label": "标题", "default": "Eindrücke und Inspiration der Community" },
    { "type": "text", "id": "button_label", "label": "按钮文字", "default": "Zu Allen Bewertungen" },
    { "type": "url", "id": "button_link", "label": "按钮链接" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "网格图片",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片" },
        { "type": "url", "id": "link", "label": "图片链接" },
        {
          "type": "select",
          "id": "column_span",
          "label": "桌面端列跨度",
          "default": "1",
          "options": [
            { "value": "1", "label": "1 列" },
            { "value": "2", "label": "2 列" }
          ]
        },
        {
          "type": "select",
          "id": "row_span",
          "label": "桌面端行跨度",
          "default": "1",
          "options": [
            { "value": "1", "label": "1 行" },
            { "value": "2", "label": "2 行" }
          ]
        }
      ]
    }
  ],
  "presets": [{ "name": "网格横幅" }]
}
{% endschema %}
