{% if section.settings.enabled %}
  {% if section.blocks.size > 0 %}
    {% render 'source-grid-banner-configurable', section: section %}
  {% else %}
    {% render 'source-grid-banner-1' %}
  {% endif %}
{% endif %}
{% schema %}
{
  "name": "Grid banner",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show section", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Eindrücke und Inspiration der Community" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Zu Allen Bewertungen" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Grid image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Image link" },
        {
          "type": "select",
          "id": "column_span",
          "label": "Desktop column span",
          "default": "1",
          "options": [
            { "value": "1", "label": "1 column" },
            { "value": "2", "label": "2 columns" }
          ]
        },
        {
          "type": "select",
          "id": "row_span",
          "label": "Desktop row span",
          "default": "1",
          "options": [
            { "value": "1", "label": "1 row" },
            { "value": "2", "label": "2 rows" }
          ]
        }
      ]
    }
  ],
  "presets": [{ "name": "Grid banner" }]
}
{% endschema %}
