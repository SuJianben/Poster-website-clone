{% if section.settings.enabled %}
  {% render 'source-gallery-configurable', section: section %}
{% endif %}
{% schema %}
{
  "name": "客户图库",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "显示模块", "default": true },
    { "type": "text", "id": "rating_text", "label": "评分文字", "default": "★★★★★ 2.500+ 5-Sterne Bewertungen" },
    { "type": "text", "id": "heading_highlight", "label": "标题高亮文字", "default": "Über 60.000" },
    { "type": "text", "id": "heading_suffix", "label": "标题后缀", "default": "glückliche Kunden" }
  ],
  "blocks": [
    {
      "type": "gallery_item",
      "name": "客户图片",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "客户图片" },
        { "type": "url", "id": "image_url", "label": "客户图片链接" },
        { "type": "image_picker", "id": "avatar", "label": "头像" },
        { "type": "url", "id": "avatar_url", "label": "头像链接" },
        { "type": "text", "id": "name", "label": "客户姓名" },
        { "type": "text", "id": "reference_name", "label": "客户显示名称" },
        { "type": "url", "id": "link", "label": "社交主页链接" }
      ]
    }
  ],
  "presets": [{ "name": "客户图库" }]
}
{% endschema %}
