{% if section.settings.enabled %}
  {% if section.blocks.size > 0 %}
    {% render 'source-gallery-configurable', section: section %}
  {% else %}
    {% render 'source-gallery-1' %}
  {% endif %}
{% endif %}
{% schema %}
{
  "name": "Customer gallery",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show section", "default": true },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "★★★★★ 2.500+ 5-Sterne Bewertungen" },
    { "type": "text", "id": "heading_highlight", "label": "Heading highlight", "default": "Über 60.000" },
    { "type": "text", "id": "heading_suffix", "label": "Heading suffix", "default": "glückliche Kunden" }
  ],
  "blocks": [
    {
      "type": "gallery_item",
      "name": "Customer image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Customer image" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar" },
        { "type": "text", "id": "name", "label": "Customer name" },
        { "type": "url", "id": "link", "label": "Instagram link" }
      ]
    }
  ],
  "presets": [{ "name": "Customer gallery" }]
}
{% endschema %}
