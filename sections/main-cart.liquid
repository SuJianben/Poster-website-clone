<section class="section"><div class="page-width narrow"><h1>{{ 'cart.title' | t }}</h1>{% if cart.item_count == 0 %}<p>{{ 'cart.empty' | t }}</p>{% else %}{% form 'cart', cart %}{% for item in cart.items %}<div class="cart-item"><a href="{{ item.url }}">{{ item.product.title | escape }}</a><span>{{ item.final_line_price | money }}</span><input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div>{% endfor %}<p class="cart-total">{{ 'cart.subtotal' | t }}: {{ cart.total_price | money }}</p><button class="button" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>{% endform %}{% endif %}</div></section>
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
