:root { --page-width: {{ settings.page_width }}px; --background: {{ settings.color_background }}; --text: {{ settings.color_text }}; --accent: {{ settings.color_accent }}; }
* { box-sizing: border-box; } body { margin: 0; background: var(--background); color: var(--text); font-family: Arial, Helvetica, sans-serif; line-height: 1.45; } a { color: inherit; text-decoration: none; } img { display: block; width: 100%; height: auto; } .page-width { width: min(calc(100% - 32px), var(--page-width)); margin: 0 auto; } .narrow { max-width: 720px; } .skip-link { position: absolute; left: -999px; } .skip-link:focus { left: 16px; top: 16px; z-index: 10; background: #fff; padding: 8px; } .announcement-bar { background: var(--text); color: #fff; padding: 9px 0; text-align: center; font-size: 13px; } .site-header { border-bottom: 1px solid rgba(23,23,23,.15); background: var(--background); } .site-header__inner { min-height: 76px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 18px; } .site-logo { font-size: 22px; font-weight: 800; letter-spacing: .05em; text-align: center; text-transform: uppercase; } .site-logo img { max-width: 200px; margin: auto; } .site-nav { display: flex; gap: 20px; font-size: 14px; } .site-header__actions { display: flex; gap: 14px; font-size: 14px; } .menu-toggle { display: none; } .icon-button { appearance: none; border: 0; background: transparent; color: inherit; padding: 6px; } .hero { min-height: min(720px, 78vh); background-color: #252525; background-image: linear-gradient(90deg, rgba(0,0,0,.58), rgba(0,0,0,.12)), var(--hero-image); background-position: center; background-size: cover; color: #fff; display: grid; align-items: end; } .hero__content { max-width: var(--page-width); padding-top: 120px; padding-bottom: 64px; } .hero h1 { max-width: 760px; margin: 0 0 18px; font-size: clamp(42px, 7vw, 88px); line-height: .98; } .hero__text { max-width: 480px; margin-bottom: 28px; font-size: 18px; } .eyebrow { margin: 0 0 10px; font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; } .button { display: inline-flex; justify-content: center; align-items: center; min-height: 46px; padding: 10px 20px; border: 1px solid var(--text); background: var(--text); color: #fff; cursor: pointer; font-size: 14px; font-weight: 700; } .hero .button { background: #fff; border-color: #fff; color: #171717; } .section { padding: 72px 0; } .section-heading { display: flex; justify-content: space-between; gap: 20px; align-items: end; margin-bottom: 28px; } h1, h2, h3 { line-height: 1.05; } h1, h2 { font-size: clamp(30px, 4vw, 52px); margin: 0; } .text-link { text-decoration: underline; font-size: 14px; }.product-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }.product-card__image { display: block; background: #e9e6df; aspect-ratio: .82; overflow: hidden; }.product-card__image img { height: 100%; object-fit: cover; }.product-card__details { padding: 12px 0; }.product-card h3 { margin: 0 0 5px; font-size: 15px; }.product-card p, .product-price { margin: 0; font-weight: 700; }.product-card--placeholder svg { width: 100%; height: 100%; }.product-page__grid { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(300px,.8fr); gap: 56px; }.product-page form { display: grid; gap: 12px; margin-top: 28px; }.product-page input, .main-search input, .cart-item input { min-height: 44px; padding: 10px; border: 1px solid rgba(23,23,23,.35); background: transparent; }.cart-item { display: grid; grid-template-columns: 1fr auto 90px; align-items: center; gap: 16px; padding: 16px 0; border-bottom: 1px solid rgba(23,23,23,.15); }.cart-total { font-size: 20px; font-weight: 700; }.site-footer { padding: 50px 0; background: var(--text); color: #fff; }.site-footer nav { display: flex; flex-wrap: wrap; gap: 16px; margin: 24px 0; }.site-footer p { margin: 0; color: rgba(255,255,255,.65); font-size: 13px; }
@media (max-width: 749px) { .page-width { width: min(calc(100% - 24px), var(--page-width)); }.site-header__inner { min-height: 64px; grid-template-columns: auto 1fr auto; gap: 8px; }.menu-toggle { display: block; font-size: 0; }.menu-toggle::before { content: '☰'; font-size: 20px; }.site-header__actions a:first-child { display: none; }.site-header__actions { font-size: 12px; }.site-nav { display: none; position: absolute; top: 64px; left: 0; right: 0; padding: 16px 12px; background: var(--background); border-bottom: 1px solid rgba(23,23,23,.15); z-index: 5; flex-direction: column; }.site-nav.is-open { display: flex; }.hero { min-height: 570px; }.hero__content { padding-bottom: 44px; }.section { padding: 48px 0; }.product-grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; }.product-page__grid { grid-template-columns: 1fr; gap: 28px; }.cart-item { grid-template-columns: 1fr 74px; }.cart-item input { grid-column: 1 / -1; }.section-heading { align-items: start; flex-direction: column; } }
