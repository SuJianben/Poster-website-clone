<!doctype html>
<html class="no-js cart-has-items source-content-pending" lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'source-document-head-1' %}
    {{ content_for_header }}
    {{ 'source-static-layout.css' | asset_url | stylesheet_tag }}
    {{ 'source-favorite-products.css' | asset_url | stylesheet_tag }}
    {{ 'source-reviews-carousel.css' | asset_url | stylesheet_tag }}
    {{ 'source-sticky-header.css' | asset_url | stylesheet_tag }}
    {{ 'source-header-mega-menu.css' | asset_url | stylesheet_tag }}
    {{ 'source-topbar-localization.css' | asset_url | stylesheet_tag }}
    {{ 'source-atelier-drawer.css' | asset_url | stylesheet_tag }}

    <style>
      html.source-content-pending .site-wrapper { visibility: hidden; }
    </style>
    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
      document.addEventListener('DOMContentLoaded', () => {
        requestAnimationFrame(() => {
          document.documentElement.classList.remove('source-content-pending');
        });
      }, { once: true });
    </script>
    <noscript><style>html.source-content-pending .site-wrapper { visibility: visible; }</style></noscript>

    <script src="{{ 'source-theme-editor.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'source-product-tabs.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'source-scrolling-gallery.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'source-favorite-products-content.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'source-favorite-products.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'source-reviews-carousel.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'source-announcement-content.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'source-sticky-header.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'source-header-mega-menu.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'source-topbar-config.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'source-topbar-localization.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'source-atelier-drawer.js' | asset_url }}" defer="defer"></script>
  </head>
  <body>
    <div class="site-wrapper">
      {% sections 'header-group' %}
      {{ content_for_layout }}
      {% sections 'footer-group' %}
      {% render 'source-global-overlays' %}
    </div>
    {% render 'source-atelier-drawer' %}
    <style id="source-badge-finish">
      /* Keep the page background continuous with the inverse footer. The
         footer custom-logo section can be shorter than the viewport, which
         otherwise exposes the body's default white background as a strip
         below the footer. */
      html,
      body,
      .site-wrapper {
        background-color: #000 !important;
      }

      /* Final badge styling is placed after all section markup so section-level
         inline styles cannot override the storefront presentation. */
      .f-badge--sale {
        border-radius: var(--pcard-radius, 1rem) !important;
        color: #000 !important;
        background: #09cda9f7 !important;
        background-color: #09cda9f7 !important;
        border-color: transparent !important;
        box-shadow: none !important;
      }
      .f-badge--trending {
        color: #fff !important;
        border: 0 !important;
        border-color: transparent !important;
        background: #000 !important;
        background-color: #000 !important;
        box-shadow: none !important;
        text-shadow: none !important;
      }
      .source-canvas-deals-section .highlight-text--thick-underline,
      .source-mobile-canvas-deals .highlight-text--thick-underline {
        --hl-style-color: 9, 205, 169, 0.97 !important;
      }
      /* Match the product-detail badge row to the homepage deal palette. */
      .spx-product__panel {
        border-top-color: #000 !important;
      }
      /* Reserve space below the border for the floating badge row so it never
         overlaps the reviews, title, or artist blocks beneath it. */
      .spx-product__panel-content {
        padding-top: 30px !important;
      }
      .spx-product__top-badge--sale {
        border-radius: var(--pcard-radius, 1rem) !important;
        color: #000 !important;
        background: #09cda9f7 !important;
        background-color: #09cda9f7 !important;
        border-color: transparent !important;
        box-shadow: none !important;
        text-shadow: none !important;
      }
      .spx-product__top-badge--trending {
        color: #fff !important;
        background: #000 !important;
        background-color: #000 !important;
        border: 0 !important;
        border-color: transparent !important;
        box-shadow: none !important;
        text-shadow: none !important;
      }
      /* Hide the brand/retailer banner on product details. */
      .spx-product__brands {
        display: none !important;
      }
      /* Four remaining manual frame choices fill the row evenly after Gold is removed. */
      .spx-product .spx-product__frame-options {
        gap: 8px !important;
        overflow-x: visible !important;
      }
      .spx-product .spx-product__frame-options .spx-product__frame-option {
        width: calc((100% - 24px) / 4) !important;
        min-width: 0 !important;
        flex: 0 0 calc((100% - 24px) / 4) !important;
      }
      @media (max-width: 767px) {
        .spx-product__panel-content {
          padding-top: 24px !important;
        }
        .spx-product .spx-product__frame-options {
          gap: 7px !important;
        }
        .spx-product .spx-product__frame-options .spx-product__frame-option {
          width: calc((100% - 21px) / 4) !important;
          min-width: 0 !important;
          flex-basis: calc((100% - 21px) / 4) !important;
        }
      }
    </style>
  </body>
</html>
