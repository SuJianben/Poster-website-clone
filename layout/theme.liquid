                .forEach((el) => {
                    if (el.textContent.includes('(+')) {
                        el.textContent = el.textContent.replace(/\(\+\s*.*?\)/g, '')
                            .trim();
                    }
                });

            td.querySelectorAll('.product-option')
                .forEach((el) => {
                    if (el.innerText.includes('SKU')) {
                        el.remove();
                    }
                });
        });
}
