    <script target="teeinblue">
      teeinblue = {
        ...(window.teeinblue || {}),
        formSelector: '.product-form > form[id*="product-form-template-"]',
        gallerySelector: '.product__media-wrapper',
      };

      document.addEventListener('teeinblue-event-after-cart-added', function () {
        document.dispatchEvent(
          new CustomEvent('cart:refresh', {
            detail: {
              open: true,
            },
          })
        );
        fetch('/cart.js')
          .then((res) => res.json())
          .then((cart) => {
            theme.pubsub.publish(theme.pubsub.PUB_SUB_EVENTS.cartUpdate, {
              source: 'teeinblue-event-after-cart-added',
              cart,
            });
          })
          .catch((e) => {});
      });
