{% assign product_form_id = 'product-form-' | append: section.id %}
{% assign has_trending = false %}
{% assign has_bestseller = false %}
{% assign has_limited = false %}
{% assign has_personalizable = false %}
{% assign atelier_label = blank %}
{% assign size_option = blank %}
{% assign rating_value = product.metafields.reviews.rating.value %}
{% assign rating_count = product.metafields.reviews.rating_count.value %}
{% assign rating_number = rating_value.rating | default: rating_value %}

{% for tag in product.tags %}
  {% assign normalized_tag = tag | downcase | strip %}
  {% if normalized_tag == 'trending' %}{% assign has_trending = true %}{% endif %}
  {% if normalized_tag == 'bestseller' or normalized_tag == 'best seller' %}{% assign has_bestseller = true %}{% endif %}
  {% if normalized_tag contains 'limited edition' or normalized_tag contains 'limited' %}{% assign has_limited = true %}{% endif %}
  {% if normalized_tag contains 'personal' or normalized_tag contains 'custom' %}{% assign has_personalizable = true %}{% endif %}
  {% if normalized_tag contains 'atelier' or normalized_tag contains 'exclusive' %}{% assign atelier_label = 'ATELIER EXCLUSIVE' %}{% endif %}
{% endfor %}

{% for option in product.options_with_values %}
  {% assign option_name = option.name | downcase %}
  {% if option_name contains 'size' or option_name contains 'storlek' or option_name contains 'größe' or option_name contains 'groesse' %}{% assign size_option = option %}{% endif %}
{% endfor %}

{% assign info_border_color = '#e8e8e8' %}
{% assign info_border_width = '1px' %}
{% if current_variant.compare_at_price > current_variant.price %}
  {% assign info_border_color = '#cc0033' %}
  {% assign info_border_width = '2px' %}
{% elsif has_bestseller or has_limited %}
  {% assign info_border_color = '#bf953f' %}
  {% assign info_border_width = '2px' %}
{% elsif has_personalizable %}
  {% assign info_border_color = '#000000' %}
  {% assign info_border_width = '2px' %}
{% endif %}

<div id="ProductInfo-{{ section.id }}" data-section="{{ section.id }}" data-url="{{ product.url }}" class="product__info-container sticky-element" data-source-product-purchase>
  <div class="product__info-box js-product-info-box{% if current_variant.compare_at_price > current_variant.price %} is-on-sale{% endif %}" data-base-color="{{ info_border_color }}" data-base-width="{{ info_border_width }}" style="--top-border-color: {{ info_border_color }}; --top-border-width: {{ info_border_width }};">
    <div class="inner-brands-banner">
      <img src="{{ 'source-bauhaus-logo.png' | asset_url }}" alt="Bauhaus" class="brands-banner__logo bauhaus-logo-large" width="78" height="16">
      <span class="brands-banner__comma">,</span>
      <img src="{{ 'source-xxxlutz-logo.png' | asset_url }}" alt="XXXLutz" class="brands-banner__logo xxxlutz-logo" width="70" height="13">
      <span class="brands-banner__text">und 60.000+ Kunden lieben unsere Premium Wandbilder.</span>
    </div>

    <div class="product__blocks accordion-parent">
      <div class="product__block product__block--badges product__badges">
        <div class="custom-top-badges">
          {% if has_trending %}<span class="f-badge f-badge--custom f-badge--trending">Trending</span>{% endif %}
          {% if has_personalizable %}<span class="f-badge f-badge--custom f-badge--personalisierbar">Personalizable</span>{% endif %}
          {% if has_bestseller %}<span class="f-badge f-badge--custom f-badge--bestseller">Bestseller</span>{% endif %}
          {% if has_limited %}<span class="f-badge f-badge--custom f-badge--limited-edition">Limited Edition</span>{% endif %}
        </div>
      </div>

      {% if rating_value != blank and rating_count != blank %}
        <div class="product__block product__block--reviews" aria-label="{{ rating_number }} out of 5 stars, {{ rating_count }} reviews">
          <span class="source-product-stars" aria-hidden="true">★★★★★</span>
          <span class="source-product-review-count">{{ rating_count }} Verified Reviews</span>
        </div>
      {% endif %}

      <div class="product__block product__block--title"><h1 class="product__title h2">{{ product.title }}</h1></div>

      <div class="product__block product__block--meta flex flex-wrap gap-x-3 gap-y-2 text-subtext">
        {% if product.vendor != blank %}
          <p class="product__meta product__vendor m-0"><span>K&uuml;nstler:</span> <a href="{{ routes.collections_url }}/{{ product.vendor | handleize }}" class="btn--link font-body-bolder text-body">{{ product.vendor }}</a></p>
        {% endif %}
        {% if atelier_label != blank %}<button type="button" class="atelier-badge js-open-atelier-drawer-card atelier-badge--silver">{{ atelier_label }} <span aria-hidden="true">›</span></button>{% endif %}
      </div>

      <div id="price-{{ section.id }}" class="product__block product__block--price" data-source-product-price>
        <span class="source-product-price" data-source-product-current-price>{{ current_variant.price | money }}</span>
        <s class="source-product-compare-price" data-source-product-compare-price{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}>{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | money }}{% endif %}</s>
        <p class="source-product-shipping">Kostenloser Versand.</p>
      </div>

      <div class="product__block product__block--variant_picker">
        <variant-selects id="variant-selects-{{ section.id }}" data-section="{{ section.id }}" data-url="{{ product.url }}" data-update-url="true" style="display:flex!important;flex-direction:column!important;">
          {% for option in product.options_with_values %}
            {% assign option_name = option.name | downcase %}
            {% assign is_size = false %}{% assign is_frame = false %}{% assign is_material = false %}{% assign is_version = false %}
            {% if option_name contains 'size' or option_name contains 'storlek' or option_name contains 'größe' or option_name contains 'groesse' %}{% assign is_size = true %}{% endif %}
            {% if option_name contains 'frame' or option_name contains 'rahmen' or option_name contains 'ram' %}{% assign is_frame = true %}{% endif %}
            {% if option_name contains 'material' %}{% assign is_material = true %}{% endif %}
            {% if option_name contains 'version' %}{% assign is_version = true %}{% endif %}

            <fieldset class="product-form__input product-form__input--button product-form__input--button-square{% if is_size %} source-size-options{% elsif is_frame %} source-frame-options{% elsif is_material %} source-material-options{% elsif is_version %} source-version-options{% endif %}" style="order:{% if is_material %}0{% elsif is_size %}1{% elsif is_frame %}2{% else %}5{% endif %}!important;" data-source-product-option data-option-index="{{ forloop.index0 }}">
              <legend class="block w-full p-0">
                <div class="form__label">
                  <div class="flex flex-wrap gap-2"><span class="font-body-bolder">{{ option.name }}:</span><span class="text-subtext" data-source-product-option-label>{{ option.selected_value }}</span></div>
                  {% if is_size %}
                    <span class="source-size-tools"><button type="button" class="size-guide-btn" data-source-product-size-guide><span aria-hidden="true">▤</span><span>GR&Ouml;SSENTABELLE</span></button><span class="unit-toggle" role="group" aria-label="Einheit"><button type="button" class="unit-btn active" data-unit="cm">CM</button><button type="button" class="unit-btn" data-unit="in">IN</button></span></span>
                  {% endif %}
                </div>
              </legend>

              {% for value in option.values %}
                {% capture option_input_id %}Option-{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}{% endcapture %}
                <input type="radio" id="{{ option_input_id }}" name="{{ option.name | escape }}-{{ option.position }}" value="{{ value | escape }}" form="{{ product_form_id }}" {% if value.selected or option.selected_value == value %}checked{% endif %} {% unless value.available %}class="disabled"{% endunless %} data-option-value-id="{{ value.id }}" data-section="{{ section.id }}" data-opt-pos="{{ option.position }}" data-opt-val="{{ value | escape }}" data-source-product-option-input data-cm-value="{{ value | escape }}">
                {% if is_frame %}
                  {% assign frame_value = value | downcase %}{% assign frame_image = 'source-frame-none.png' %}
                  {% if frame_value contains 'weiß' or frame_value contains 'weiss' or frame_value contains 'white' %}{% assign frame_image = 'source-frame-white.png' %}{% endif %}
                  {% if frame_value contains 'schwarz' or frame_value contains 'black' %}{% assign frame_image = 'source-frame-black.png' %}{% endif %}
                  {% if frame_value contains 'silber' or frame_value contains 'silver' %}{% assign frame_image = 'source-frame-silver.png' %}{% endif %}
                  {% if frame_value contains 'gold' %}{% assign frame_image = 'source-frame-gold.png' %}{% endif %}
                  <label for="{{ option_input_id }}" class="variant-label--with-image" data-tooltip><span class="tooltip">{{ value }}</span><img src="{{ frame_image | asset_url }}" alt="{{ value | escape }}" class="variant-frame-image" width="230" height="160"><span class="visually-hidden">{{ value }}</span></label>
                {% elsif is_version %}
                  {% assign swatch_color = value | downcase | replace: ' ', '' %}
                  <label for="{{ option_input_id }}" class="variant-label--color-swatch" data-tooltip><span class="tooltip">{{ value }}</span><span class="version-color-swatch" style="background: {{ swatch_color }};"></span><span class="visually-hidden">{{ value }}</span></label>
                {% elsif is_material %}
                  <label for="{{ option_input_id }}" class="material-swatch">{{ value }}</label>
                {% else %}
                  <label for="{{ option_input_id }}" class="variant-label--standard"><span data-source-unit-label>{{ value }}</span></label>
                {% endif %}
              {% endfor %}
            </fieldset>
          {% endfor %}
          <script type="application/json" data-selected-variant>{{ current_variant | json }}</script>
        </variant-selects>
      </div>

      {% if has_personalizable %}{% render 'source-product-personalization', product_form_id: product_form_id %}{% endif %}

      {% form 'product', product, id: product_form_id, is: 'product-form', class: 'product-form source-product-form main-product-form', data-type: 'add-to-cart-form' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" class="product-variant-id">
        <input type="hidden" name="product-id" value="{{ product.id }}">
        <div class="product__block product__block--buy_buttons product-form__buttons flex flex-wrap items-end gap-x-2 gap-y-4" id="QuantityForm-{{ section.id }}">
          <quantity-input class="source-product-quantity quantity" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}">
            <button class="quantity__button" type="button" name="minus"><span class="visually-hidden">Decrease quantity</span><span aria-hidden="true">−</span></button>
            <input id="Quantity-{{ section.id }}" class="quantity__input" type="number" name="quantity" value="1" min="1" data-min="1" step="1" data-cart-quantity="0" data-quantity-variant-id="{{ current_variant.id }}" inputmode="numeric" autocomplete="off" form="{{ product_form_id }}">
            <button class="quantity__button" type="button" name="plus"><span class="visually-hidden">Increase quantity</span><span aria-hidden="true">+</span></button>
          </quantity-input>
          <button id="ProductSubmitButton-{{ section.id }}" class="source-product-submit product-form__submit btn btn--primary" type="submit" name="add" {% unless current_variant.available %}disabled{% endunless %}><span class="btn__text">{% if current_variant.available %}In den Warenkorb{% else %}Ausverkauft{% endif %}</span></button>
        </div>
        <div class="product-form__error-message blocks-radius-md alert alert--error" role="alert" hidden></div>
      {% endform %}

      {% render 'source-product-volume-discount' %}
      {% render 'source-product-trust', has_personalizable: has_personalizable %}
      {% render 'source-product-payment-trust' %}
      {% render 'source-product-details', product: product, mobile_only: true %}
    </div>
  </div>
</div>

<dialog class="source-product-size-modal" data-source-product-size-modal aria-label="Size Guide"><div class="source-product-size-modal__content"><button type="button" data-source-product-size-close aria-label="Close">×</button><h2>Size Guide</h2>{% if size_option != blank %}<ul>{% for value in size_option.values %}<li>{{ value }}</li>{% endfor %}</ul>{% endif %}</div></dialog>
<script type="application/json" data-source-product-variants>{{ product.variants | json }}</script>
<script>
  (function () {
    function normalizeProductOptionOrder() {
      document.querySelectorAll('variant-selects').forEach(function (picker) {
        var fields = Array.prototype.slice.call(picker.querySelectorAll(':scope > fieldset'));
        fields.sort(function (a, b) {
          var order = function (el) {
            if (el.classList.contains('source-material-options')) return 0;
            if (el.classList.contains('source-size-options')) return 1;
            if (el.classList.contains('source-frame-options')) return 2;
            return 5;
          };
          return order(a) - order(b);
        });
        fields.forEach(function (field) { picker.appendChild(field); });
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', normalizeProductOptionOrder);
    else normalizeProductOptionOrder();
  })();
</script>
