{% assign product_form_id = 'product-form-' | append: section.id %}
{% assign has_trending = false %}
{% assign has_bestseller = false %}
{% assign has_limited = false %}
{% assign has_personalizable = false %}
{% assign atelier_label = blank %}
{% assign material_option = blank %}
{% assign frame_option = blank %}
{% assign size_option = blank %}

{% for tag in product.tags %}
  {% assign normalized_tag = tag | downcase | strip %}
  {% if normalized_tag == 'trending' %}{% assign has_trending = true %}{% endif %}
  {% if normalized_tag == 'bestseller' or normalized_tag == 'best seller' %}{% assign has_bestseller = true %}{% endif %}
  {% if normalized_tag contains 'limited edition' or normalized_tag contains 'limited' %}{% assign has_limited = true %}{% endif %}
  {% if normalized_tag contains 'personal' or normalized_tag contains 'custom' %}{% assign has_personalizable = true %}{% endif %}
  {% if normalized_tag contains 'atelier' or normalized_tag contains 'exclusive' %}{% assign atelier_label = 'ATELIER EXCLUSIVE' %}{% endif %}
{% endfor %}

{% for option in product.options_with_values %}
  {% assign option_name = option.name | downcase %}
  {% if option_name contains 'material' %}{% assign material_option = option %}{% endif %}
  {% if option_name contains 'frame' or option_name contains 'rahmen' %}{% assign frame_option = option %}{% endif %}
  {% if option_name contains 'size' or option_name contains 'größe' or option_name contains 'groesse' %}{% assign size_option = option %}{% endif %}
{% endfor %}

<div id="ProductInfo-{{ section.id }}" data-section="{{ section.id }}" data-url="{{ product.url }}" class="product__info-container sticky-element" data-source-product-purchase>
  <div class="product__info-box js-product-info-box{% if current_variant.compare_at_price > current_variant.price %} is-on-sale{% endif %}" style="--top-border-color: {% if has_personalizable %}#000000{% elsif current_variant.compare_at_price > current_variant.price %}#cc0033{% else %}#000000{% endif %}; --top-border-width: 2px;">
    <div class="inner-brands-banner">
      <img src="{{ 'source-bauhaus-logo.png' | asset_url }}" alt="Bauhaus" class="brands-banner__logo bauhaus-logo-large" width="78" height="16">
      <span class="brands-banner__comma">,</span>
      <img src="{{ 'source-xxxlutz-logo.png' | asset_url }}" alt="XXXLutz" class="brands-banner__logo xxxlutz-logo" width="70" height="13">
      <span class="brands-banner__text">und 60.000+ Kunden lieben unsere Premium Wandbilder.</span>
    </div>

    <div class="product__blocks accordion-parent">
      <div class="product__block product__block--badges product__badges">
        <div class="custom-top-badges">
          {% if has_trending %}<span class="f-badge f-badge--custom f-badge--trending">TRENDING</span>{% endif %}
          {% if has_bestseller %}<span class="f-badge f-badge--custom f-badge--bestseller">BESTSELLER</span>{% endif %}
          {% if has_limited %}<span class="f-badge f-badge--custom f-badge--limited-edition">LIMITED EDITION</span>{% endif %}
          {% if has_personalizable %}<span class="f-badge f-badge--custom f-badge--personalisierbar">PERSONALISIERBAR</span>{% endif %}
        </div>
      </div>

      <div class="product__block product__block--reviews">
        <span class="source-product-stars" aria-hidden="true">★★★★★</span>
        <span class="source-product-review-count">2.860 Verifizierte Bewertungen</span>
      </div>

      <div class="product__block product__block--title">
        <h1 class="product__title h2">{{ product.title }}</h1>
      </div>

      <div class="product__block product__block--meta flex flex-wrap gap-x-3 gap-y-2 text-subtext">
        {% if product.vendor != blank %}
          <p class="product__meta product__vendor m-0">
            <span>Künstler:</span>
            <a href="{{ routes.collections_url }}/{{ product.vendor | handleize }}" class="btn--link font-body-bolder text-body">{{ product.vendor }}</a>
          </p>
        {% endif %}
        {% if atelier_label != blank %}
          <button type="button" class="atelier-badge atelier-badge--silver">{{ atelier_label }} <span aria-hidden="true">›</span></button>
        {% endif %}
      </div>

      <div id="price-{{ section.id }}" class="product__block product__block--price" data-source-product-price>
        <span class="source-product-price" data-source-product-current-price>{{ current_variant.price | money }}</span>
        <s class="source-product-compare-price" data-source-product-compare-price{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}>{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | money }}{% endif %}</s>
        <p class="source-product-shipping">Kostenloser Versand.</p>
      </div>

      <variant-selects
        id="variant-selects-{{ section.id }}"
        data-section="{{ section.id }}"
        data-url="{{ product.url }}"
        data-update-url="true"
      >

        {% if material_option == blank %}
          <fieldset class="product-form__input product-form__input--button product-form__input--button-square source-material-options source-fallback-option">
            <legend class="block w-full p-0">
              <span class="form__label"><span><strong>Material:</strong> <span data-source-property-label>Leinwandbild</span></span></span>
            </legend>
            <input type="radio" id="FallbackMaterialCanvas-{{ section.id }}" name="properties[Material]" value="Leinwandbild" form="{{ product_form_id }}" checked data-source-property-input>
            <label class="material-swatch" for="FallbackMaterialCanvas-{{ section.id }}">Leinwandbild</label>
            <input type="radio" id="FallbackMaterialGold-{{ section.id }}" name="properties[Material]" value="Blattgoldbild" form="{{ product_form_id }}" data-source-property-input>
            <label class="material-swatch" for="FallbackMaterialGold-{{ section.id }}">Blattgoldbild</label>
          </fieldset>
        {% endif %}

        {% for option in product.options_with_values %}
          {% assign option_name = option.name | downcase %}
          {% assign is_size = false %}
          {% assign is_frame = false %}
          {% assign is_material = false %}
          {% if option_name contains 'size' or option_name contains 'größe' or option_name contains 'groesse' %}{% assign is_size = true %}{% endif %}
          {% if option_name contains 'frame' or option_name contains 'rahmen' %}{% assign is_frame = true %}{% endif %}
          {% if option_name contains 'material' %}{% assign is_material = true %}{% endif %}

          <fieldset class="product-form__input product-form__input--button product-form__input--button-square{% if is_size %} source-size-options{% elsif is_frame %} source-frame-options{% elsif is_material %} source-material-options{% endif %}" data-source-product-option data-option-index="{{ forloop.index0 }}">
            <legend class="block w-full p-0">
              <div class="form__label">
                <div class="flex flex-wrap gap-2">
                  <span class="font-body-bolder">{% if is_size %}Größe{% elsif is_frame %}Premium Rahmen{% else %}{{ option.name }}{% endif %}:</span>
                  <span class="text-subtext" data-source-product-option-label>{{ option.selected_value }}</span>
                </div>
                {% if is_size %}
                  <span class="source-size-tools">
                    <button type="button" class="size-guide-btn" data-source-product-size-guide aria-label="Größen Guide">▤ <span>SIZE GUIDE</span></button>
                    <span class="unit-toggle" role="group" aria-label="Maßeinheit"><button type="button" class="unit-btn active" data-unit="cm">CM</button><button type="button" class="unit-btn" data-unit="in">IN</button></span>
                  </span>
                {% endif %}
              </div>
            </legend>

            {% for value in option.values %}
              {% capture option_input_id %}Option-{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}{% endcapture %}
              <input
                type="radio"
                id="{{ option_input_id }}"
                name="{{ option.name | escape }}-{{ option.position }}"
                value="{{ value | escape }}"
                form="{{ product_form_id }}"
                {% if value.selected or option.selected_value == value %}checked{% endif %}
                {% unless value.available %}class="disabled"{% endunless %}
                data-option-value-id="{{ value.id }}"
                data-section="{{ section.id }}"
                data-opt-pos="{{ option.position }}"
                data-opt-val="{{ value | escape }}"
                data-source-product-option-input
                data-cm-value="{{ value | escape }}"
              >
              {% if is_frame %}
                {% assign frame_value = value | downcase %}
                {% assign frame_image = 'source-frame-none.png' %}
                {% if frame_value contains 'weiß' or frame_value contains 'weiss' or frame_value contains 'white' %}{% assign frame_image = 'source-frame-white.png' %}{% endif %}
                {% if frame_value contains 'schwarz' or frame_value contains 'black' %}{% assign frame_image = 'source-frame-black.png' %}{% endif %}
                {% if frame_value contains 'silber' or frame_value contains 'silver' %}{% assign frame_image = 'source-frame-silver.png' %}{% endif %}
                {% if frame_value contains 'gold' %}{% assign frame_image = 'source-frame-gold.png' %}{% endif %}
                <label for="{{ option_input_id }}" class="variant-label--with-image" data-tooltip>
                  <span class="tooltip">{{ value }}</span><img src="{{ frame_image | asset_url }}" alt="{{ value | escape }}" class="variant-frame-image" width="230" height="160"><span class="visually-hidden">{{ value }}</span>
                </label>
              {% elsif is_material %}
                <label for="{{ option_input_id }}" class="material-swatch">{{ value }}</label>
              {% else %}
                <label for="{{ option_input_id }}" class="variant-label--standard"><span data-source-unit-label>{{ value }}</span></label>
              {% endif %}
            {% endfor %}
          </fieldset>
        {% endfor %}

        <script type="application/json" data-selected-variant>{{ current_variant | json }}</script>
      </variant-selects>

        {% if frame_option == blank %}
          <fieldset class="product-form__input product-form__input--button product-form__input--button-square source-frame-options source-fallback-option">
            <legend class="block w-full p-0">
              <div class="form__label"><div class="flex flex-wrap gap-2"><span class="font-body-bolder">Premium Rahmen:</span><span class="text-subtext" data-source-property-label>Ohne Rahmen</span></div></div>
            </legend>
            {% assign fallback_frames = 'Ohne Rahmen,Weiß,Schwarz' | split: ',' %}
            {% for value in fallback_frames %}
              {% assign frame_image = 'source-frame-none.png' %}
              {% if value == 'Weiß' %}{% assign frame_image = 'source-frame-white.png' %}{% endif %}
              {% if value == 'Schwarz' %}{% assign frame_image = 'source-frame-black.png' %}{% endif %}
              <input type="radio" id="FallbackFrame-{{ section.id }}-{{ forloop.index0 }}" name="properties[Premium Frame]" value="{{ value }}" form="{{ product_form_id }}" {% if forloop.first %}checked{% endif %} data-source-property-input>
              <label for="FallbackFrame-{{ section.id }}-{{ forloop.index0 }}" class="variant-label--with-image" data-tooltip>
                <span class="tooltip">{{ value }}</span><img src="{{ frame_image | asset_url }}" alt="{{ value }}" class="variant-frame-image" width="230" height="160"><span class="visually-hidden">{{ value }}</span>
              </label>
            {% endfor %}
          </fieldset>
        {% endif %}

      {% form 'product', product, id: product_form_id, is: 'product-form', class: 'product-form source-product-form', data-type: 'add-to-cart-form' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" class="product-variant-id">
        <input type="hidden" name="product-id" value="{{ product.id }}">

        <div class="product__block product__block--buy_buttons">
          <quantity-input class="source-product-quantity quantity" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}">
            <button type="button" name="minus" aria-label="Decrease quantity"><span aria-hidden="true">−</span></button>
            <input class="quantity__input" type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity">
            <button type="button" name="plus" aria-label="Increase quantity"><span aria-hidden="true">+</span></button>
          </quantity-input>
          <button id="ProductSubmitButton-{{ section.id }}" class="source-product-submit product-form__submit btn btn--primary w-full" type="submit" name="add" {% unless current_variant.available %}disabled{% endunless %}>
            <span>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
          </button>
          <div class="product-form__error-message" role="alert" hidden></div>
        </div>
      {% endform %}

      <ul class="source-product-benefits" role="list">
        <li>Sofort aufhängbereit</li><li>Kostenloser Versand weltweit über 49 €</li><li>30 Tage Rückgaberecht</li>
      </ul>
    </div>
  </div>
</div>

<dialog class="source-product-size-modal" data-source-product-size-modal aria-label="Größen Guide">
  <div class="source-product-size-modal__content">
    <button type="button" data-source-product-size-close aria-label="Schließen">×</button>
    <h2>Größen Guide</h2>
    {% if size_option != blank %}<ul>{% for value in size_option.values %}<li>{{ value }}</li>{% endfor %}</ul>{% else %}<p>Bitte wähle die verfügbare Produktgröße aus.</p>{% endif %}
  </div>
</dialog>

<script type="application/json" data-source-product-variants>{{ product.variants | json }}</script>
