{% assign has_custom_items = false %}
{% if section.blocks.size > 0 %}{% assign has_custom_items = true %}{% endif %}

<div id="shopify-section-{{ section.id }}" class="shopify-section">
  <style data-shopify>
    #shopify-section-{{ section.id }} {
      --section-padding-top: 0px;
      --section-padding-bottom: 0px;
      --h-spacing: 70px;
      --h-spacing-mobile: 24px;
      --duration: 60s;
    }
    #shopify-section-{{ section.id }} .section--scrolling-promotion {
      border-style: solid;
      border-width: 0.1rem 0;
      border-color: rgba(var(--color-border), var(--color-border-alpha, 1));
    }
  </style>

  <div class="section section--padding section--scrolling-promotion color-scheme-a0866d1b-f387-47d7-b88f-b8f21d12ee75" data-section-index="2">
    <scrolling-promotion data-section-type="scrolling-promotion" data-section-id="{{ section.id }}" data-source-speed class="scrolling-promotion scrolling-promotion--left">
      <div class="promotion">
        {% if has_custom_items %}
          {% for block in section.blocks %}
            {% if block.type == 'image' and block.settings.image != blank %}
              <div class="promotion__item promotion__item-image" style="--image-height: {{ block.settings.image_height }}px; --image-height-mobile: {{ block.settings.mobile_image_height }}px;" {{ block.shopify_attributes }}>
                <a {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} aria-label="{{ block.settings.image.alt | default: 'Promotion' | escape }}" class="block promotion__item-wrap self-center hover-wrapper blocks-radius">
                  <div class="media-wrapper">{{ block.settings.image | image_url: width: 1100 | image_tag: alt: block.settings.image.alt, loading: 'lazy', class: 'motion-reduce', is: 'image-lazy' }}</div>
                </a>
              </div>
            {% elsif block.type == 'text' and block.settings.text != blank %}
              <div class="promotion__item promotion__item-text" style="--text-opacity: 1.0;" {{ block.shopify_attributes }}>
                <div class="block promotion__item-wrap self-center"><div class="promotion__text {{ block.settings.text_style }}">{{ block.settings.text }}</div></div>
              </div>
            {% endif %}
          {% endfor %}
        {% else %}
          <div class="promotion__item promotion__item-text" style="--text-opacity: 1.0;"><div class="block promotion__item-wrap self-center"><div class="promotion__text h4">Mehrfach ausgezeichnet:</div></div></div>
          <div class="promotion__item promotion__item-image" style="--image-height: 100px;--image-height-mobile: 50px;"><div aria-label="DOTCOMCANVAS®" class="block promotion__item-wrap self-center hover-wrapper blocks-radius"><div class="media-wrapper"><img src="https://cdn.shopify.com/s/files/1/1004/8690/5937/files/dcc-5111995a8c0d-Wachstumschampion_2024_Englisch-klein.png?v=1757412034&width=1100" alt="DOTCOMCANVAS®" width="1100" height="1100" loading="lazy" class="motion-reduce" is="image-lazy"></div></div></div>
          <div class="promotion__item promotion__item-image" style="--image-height: 60px;--image-height-mobile: 54px;"><div aria-label="DOTCOMCANVAS®" class="block promotion__item-wrap self-center hover-wrapper blocks-radius"><div class="media-wrapper"><img src="https://cdn.shopify.com/s/files/1/1004/8690/5937/files/dcc-5ffe61b2bf79-Statista-dotcomcanvas_c14ed8f4-3ef5-4a23-9a6e-de899544d82c.png?v=1760771551&width=1100" alt="DOTCOMCANVAS®" width="1100" height="290" loading="lazy" class="motion-reduce" is="image-lazy"></div></div></div>
          <div class="promotion__item promotion__item-image" style="--image-height: 80px;--image-height-mobile: 50px;"><div aria-label="DOTCOMCANVAS®" class="block promotion__item-wrap self-center hover-wrapper blocks-radius"><div class="media-wrapper"><img src="https://cdn.shopify.com/s/files/1/1004/8690/5937/files/dcc-6fdc26d656ea-GBA23_HO_SPECIAL_MC_RGB_18e95b9b-9ef8-41df-97a1-2c05ba00f96a.png?v=1757412001&width=1100" alt="DOTCOMCANVAS®" width="1100" height="634" loading="lazy" class="motion-reduce" is="image-lazy"></div></div></div>
          <div class="promotion__item promotion__item-text" style="--text-opacity: 1.0;"><div class="block promotion__item-wrap self-center"><div class="promotion__text h4">Unsere Vorteile:</div></div></div>
          {% assign fallback_texts = '📍 2018 Gegründet|📦 Kostenfreier Versand ab 49€|↩️ 30 Tage Probe-Hängen|20+ lizensierte Künstler|🖼️ 5000+ Kunstwerke|🖤 60.000+ Glückliche Kunden' | split: '|' %}
          {% for text in fallback_texts %}<div class="promotion__item promotion__item-text" style="--text-opacity: 1.0;"><div class="block promotion__item-wrap self-center"><div class="promotion__text h2">{{ text }}</div></div></div>{% endfor %}
        {% endif %}
      </div>
    </scrolling-promotion>
  </div>
</div>
