<div id="shopify-section-{{ section.id }}" class="shopify-section section-collection-list">
  <link href="https://cdn.shopify.com/s/files/1/1004/8690/5937/files/dcc-a1600fa13a89-section-collection-list.css?v=68985498160426086891780837125" rel="stylesheet" type="text/css" media="all">
  <style data-shopify>
    .section-{{ section.id }} { --section-padding-top: 20px; --section-padding-bottom: 40px; --f-columns-mobile: 2; --f-columns-md: 3; --f-columns-lg: 7; --f-columns-xl: 7; }
  </style>
  <div class="section section-{{ section.id }} section--padding collection-list color-scheme-1">
    <div class="section__container page-width page-width--full">
      <div class="section__wrapper">
        <div class="section__header s__header section__header--vertical spacing--normal rich-text rich-text--tight md:text-center text-center flex flex-col items-center md:items-center">
          <div class="section__header--text s__header--text rich-text rich-text--tight flex-1"><h2 class="section__heading rich-text__heading hd2"><motion-element class="block" data-motion="fade-up" data-motion-delay="50">{{ section.settings.heading_prefix }} <em is="highlight-text" class="highlight-text relative inline-block font-normal highlight-text--thick-underline animate" style="--hl-style-color: 230, 217, 197, 1.0;">{{ section.settings.heading_highlight }}</em></motion-element></h2></div>
        </div>
        <div class="section__content swiper-show-nav-on-hover relative">
          <div class="collection-list__container"><div class="collection-list__inner swipe-mobile swipe-mobile--2-cols" data-section-id="{{ section.id }}"><div class="collection-list__items f-grid f-grid--gap-small f-grid--row-gap-small swipe-mobile__inner">
            {% for block in section.blocks %}{% render 'source-collection-list-card', collection: block.settings.collection, image: block.settings.image, image_url: block.settings.image_url, label: block.settings.label, index: forloop.index0, attributes: block.shopify_attributes %}{% endfor %}
          </div></div></div>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  #shopify-section-{{ section.id }} .section__heading .highlight-text {
    position: relative;
    display: inline-block;
    isolation: isolate;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .section__heading .highlight-text::after {
    position: absolute;
    right: -2px;
    bottom: 4px;
    left: -2px;
    z-index: -1;
    height: 6px;
    background: rgba(var(--hl-style-color));
    content: "";
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--animation-long, .7s cubic-bezier(.3, 1, .3, 1));
  }

  #shopify-section-{{ section.id }} .section__heading .highlight-text.animate::after {
    transform: scaleX(1);
  }

  @media screen and (max-width: 767.98px) {
    #shopify-section-{{ section.id }} .collection-list__items {
      display: flex !important;
      flex-wrap: nowrap !important;
      grid-template-columns: none !important;
      gap: 12px !important;
      width: 100% !important;
    }

    #shopify-section-{{ section.id }} .collection-list__items > .f-column {
      display: block !important;
      box-sizing: border-box;
      flex: 0 0 calc((100% - 12px) / 2) !important;
      width: calc((100% - 12px) / 2) !important;
      max-width: calc((100% - 12px) / 2) !important;
    }

    #shopify-section-{{ section.id }} .collection-card {
      overflow: hidden;
      border-radius: 7px;
      background: #000;
    }

    #shopify-section-{{ section.id }} .collection-card__image {
      aspect-ratio: .92 / 1;
      background: #f4f4f4;
    }

    #shopify-section-{{ section.id }} .collection-card__image img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #shopify-section-{{ section.id }} .collection-card__inner {
      min-height: 78px;
      padding: 11px 12px;
      background: #000;
      color: #fff;
    }

    #shopify-section-{{ section.id }} .collection-card__title {
      font-size: 14px;
      font-weight: 700;
      line-height: 1.25;
    }

    #shopify-section-{{ section.id }} .collection-card__btn {
      width: 29px;
      min-width: 29px;
      height: 29px;
      min-height: 29px;
      padding: 0;
      border: 1px solid currentColor;
      background: transparent;
    }

    #shopify-section-{{ section.id }} .collection-card__btn svg {
      width: 14px;
      height: 14px;
    }
  }
</style>
