{% assign is_english = false %}
{% if request.locale.iso_code contains 'en' %}
  {% assign is_english = true %}
{% endif %}

<div class="atelier-drawer-wrapper" data-source-atelier-drawer>
  <button class="atelier-drawer-overlay" type="button" data-atelier-close aria-label="Close"></button>
  <aside class="atelier-drawer" aria-hidden="true" aria-labelledby="atelier-drawer-title" role="dialog">
    <div class="atelier-drawer__header">
      <span id="atelier-drawer-title" class="atelier-drawer__title" data-atelier-drawer-title>TRE OLIKA UTGÅVOR</span>
      <button class="atelier-drawer__close" type="button" data-atelier-close aria-label="Stäng">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <div class="atelier-drawer__content" data-atelier-drawer-content>
      <p class="drawer-intro" data-atelier-drawer-intro>Upptäck tre noggrant utvalda konstutgåvor – från lättillgängliga favoriter till sällsynta samlarverk.</p>
      <div class="drawer-section">
        <div class="drawer-separator">-----</div>
        <h4>BEGRÄNSAD UTGÅVA</h4>
        <p>Exklusiva konstverk som endast finns hos oss. Begränsad upplaga och eftertraktade motiv.</p>
      </div>
      <div class="drawer-section">
        <div class="drawer-separator">-----</div>
        <h4>ATELJÉ EXKLUSIV</h4>
        <p>En kollektion med exklusiva konstverk – unika motiv skapade särskilt för oss.</p>
      </div>
      <div class="drawer-section">
        <div class="drawer-separator">-----</div>
        <h4>BASUTBUD</h4>
        <p>Tidlösa favoriter och bästsäljare från konstnärer som skapar fritt och utan begränsningar.</p>
      </div>
    </div>
  </aside>
</div>
