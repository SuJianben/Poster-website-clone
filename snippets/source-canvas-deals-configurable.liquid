<div id="shopify-section-{{ section.id }}" class="shopify-section">
  <link href="https://cdn.shopify.com/s/files/1/1004/8690/5937/files/dcc-0cec7fa656f6-section-featured-collection.css?v=15356037298051793511780837133" rel="stylesheet" type="text/css" media="all">
  <style data-shopify>
    .section-{{ section.id }} { --section-padding-top: 28px; --section-padding-bottom: 40px; --f-columns-mobile: 2; --f-columns-lg: 4; --f-columns-md: 3; --f-columns-xl: 5; }
  </style>
  <div class="section section-{{ section.id }} featured-collection source-canvas-deals-section section--padding color-scheme-1" data-id="{{ section.id }}">
    <div class="section__container page-width page-width--full">
      <div class="section__wrapper" is="product-tabs" data-section-id="{{ section.id }}">
        <div class="section__header s__header rich-text rich-text--tight md:text-center text-center flex flex-col md:items-center">
          <div class="section__header--text s__header--text rich-text rich-text--tight flex-1">
            <h2 class="rich-text__heading inline-richtext hd2"><motion-element data-motion="fade-up" data-motion-delay="50" class="block">{{ section.settings.heading_prefix }} <em is="highlight-text" class="highlight-text relative inline-block font-normal highlight-text--thick-underline" style="--hl-style-color: 204, 45, 82, 1.0;">{{ section.settings.heading_highlight }}</em> {{ section.settings.heading_suffix }}</motion-element></h2>
            {% if section.settings.promotion_text != blank %}<motion-element class="rich-text__button block" data-motion="fade-up" data-motion-delay="100"><a class="btn btn--underline btn--with-icon" href="{{ section.settings.promotion_link }}"><span class="btn__text">{{ section.settings.promotion_text }}</span><span class="btn__icon order-last svg-icon svg-icon--caret-right icon--small icon--thick inline-flex"><svg class="icon icon-caret-right" viewBox="0 0 20 20" fill="none"><path d="M7.5 3.75L13.75 10L7.5 16.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a></motion-element>{% endif %}
          </div>
          <motion-element class="section__header--buttons flex-1 block" data-motion="fade-up" data-motion-delay="150"><div class="tabs-nav swipe-mobile swipe-mobile--auto-cols no-js-hidden"><div class="tabs-nav__inner flex flex-wrap md:justify-center swipe-mobile__inner" role="tablist">
            {% for block in section.blocks %}{% assign tab_label = block.settings.label | default: block.settings.collection.title %}<button class="tabs__btn focus-inset btn btn--underline{% if forloop.first %} active{% endif %}" role="tab" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>{{ tab_label }}</button>{% endfor %}
          </div></div></motion-element>
        </div>
        <div class="section__content tabs__panels">
          {% for block in section.blocks %}
            {% capture panel %}
              <div class="tabs__panel featured-collection__content" data-index="{{ forloop.index0 }}" data-id="{{ block.id }}">
                <featured-collection class="block relative swiper swiper-equal-height overflow-visible f-grid--gap-medium swipe-mobile swipe-mobile--2-cols" data-block-id="{{ block.id }}" data-enable-slider="true" data-items="5" data-tablet-items="3" data-laptop-items="4" data-pagination-type="progressbar" data-navigation-position="bottom" id="product-list-{{ block.id }}">
                  <div class="featured-collection__items products-list f-grid f-grid--gap-medium f-grid--row-gap-medium swiper-wrapper swipe-mobile__inner">
                    {% render 'source-product-shelf-promo-card', image: block.settings.promo_image, heading: block.settings.promo_heading, button_label: block.settings.promo_button_label, link: block.settings.promo_link, fallback_link: block.settings.collection.url %}
                    {% if block.settings.collection != blank %}{% for product in block.settings.collection.products limit: 12 %}{% render 'source-bestsellers-product-card', product: product %}{% endfor %}{% endif %}
                  </div>
                </featured-collection>
                <div class="swiper-controls swiper-controls--grouped swiper-controls--pagination-progressbar hidden md:flex"><button class="swiper-button swiper-button-prev btn" name="previous" aria-label="Nach links schieben"><span class="btn__text"><svg class="icon icon-caret-left rtl-flip-x icon--medium icon--thick" viewBox="0 0 20 20" fill="none"><path d="M12.5 16.25L6.25 10L12.5 3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></button><div class="swiper-pagination"></div><button class="swiper-button swiper-button-next btn" name="next" aria-label="Nach rechts schieben"><span class="btn__text"><svg class="icon icon-caret-right rtl-flip-x icon--medium icon--thick" viewBox="0 0 20 20" fill="none"><path d="M7.5 3.75L13.75 10L7.5 16.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></button></div>
                <scroll-progress-bar class="md:hidden" target="product-list-{{ block.id }}"><div class="progress-container"><div class="progress-bar no-empty"></div></div></scroll-progress-bar>
                {% if block.settings.collection != blank %}<div class="collection-action-bottom flex justify-end"><a class="btn btn--primary btn--with-icon" href="{{ block.settings.collection.url }}"><span class="btn__text">{{ section.settings.collection_label }}</span><span class="btn__icon order-last svg-icon svg-icon--arrow-right icon--small icon--thick inline-flex"><svg class="icon icon-arrow-right" viewBox="0 0 18 18" fill="none"><path d="M2.8125 9H15.1875" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M10.125 3.9375L15.1875 9L10.125 14.0625" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a></div>{% endif %}
              </div>
            {% endcapture %}
            {% if forloop.first %}{{ panel }}{% else %}<template data-index="{{ forloop.index0 }}">{{ panel }}</template>{% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
  <section class="source-mobile-canvas-deals" data-mobile-canvas-deals>
    <header class="source-mobile-canvas-deals__header">
      <h2>{{ section.settings.heading_prefix }} <span>{{ section.settings.heading_highlight }}</span> {{ section.settings.heading_suffix }}</h2>
      {% if section.settings.promotion_text != blank %}
        <a class="source-mobile-canvas-deals__promo-link" href="{{ section.settings.promotion_link }}">{{ section.settings.promotion_text }} <span aria-hidden="true">›</span></a>
      {% endif %}
      <div class="source-mobile-canvas-deals__tabs" role="tablist">
        {% for block in section.blocks %}
          {% assign tab_label = block.settings.label | default: block.settings.collection.title %}
          <button class="source-mobile-canvas-deals__tab{% if forloop.first %} is-active{% endif %}" type="button" data-canvas-tab="{{ forloop.index0 }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">{{ tab_label }}</button>
        {% endfor %}
      </div>
    </header>

    {% for block in section.blocks %}
      <div class="source-mobile-canvas-deals__panel{% if forloop.first %} is-active{% endif %}" data-canvas-panel="{{ forloop.index0 }}">
        <div class="source-mobile-canvas-deals__track">
          {% render 'source-product-shelf-promo-card', image: block.settings.promo_image, heading: block.settings.promo_heading, button_label: block.settings.promo_button_label, link: block.settings.promo_link, fallback_link: block.settings.collection.url %}
          {% if block.settings.collection != blank %}
            {% for product in block.settings.collection.products limit: 12 %}
              {% if product.featured_image != blank %}
                {% render 'source-bestsellers-product-card', product: product %}
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
        <div class="source-mobile-canvas-deals__progress" aria-hidden="true"><span></span></div>
        {% if block.settings.collection != blank %}
          <a class="source-mobile-canvas-deals__action" href="{{ block.settings.collection.url }}">{{ section.settings.collection_label }} <span aria-hidden="true">→</span></a>
        {% endif %}
      </div>
    {% endfor %}
  </section>
</div>
<style>
  @media screen and (max-width: 767.98px) {
    .source-canvas-deals-section { display: none !important; }

    .source-mobile-canvas-deals {
      display: block;
      padding: 30px 16px 32px;
      background: #fff;
      color: #111;
    }

    .source-mobile-canvas-deals__header { text-align: center; }

    .source-mobile-canvas-deals__header h2 {
      margin: 0;
      font-size: 31px;
      font-weight: 800;
      line-height: 1.1;
    }

    .source-mobile-canvas-deals__header h2 span {
      position: relative;
      display: inline-block;
      isolation: isolate;
    }

    .source-mobile-canvas-deals__header h2 span::after {
      position: absolute;
      right: -3px;
      bottom: 8px;
      left: -3px;
      z-index: -1;
      height: 6px;
      background: #cc2d52;
      content: "";
    }

    .source-mobile-canvas-deals__promo-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin: 16px auto 13px;
      padding-bottom: 5px;
      border-bottom: 1px solid #111;
      color: #111;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
    }

    .source-mobile-canvas-deals__promo-link span { font-size: 22px; line-height: 0.6; }

    .source-mobile-canvas-deals__tabs {
      display: flex;
      gap: 25px;
      overflow-x: auto;
      padding: 0 0 12px;
      scrollbar-width: none;
      white-space: nowrap;
    }

    .source-mobile-canvas-deals__tabs::-webkit-scrollbar,
    .source-mobile-canvas-deals__track::-webkit-scrollbar { display: none; }

    .source-mobile-canvas-deals__tab {
      position: relative;
      flex: 0 0 auto;
      padding: 0;
      border: 0;
      background: transparent;
      color: #666;
      font: inherit;
      font-size: 14px;
      font-weight: 500;
      line-height: 1;
    }

    .source-mobile-canvas-deals__tab::after {
      position: absolute;
      right: 0;
      bottom: 3px;
      left: 0;
      height: 1px;
      background: currentColor;
      content: "";
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .source-mobile-canvas-deals__tab.is-active { color: #111; font-weight: 600; }
    .source-mobile-canvas-deals__tab.is-active::after { transform: scaleX(1); }
    .source-mobile-canvas-deals__panel { display: none; }
    .source-mobile-canvas-deals__panel.is-active { display: block; }

    .source-mobile-canvas-deals__track {
      display: flex;
      gap: 14px;
      overflow-x: auto;
      padding: 10px 0 16px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .source-mobile-canvas-deals__track > .f-column {
      display: block !important;
      box-sizing: border-box;
      flex: 0 0 calc((100% - 14px) / 2) !important;
      width: calc((100% - 14px) / 2) !important;
      max-width: calc((100% - 14px) / 2) !important;
      min-width: 0;
      scroll-snap-align: start;
    }

    .source-mobile-canvas-deals .card-media--link,
    .source-mobile-canvas-deals .card-media { height: 100%; }
    .source-mobile-canvas-deals .card-media { min-height: 0; }
    .source-mobile-canvas-deals .card-media__content-wrapper { padding: 12px; }
    .source-mobile-canvas-deals .card-media__heading { font-size: 20px; line-height: 1.05; }

    .source-mobile-canvas-deals .product-card__image-wrapper,
    .source-mobile-canvas-deals .product-card__image,
    .source-mobile-canvas-deals .product-card__image img {
      aspect-ratio: 1 / 1 !important;
    }

    .source-mobile-canvas-deals .product-card__image-wrapper,
    .source-mobile-canvas-deals .product-card__image { height: auto !important; overflow: hidden !important; }
    .source-mobile-canvas-deals .product-card__image img { display: block !important; width: 100% !important; height: 100% !important; object-fit: cover !important; }
    .source-mobile-canvas-deals .product-card__info { padding-top: 9px; }
    .source-mobile-canvas-deals .product-card__atelier-badges { margin-bottom: 7px !important; }
    .source-mobile-canvas-deals .atelier-badge { max-width: 100%; font-size: 7px; white-space: nowrap; }
    .source-mobile-canvas-deals .product-card__title { font-size: 12px; line-height: 1.35; text-transform: uppercase; }
    .source-mobile-canvas-deals .product-card__material,
    .source-mobile-canvas-deals .f-price-item { font-size: 12px !important; }

    .source-mobile-canvas-deals__progress { height: 2px; margin: 2px 0 20px; }
    .source-mobile-canvas-deals__progress span { display: block; width: 18%; height: 100%; background: #111; transition: width 180ms linear; }

    .source-mobile-canvas-deals__action {
      display: flex;
      width: max-content;
      min-width: 160px;
      min-height: 40px;
      align-items: center;
      justify-content: center;
      gap: 7px;
      margin: 0 auto;
      padding: 0 18px;
      border-radius: 8px;
      background: #000;
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
    }
  }

  @media screen and (min-width: 768px) { .source-mobile-canvas-deals { display: none; } }
</style>
<script>
  (() => {
    document.querySelectorAll('[data-mobile-canvas-deals]').forEach((section) => {
      const syncProgress = (panel) => {
        const track = panel.querySelector('.source-mobile-canvas-deals__track');
        const indicator = panel.querySelector('.source-mobile-canvas-deals__progress span');
        if (!track || !indicator) return;
        const maxScroll = Math.max(track.scrollWidth - track.clientWidth, 0);
        const progress = maxScroll ? track.scrollLeft / maxScroll : 0;
        indicator.style.width = `${18 + progress * 82}%`;
      };

      section.querySelectorAll('[data-canvas-panel]').forEach((panel) => {
        const track = panel.querySelector('.source-mobile-canvas-deals__track');
        if (!track) return;
        track.addEventListener('scroll', () => syncProgress(panel), { passive: true });
        window.addEventListener('resize', () => syncProgress(panel));
        requestAnimationFrame(() => syncProgress(panel));
      });

      section.querySelectorAll('[data-canvas-tab]').forEach((tab) => {
        tab.addEventListener('click', () => {
          const index = tab.dataset.canvasTab;
          section.querySelectorAll('[data-canvas-tab]').forEach((item) => {
            const active = item === tab;
            item.classList.toggle('is-active', active);
            item.setAttribute('aria-selected', String(active));
          });
          section.querySelectorAll('[data-canvas-panel]').forEach((panel) => {
            const active = panel.dataset.canvasPanel === index;
            panel.classList.toggle('is-active', active);
            if (active) requestAnimationFrame(() => syncProgress(panel));
          });
        });
      });
    });
  })();
</script>
