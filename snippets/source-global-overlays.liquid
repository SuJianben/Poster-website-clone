{% render 'source-cart-drawer-1' %}
<style>
  html:not(.cart-count-ready) .cart-icon cart-count { visibility: hidden !important; }
  html.cart-count-ready .cart-icon cart-count:not([hidden]) { visibility: visible; }

  /* Preserve the theme's absolute badge placement while removing its red fill. */
  .cart-icon > cart-count.cart-count--absolute {
    background: transparent !important;
    border-color: transparent !important;
    box-shadow: none !important;
    color: currentColor !important;
  }
</style>
<script src="{{ 'source-cart-drawer.js' | asset_url }}" defer="defer"></script>
