{% liquid
  assign primary_collection = product.collections.first
  assign selected_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media
  assign selected_image = selected_media.preview_image | default: product.featured_image
  assign product_details_heading = section.settings.product_details_heading | default: 'Product Details'
  assign product_details_content = section.settings.product_details_content
  assign shipping_returns_heading = section.settings.shipping_returns_heading | default: 'Shipping and Returns'
  assign shipping_returns_content = section.settings.shipping_returns_content
  assign css_frame_orientation = blank
  if product.tags contains 'Kids Wall Art'
    assign css_frame_orientation = 'portrait'
    if product.tags contains 'Landscape'
      assign css_frame_orientation = 'landscape'
    endif
  endif
  assign size_guide_image = blank
  assign size_guide_label = 'SIZE GUIDE'
  for block in section.blocks
    if block.type == 'variant_picker'
      assign size_guide_image = block.settings.size_guide_image
      assign size_guide_label = block.settings.size_guide_label | default: size_guide_label
      break
    endif
  endfor
  assign size_guide_image_alt = size_guide_image.alt | default: size_guide_label
%}

<section class="spx-product" data-spx-product>
  <div class="spx-product__shell">
    <nav class="spx-product__breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true"></span>
      {% if primary_collection != blank %}<a href="{{ primary_collection.url }}">{{ primary_collection.title }}</a>{% else %}<a href="{{ routes.collections_url }}/all">All products</a>{% endif %}
      <span aria-hidden="true"></span><span>{{ product.title }}</span>
    </nav>

    <div class="spx-product__layout">
      <div class="spx-product__media-column">
        <div class="spx-product__gallery" aria-label="{{ product.title | escape }} product gallery">
          <div class="spx-product__thumb-rail">
            <button class="spx-product__thumb-control spx-product__thumb-control--up" type="button" aria-label="Show previous product images" data-spx-thumb-scroll="-1"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m7 14 5-5 5 5"/></svg></button>
            <div class="spx-product__thumb-window">
              <div class="spx-product__thumbs" role="tablist" aria-label="Product images" data-spx-thumb-track>
                {% for media in product.media %}
                  {% assign media_alt = media.alt | default: product.title %}
                  {% assign media_alt_handle = media.alt | handleize %}
                  {% assign frame_media_tone = '' %}
                  {% if media_alt_handle contains 'frame-none' or media_alt_handle contains 'none-frame' or media_alt_handle contains 'no-frame' or media_alt_handle contains 'frame-no' or media_alt_handle contains 'ohne-rahmen' or media_alt_handle contains 'rahmenlos' or media_alt_handle contains 'unframed' %}
                    {% assign frame_media_tone = 'none' %}
                  {% elsif media_alt_handle contains 'frame-white' or media_alt_handle contains 'white-frame' or media_alt_handle contains 'rahmen-weiss' or media_alt_handle contains 'weiss-rahmen' %}
                    {% assign frame_media_tone = 'white' %}
                  {% elsif media_alt_handle contains 'frame-black' or media_alt_handle contains 'black-frame' or media_alt_handle contains 'rahmen-schwarz' or media_alt_handle contains 'schwarz-rahmen' %}
                    {% assign frame_media_tone = 'black' %}
                  {% elsif media_alt_handle contains 'frame-silver' or media_alt_handle contains 'silver-frame' or media_alt_handle contains 'rahmen-silber' or media_alt_handle contains 'silber-rahmen' %}
                    {% assign frame_media_tone = 'silver' %}
                  {% elsif media_alt_handle contains 'frame-gold' or media_alt_handle contains 'gold-frame' or media_alt_handle contains 'rahmen-gold' or media_alt_handle contains 'gold-rahmen' %}
                    {% assign frame_media_tone = 'gold' %}
                  {% endif %}
                  <button class="spx-product__thumb{% if media.id == selected_media.id %} is-active{% endif %}" type="button" role="tab" aria-selected="{% if media.id == selected_media.id %}true{% else %}false{% endif %}" data-spx-image="{{ media.preview_image | image_url: width: 1620 }}" data-spx-media-id="{{ media.id }}" data-spx-image-id="{{ media.preview_image.id }}" data-spx-frame-media-tone="{{ frame_media_tone }}" data-spx-frame-media-key="{{ media_alt_handle }}" data-analytics-event="product_gallery_thumbnail">{{ media.preview_image | image_url: width: 168 | image_tag: alt: media_alt, loading: 'lazy' }}</button>
                {% else %}
                  <button class="spx-product__thumb is-active" type="button" role="tab" aria-selected="true" data-spx-image=""><span class="visually-hidden">{{ product.title }}</span></button>
                {% endfor %}
              </div>
            </div>
            <button class="spx-product__thumb-control spx-product__thumb-control--down" type="button" aria-label="Show more product images" data-spx-thumb-scroll="1"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m7 10 5 5-5 5"/></svg></button>
          </div>

          <div class="spx-product__main-image{% if css_frame_orientation != blank %} spx-product__main-image--css-frame spx-product__main-image--{{ css_frame_orientation }}{% endif %}" data-spx-viewer data-spx-active-index="0" data-spx-frame-tone="none">
            <div class="spx-product__css-frame">
              <div class="spx-product__css-frame-mat">
                <button class="spx-product__main-image-button" type="button" aria-label="Expand {{ product.title | escape }}" data-spx-open-zoom>
                  {% if selected_image != blank %}<img data-spx-main-image src="{{ selected_image | image_url: width: 1620 }}" alt="{{ product.title | escape }}">{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}
                </button>
              </div>
            </div>
            <button class="spx-product__zoom-button" type="button" aria-label="Expand image" data-spx-open-zoom><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="5.5"/><path d="m15 15 4 4"/></svg></button>
          </div>
        </div>

        <div class="spx-product__accordions">
          <details class="spx-product__accordion" data-spx-accordion>
            <summary><span>{{ product_details_heading }}</span><svg class="spx-product__accordion-icon" aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="M3.125 10H16.875"/><path class="spx-product__accordion-icon-vertical" d="M10 3.125V16.875"/></svg></summary>
            <div class="spx-product__accordion-content"><div class="spx-product__accordion-body spx-product__accordion-product-details">
              {% if product_details_content != blank %}
                {{ product_details_content }}
              {% elsif product.description != blank %}
                {{ product.description }}
              {% else %}
                <p class="spx-product__accordion-intro">Premium wall art made with high-resolution printing and durable materials.</p>
              {% endif %}
            </div></div>
          </details>
          <details class="spx-product__accordion" data-spx-accordion>
            <summary><span>{{ shipping_returns_heading }}</span><svg class="spx-product__accordion-icon" aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="M3.125 10H16.875"/><path class="spx-product__accordion-icon-vertical" d="M10 3.125V16.875"/></svg></summary>
            <div class="spx-product__accordion-content"><div class="spx-product__accordion-body spx-product__accordion-shipping">
              {% if shipping_returns_content != blank %}
                {{ shipping_returns_content }}
              {% else %}
                <h3>Shipping &amp; Delivery</h3><ul><li><strong>Shipping Costs:</strong> Free worldwide shipping on orders over 99 EUR.</li><li><strong>Security:</strong> Safe and fast shipping including tracking.</li><li><strong>Delivery Time:</strong> 2-7 business days worldwide.</li></ul>
                <h3>Returns &amp; Exchanges</h3><p>You can return or exchange your order within 30 days of receipt. Personalized products are excluded from return unless defective.</p>
              {% endif %}
            </div></div>
          </details>
        </div>
      </div>

      {% render 'source-product-purchase-panel', section: section, product: product %}
    </div>
  </div>

  <dialog class="spx-product__zoom-dialog" data-spx-zoom aria-label="Expanded product image">
    <div class="spx-product__zoom-stage">
      {% if selected_image != blank %}<img src="{{ selected_image | image_url: width: 1946 }}" alt="{{ product.title | escape }}" data-spx-zoom-image>{% else %}<img src="" alt="{{ product.title | escape }}" data-spx-zoom-image>{% endif %}
      <div class="spx-product__zoom-actions" aria-label="Expanded image controls">
        <button class="spx-product__zoom-action" type="button" aria-label="Close expanded image" data-spx-close-zoom><svg aria-hidden="true" viewBox="0 0 20 20"><path d="m5.5 5.5 9 9M14.5 5.5l-9 9"/></svg></button>
      </div>
    </div>
  </dialog>

  <script type="application/json" data-spx-variant-media-data>
    {
      {% for variant in product.variants %}
        "{{ variant.id }}": {
          "mediaId": {% if variant.featured_media != blank %}{{ variant.featured_media.id | json }}{% else %}null{% endif %},
          "imageId": {% if variant.featured_image != blank %}{{ variant.featured_image.id | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    }
  </script>

  <dialog class="spx-product__size-guide-dialog" data-spx-size-guide-dialog aria-label="Size guide">
    <div class="spx-product__size-guide-card">
      <div class="spx-product__size-guide-header">
        <span>{{ size_guide_label }}</span>
        <button type="button" data-spx-close-size-guide aria-label="Close size guide"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m18 6-12 12M6 6l12 12"/></svg></button>
      </div>
      {% if size_guide_image != blank %}
        <div class="spx-product__size-guide-image">{{ size_guide_image | image_url: width: 1800 | image_tag: alt: size_guide_image_alt, loading: 'lazy' }}</div>
      {% else %}
        <div class="spx-product__size-guide-table-wrap">
          <table class="spx-product__size-guide-table">
            <thead>
              <tr><th scope="col">ROUNDED INCHES</th><th scope="col">EXACT INCHES</th><th scope="col">EXACT CENTIMETERS</th></tr>
            </thead>
            <tbody>
              <tr><td>5 x 7 in</td><td>5.1 x 7.1 in</td><td>13 x 18 cm</td></tr>
              <tr><td>8 x 10 in</td><td>8 x 10 in</td><td>20.3 x 25.4 cm</td></tr>
              <tr><td>8 x 12 in</td><td>8.3 x 11.8 in</td><td>21 x 30 cm</td></tr>
              <tr><td>11 x 14 in</td><td>11 x 14 in</td><td>27.9 x 35.6 cm</td></tr>
              <tr><td>12 x 16 in</td><td>11.8 x 15.7 in</td><td>30 x 40 cm</td></tr>
              <tr><td>16 x 20 in</td><td>15.7 x 19.7 in</td><td>40 x 50 cm</td></tr>
              <tr><td>20 x 20 in</td><td>19.7 x 19.7 in</td><td>50 x 50 cm</td></tr>
              <tr><td>20 x 28 in</td><td>19.7 x 27.6 in</td><td>50 x 70 cm</td></tr>
              <tr><td>28 x 39 in</td><td>27.6 x 39.4 in</td><td>70 x 100 cm</td></tr>
              <tr><td>40 x 55 in</td><td>40 x 55 in</td><td>101.6 x 139.7 cm</td></tr>
              <tr><td>39 x 59 in</td><td>39.4 x 59.1 in</td><td>100 x 150 cm</td></tr>
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </dialog>
  <button class="spx-product__back-to-top" type="button" aria-label="Back to top" data-spx-back-to-top>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="m6 14 6-6 6 6"/></svg>
  </button>
</section>
