<section class="spx-product" data-spx-product>
  <div class="spx-product__shell">
    <nav class="spx-product__breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true"></span><a href="/collections/all">All posters</a><span aria-hidden="true"></span><span>Save Water - Poster</span>
    </nav>
    <div class="spx-product__layout">
      <div class="spx-product__media-column">
        <div class="spx-product__gallery" aria-label="Save Water product gallery">
          <div class="spx-product__thumb-rail">
            <button class="spx-product__thumb-control spx-product__thumb-control--up" type="button" aria-label="Show previous product images" data-spx-thumb-scroll="-1"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m7 14 5-5 5 5"/></svg></button>
            <div class="spx-product__thumb-window">
              <div class="spx-product__thumbs" role="tablist" aria-label="Product images" data-spx-thumb-track>
            <button class="spx-product__thumb is-active" type="button" role="tab" aria-selected="true" data-spx-image="https://dotcomcanvas.de/cdn/shop/files/PosterSaveWaterDrinkChampagneOriginalPopArtBildFront-Vertical.jpg?v=1737392893&amp;width=1620" data-analytics-event="product_gallery_thumbnail"><img src="https://dotcomcanvas.de/cdn/shop/files/PosterSaveWaterDrinkChampagneOriginalPopArtBildFront-Vertical.jpg?v=1737392893&amp;width=168" alt="Save Water poster front"></button>
            <button class="spx-product__thumb" type="button" role="tab" aria-selected="false" data-spx-image="https://dotcomcanvas.de/cdn/shop/files/PosterSaveWaterDrinkChampagneOriginalPopArtBildBeton-Wall-Vertical.jpg?v=1737392893&amp;width=1620" data-analytics-event="product_gallery_thumbnail"><img src="https://dotcomcanvas.de/cdn/shop/files/PosterSaveWaterDrinkChampagneOriginalPopArtBildBeton-Wall-Vertical.jpg?v=1737392893&amp;width=168" alt="Save Water poster in room"></button>
            <button class="spx-product__thumb" type="button" role="tab" aria-selected="false" data-spx-image="https://dotcomcanvas.de/cdn/shop/files/PosterSaveWaterDrinkChampagneOriginalPopArtBildCertificat-Vertical.jpg?v=1737392893&amp;width=1620" data-analytics-event="product_gallery_thumbnail"><img src="https://dotcomcanvas.de/cdn/shop/files/PosterSaveWaterDrinkChampagneOriginalPopArtBildCertificat-Vertical.jpg?v=1737392893&amp;width=168" alt="Certificate detail"></button>
            <button class="spx-product__thumb" type="button" role="tab" aria-selected="false" data-spx-image="https://dotcomcanvas.de/cdn/shop/files/PosterSaveWaterDrinkChampagneOriginalPopArtBildCorner-Detail-Vertical-2.jpg?v=1737392893&amp;width=1620" data-analytics-event="product_gallery_thumbnail"><img src="https://dotcomcanvas.de/cdn/shop/files/PosterSaveWaterDrinkChampagneOriginalPopArtBildCorner-Detail-Vertical-2.jpg?v=1737392893&amp;width=168" alt="Poster corner detail"></button>
            <button class="spx-product__thumb" type="button" role="tab" aria-selected="false" data-spx-image="https://dotcomcanvas.de/cdn/shop/files/PosterSaveWaterDrinkChampagneOriginalPopArtBildCorner-Detail-Vertical.jpg?v=1737392893&amp;width=1620" data-analytics-event="product_gallery_thumbnail"><img src="https://dotcomcanvas.de/cdn/shop/files/PosterSaveWaterDrinkChampagneOriginalPopArtBildCorner-Detail-Vertical.jpg?v=1737392893&amp;width=168" alt="Poster detail"></button>
            <button class="spx-product__thumb" type="button" role="tab" aria-selected="false" data-spx-image="https://dotcomcanvas.de/cdn/shop/files/PosterSaveWaterDrinkChampagneOriginalPopArtBildRoll-up-Poster-Vertical.jpg?v=1737392864&amp;width=1620" data-analytics-event="product_gallery_thumbnail"><img src="https://dotcomcanvas.de/cdn/shop/files/PosterSaveWaterDrinkChampagneOriginalPopArtBildRoll-up-Poster-Vertical.jpg?v=1737392864&amp;width=168" alt="Rolled poster"></button>
            <button class="spx-product__thumb" type="button" role="tab" aria-selected="false" data-spx-image="https://dotcomcanvas.de/cdn/shop/files/PosterSaveWaterDrinkChampagneOriginalPopArtBildTube-Roll-Vertical.jpg?v=1737392864&amp;width=1620" data-analytics-event="product_gallery_thumbnail"><img src="https://dotcomcanvas.de/cdn/shop/files/PosterSaveWaterDrinkChampagneOriginalPopArtBildTube-Roll-Vertical.jpg?v=1737392864&amp;width=168" alt="Poster tube"></button>
              </div>
            </div>
            <button class="spx-product__thumb-control spx-product__thumb-control--down" type="button" aria-label="Show more product images" data-spx-thumb-scroll="1"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m7 10 5 5 5-5"/></svg></button>
          </div>
          <div class="spx-product__main-image" data-spx-viewer>
            <button class="spx-product__main-image-button" type="button" aria-label="Expand Save Water poster" data-spx-open-zoom><img data-spx-main-image src="https://dotcomcanvas.de/cdn/shop/files/PosterSaveWaterDrinkChampagneOriginalPopArtBildFront-Vertical.jpg?v=1737392893&amp;width=1620" alt="Save Water - Poster"></button>
            <button class="spx-product__zoom-button" type="button" aria-label="Expand image" data-spx-open-zoom><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="5.5"/><path d="m15 15 4 4"/></svg></button>
            <button class="spx-product__viewer-control spx-product__viewer-control--previous is-disabled" type="button" aria-label="Previous image" aria-disabled="true" disabled data-spx-previous><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m14.5 5-7 7 7 7"/></svg></button>
            <button class="spx-product__viewer-control spx-product__viewer-control--next" type="button" aria-label="Next image" data-spx-next><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9.5 5 7 7-7 7"/></svg></button>
          </div>
        </div>

        <div class="spx-product__accordions">
          <details class="spx-product__accordion" data-spx-accordion>
            <summary><span>Product Details</span><svg class="spx-product__accordion-icon" aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="M3.125 10H16.875"/><path class="spx-product__accordion-icon-vertical" d="M10 3.125V16.875"/></svg></summary>
            <div class="spx-product__accordion-content"><div class="spx-product__accordion-body spx-product__accordion-product-details">
              <p class="spx-product__accordion-intro">High-resolution DOTCOMCANVAS® Premium Poster. Razor-sharp details and lifelike colors, printed on sustainable materials.</p>
              <h3>Materials</h3><ul><li>High-quality premium poster paper</li><li>High-resolution print surface</li></ul>
              <h3>Quality</h3><ul><li>Ecological and odorless printing process</li><li>Rich and vibrant colors</li><li>UV-resistant for protected colors</li></ul>
              <h3>Details</h3><ul><li>Safely packaged for secure shipping</li><li>30-day money-back guarantee</li><li>Made in Germany</li></ul>
              <p class="spx-product__accordion-care">Care: Handle with clean hands. Protect from direct moisture and continuous direct sunlight.</p>
            </div></div>
          </details>
          <details class="spx-product__accordion" data-spx-accordion>
            <summary><span>Shipping and Returns</span><svg class="spx-product__accordion-icon" aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="M3.125 10H16.875"/><path class="spx-product__accordion-icon-vertical" d="M10 3.125V16.875"/></svg></summary>
            <div class="spx-product__accordion-content"><div class="spx-product__accordion-body">
              <h3>Shipping &amp; Delivery</h3><ul><li><strong>Shipping Costs:</strong> Free worldwide shipping on orders over €49.</li><li><strong>Security:</strong> Safe and fast shipping including tracking.</li><li><strong>Delivery Time:</strong> 2–5 business days worldwide (may vary depending on product size and material).</li></ul>
              <p><strong>International Shipping:</strong> Please note that deliveries outside the EU may be subject to customs duties or import taxes. These costs are levied by the destination country and are the responsibility of the recipient.</p>
              <h3>Returns &amp; Exchanges</h3><p>Returns are accepted according to the store return policy.</p>
            </div></div>
          </details>
        </div>
      </div>

      {% render 'source-product-purchase-panel', section: section, product: product %}
    </div>
  </div>
  <dialog class="spx-product__zoom-dialog" data-spx-zoom aria-label="Expanded product image">
    <div class="spx-product__zoom-stage">
      <img src="https://dotcomcanvas.de/cdn/shop/files/PosterSaveWaterDrinkChampagneOriginalPopArtBildFront-Vertical.jpg?v=1737392893&amp;width=1946" alt="Save Water - Poster" data-spx-zoom-image>
      <div class="spx-product__zoom-actions" aria-label="Expanded image controls">
        <button class="spx-product__zoom-action" type="button" aria-label="Previous image" data-spx-previous><svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="M12.5 3.75 6.25 10l6.25 6.25"/></svg></button>
        <button class="spx-product__zoom-action" type="button" aria-label="Close expanded image" data-spx-close-zoom><svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="m5.5 5.5 9 9M14.5 5.5l-9 9"/></svg></button>
        <button class="spx-product__zoom-action" type="button" aria-label="Next image" data-spx-next><svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="M7.5 3.75 13.75 10 7.5 16.25"/></svg></button>
      </div>
    </div>
  </dialog>
  <dialog class="spx-product__size-guide-dialog" data-spx-size-guide-dialog aria-label="Size guide">
    <div class="spx-product__size-guide-card"><div class="spx-product__size-guide-header"><span>SIZE GUIDE</span><button type="button" data-spx-close-size-guide aria-label="Close size guide"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m18 6-12 12M6 6l12 12"/></svg></button></div><div class="spx-product__size-guide-image"><img src="https://dotcomcanvas.de/cdn/shop/files/Groessen_Size_en_Guide_NA_inches.png?v=10709032047291710906" alt="Size guide in inches"></div></div>
  </dialog>
</section>
