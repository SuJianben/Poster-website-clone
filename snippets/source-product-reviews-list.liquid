{%- liquid
  assign manual_review_count = 0
  assign review_page_size = section.settings.reviews_per_page | default: 12
  assign default_filter = section.settings.default_filter | default: 'recent'

  for block in section.blocks
    assign review_matches_current_product = true
    assign review_enabled = block.settings.enabled
    if review_enabled == nil
      assign review_enabled = true
    endif
    if block.type == 'review' and block.settings.product != blank and current_product != blank
      if block.settings.product.id != current_product.id
        assign review_matches_current_product = false
      endif
    endif

    if block.type == 'review' and review_enabled and review_matches_current_product
      assign manual_review_count = manual_review_count | plus: 1
    endif
  endfor

  assign shared_review_count = review_count
  if manual_review_count > 0 and section.settings.use_custom_summary != true
    assign shared_review_count = manual_review_count
  elsif shared_review_count == blank
    assign shared_review_count = manual_review_count
  endif
  assign shared_write_heading = write_heading | default: 'Eine Bewertung schreiben'
  assign selected_review_mode = review_mode | default: 'default'
  assign review_page = pages['write-a-review']
  assign shared_contact_url = contact_url | default: review_page.url
  if shared_contact_url == blank
    assign shared_contact_url = routes.contact_url
  endif
  assign shared_review_app_url = false
  if shared_contact_url contains '/a/review/'
    assign shared_review_app_url = true
  endif

  assign default_filter_label = 'Neueste'
  case default_filter
    when 'photos'
      assign default_filter_label = 'Mit Fotos'
    when 'highest-rating'
      assign default_filter_label = 'Höchste Bewertung'
    when 'lowest-rating'
      assign default_filter_label = 'Niedrigste Bewertung'
    when 'most-votes'
      assign default_filter_label = 'Hilfreichste'
  endcase

  assign rendered_review_count = manual_review_count
  if rendered_review_count == 0
    assign rendered_review_count = 12
  endif
  assign review_page_total = rendered_review_count | plus: review_page_size | minus: 1 | divided_by: review_page_size
  assign show_review_content = true
  if manual_review_count == 0 and selected_review_mode == 'empty'
    assign show_review_content = false
  endif
-%}

{%- if show_review_content -%}
<div class="sprv__toolbar">
  <div class="sprv__tab-row">
    <div class="sprv__tab" aria-current="page">Bewertungen <span>{{ shared_review_count }}</span></div>
  </div>
  <div class="sprv__filter-row">
    <span class="sprv__filter-label">Filter Bewertungen:</span>
    <div class="sprv__filter" data-sprv-filter>
      <button type="button" aria-expanded="false" data-sprv-filter-button data-sprv-filter="{{ default_filter }}">{{ default_filter_label }} <span aria-hidden="true"></span></button>
      <div class="sprv__filter-menu" hidden data-sprv-filter-menu>
        <button type="button" data-value="photos">Mit Fotos</button>
        <button type="button" data-value="recent">Neueste</button>
        <button type="button" data-value="highest-rating">Höchste Bewertung</button>
        <button type="button" data-value="lowest-rating">Niedrigste Bewertung</button>
        <button type="button" data-value="most-votes">Hilfreichste</button>
      </div>
    </div>
  </div>
</div>
<p class="sprv__filter-status visually-hidden" aria-live="polite" data-sprv-filter-status></p>

<div class="sprv__cards" data-sprv-cards>
  {%- if manual_review_count > 0 -%}
    {%- assign review_position = 0 -%}
    {%- for block in section.blocks -%}
      {%- assign review_matches_current_product = true -%}
      {%- assign review_enabled = block.settings.enabled -%}
      {%- if review_enabled == nil -%}
        {%- assign review_enabled = true -%}
      {%- endif -%}
      {%- if block.type == 'review' and block.settings.product != blank and current_product != blank -%}
        {%- if block.settings.product.id != current_product.id -%}
          {%- assign review_matches_current_product = false -%}
        {%- endif -%}
      {%- endif -%}
      {%- if block.type == 'review' and review_enabled and review_matches_current_product -%}
        {%- assign review_position = review_position | plus: 1 -%}
        {% render 'source-product-review-card', block: block, position: review_position %}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- for index in (1..12) -%}
      {% render 'source-product-review-card-legacy', index: index %}
    {%- endfor -%}
  {%- endif -%}
</div>
<div class="sprv__carousel-progress" aria-hidden="true">
  <span data-sprv-carousel-progress></span>
</div>

{%- if review_page_total > 1 -%}
  <nav class="sprv__pagination" aria-label="Reviews pagination" data-sprv-pagination>
    <button type="button" data-sprv-page="previous" aria-label="Previous page">&lt;</button>
    {%- for page_number in (1..review_page_total) -%}
      <button type="button" data-sprv-page="{{ page_number }}"{% if page_number == 1 %} class="is-active" aria-current="page"{% endif %}>{{ page_number }}</button>
    {%- endfor -%}
    <button type="button" data-sprv-page="next" aria-label="Next page">&gt;</button>
  </nav>
{%- endif -%}
{%- endif -%}

{%- if show_write -%}
  <div class="sprv__write">
    <h3>{{ shared_write_heading }}</h3>
    <p>We would appreciate feedback via the <a href="{{ shared_contact_url }}">contact form</a><br>or look forward to an official review after placing an order!</p>
    <a class="sprv__write-button" href="{{ shared_contact_url }}"{% if request.design_mode and shared_review_app_url %} target="_blank" rel="noopener"{% endif %} data-sprv-write>
      <span class="sprv__write-label">Write A Review</span>
      <span class="sprv__write-icon" aria-hidden="true">›</span>
    </a>
  </div>
{%- endif -%}
