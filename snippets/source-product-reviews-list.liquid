{%- liquid
  assign shared_review_count = review_count | default: '2624'
  assign shared_write_heading = write_heading | default: 'Write a review'
  assign shared_contact_url = contact_url | default: '/pages/contact'
-%}

<div class="sprv__toolbar">
  <div class="sprv__tab-row">
    <div class="sprv__tab" aria-current="page">Reviews <span>{{ shared_review_count }}</span></div>
  </div>
  <div class="sprv__filter-row">
    <div class="sprv__filter" data-sprv-filter>
      <button type="button" aria-expanded="false" data-sprv-filter-button>With Photos <span aria-hidden="true"></span></button>
      <div class="sprv__filter-menu" hidden data-sprv-filter-menu>
        <button type="button" data-value="photos">With Photos</button>
        <button type="button" data-value="all">All Reviews</button>
      </div>
    </div>
  </div>
</div>

<div class="sprv__cards" data-sprv-cards>
  {%- for index in (1..4) -%}
    {% render 'source-product-review-card', index: index %}
  {%- endfor -%}
</div>

<nav class="sprv__pagination" aria-label="Reviews pagination">
  <button type="button" data-sprv-page="previous" aria-label="Previous page">&lt;</button>
  {%- for page_number in (1..10) -%}
    <button type="button" data-sprv-page="{{ page_number }}"{% if page_number == 1 %} class="is-active" aria-current="page"{% endif %}>{{ page_number }}</button>
  {%- endfor -%}
  <button type="button" data-sprv-page="next" aria-label="Next page">&gt;</button>
</nav>

{%- if show_write -%}
  <div class="sprv__write">
    <h3>{{ shared_write_heading }}</h3>
    <p>We would appreciate feedback via the <a href="{{ shared_contact_url }}">contact form</a><br>or look forward to an official review after placing an order!</p>
    <a class="sprv__write-button" href="{{ shared_contact_url }}" data-sprv-write>
      <span class="sprv__write-label">Write A Review</span>
      <span class="sprv__write-icon" aria-hidden="true">›</span>
    </a>
  </div>
{%- endif -%}

<dialog class="sprv__lightbox" data-sprv-lightbox aria-label="Customer photo preview">
  <button class="sprv__lightbox-close" type="button" data-sprv-lightbox-close aria-label="Close preview">×</button>
  <img data-sprv-lightbox-image alt="Customer wall art photo preview" width="900" height="900">
</dialog>

