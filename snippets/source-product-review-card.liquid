{%- liquid
  assign review_product = block.settings.product
  assign review_title = block.settings.title | strip
  assign review_image_alt = review_title | default: 'Kundrecension'
  assign review_body = block.settings.body | default: ''
  assign review_date = block.settings.review_date | default: ''
  assign review_sort_date = review_date
  if review_sort_date == blank
    assign review_sort_date = '2999-12-31'
  endif
  assign rating = block.settings.rating | default: 5
  assign reviewer = block.settings.reviewer | default: 'Customer'
  assign country = block.settings.country | default: ''
  assign helpful = block.settings.helpful_count | default: 0
  assign verified_label = ''
  if block.settings.verified
    assign verified_label = block.settings.verified_label | default: 'Verifierad köpare'
  endif

  assign product_name = block.settings.product_name | default: ''
  assign product_image = ''
  if review_product != blank
    assign product_name = review_product.title
    if review_product.featured_image != blank
      assign product_image = review_product.featured_image | image_url: width: 600
    endif
  endif

  assign review_image_1 = block.settings.image_1
  assign review_image_2 = block.settings.image_2
  assign review_image_3 = block.settings.image_3
  assign review_image_1_url = block.settings.image_1_url | strip
  assign review_image_2_url = block.settings.image_2_url | strip
  assign review_image_3_url = block.settings.image_3_url | strip
  assign image_count = 0

  if review_image_1 != blank or review_image_1_url != blank
    assign image_count = image_count | plus: 1
  endif
  if review_image_2 != blank or review_image_2_url != blank
    assign image_count = image_count | plus: 1
  endif
  if review_image_3 != blank or review_image_3_url != blank
    assign image_count = image_count | plus: 1
  endif
-%}

<article
  class="sprv-card"
  data-sprv-review-card
  data-sprv-source="manual"
  data-sprv-has-photo="{% if image_count > 0 %}true{% else %}false{% endif %}"
  data-sprv-date="{{ review_sort_date | escape }}"
  data-sprv-rating="{{ rating }}"
  data-sprv-helpful="{{ helpful }}"
  {{ block.shopify_attributes }}
>
  {%- if image_count > 0 -%}
    <div class="sprv-card__media{% if image_count > 1 %} sprv-card__media--stack{% endif %}">
      {%- if review_image_1 != blank -%}
        {%- assign image_1_src = review_image_1 | image_url: width: 900 -%}
        <button type="button" data-srp-summary-photo data-sprv-photo="{{ image_1_src }}" data-reviewer="{{ reviewer | escape }}" data-verified="{{ verified_label | escape }}" data-date="{{ review_date | escape }}" data-title="{{ review_title | escape }}" data-body="{{ review_body | escape }}" data-product="{{ product_name | escape }}"{% if product_image != blank %} data-product-image="{{ product_image }}"{% endif %} data-helpful="{{ helpful }}" aria-label="Open review photo 1">
          <img src="{{ image_1_src }}" alt="{{ review_image_alt | escape }}" width="{{ review_image_1.width }}" height="{{ review_image_1.height }}" loading="lazy">
        </button>
      {%- elsif review_image_1_url != blank -%}
        <button type="button" data-srp-summary-photo data-sprv-photo="{{ review_image_1_url | escape }}" data-reviewer="{{ reviewer | escape }}" data-verified="{{ verified_label | escape }}" data-date="{{ review_date | escape }}" data-title="{{ review_title | escape }}" data-body="{{ review_body | escape }}" data-product="{{ product_name | escape }}"{% if product_image != blank %} data-product-image="{{ product_image }}"{% endif %} data-helpful="{{ helpful }}" aria-label="Open review photo 1">
          <img src="{{ review_image_1_url | escape }}" alt="{{ review_image_alt | escape }}" width="900" height="675" loading="lazy">
        </button>
      {%- endif -%}

      {%- if review_image_2 != blank -%}
        {%- assign image_2_src = review_image_2 | image_url: width: 900 -%}
        <button type="button" data-srp-summary-photo data-sprv-photo="{{ image_2_src }}" data-reviewer="{{ reviewer | escape }}" data-verified="{{ verified_label | escape }}" data-date="{{ review_date | escape }}" data-title="{{ review_title | escape }}" data-body="{{ review_body | escape }}" data-product="{{ product_name | escape }}"{% if product_image != blank %} data-product-image="{{ product_image }}"{% endif %} data-helpful="{{ helpful }}" aria-label="Open review photo 2">
          <img src="{{ image_2_src }}" alt="{{ review_image_alt | escape }}" width="{{ review_image_2.width }}" height="{{ review_image_2.height }}" loading="lazy">
        </button>
      {%- elsif review_image_2_url != blank -%}
        <button type="button" data-srp-summary-photo data-sprv-photo="{{ review_image_2_url | escape }}" data-reviewer="{{ reviewer | escape }}" data-verified="{{ verified_label | escape }}" data-date="{{ review_date | escape }}" data-title="{{ review_title | escape }}" data-body="{{ review_body | escape }}" data-product="{{ product_name | escape }}"{% if product_image != blank %} data-product-image="{{ product_image }}"{% endif %} data-helpful="{{ helpful }}" aria-label="Open review photo 2">
          <img src="{{ review_image_2_url | escape }}" alt="{{ review_image_alt | escape }}" width="900" height="675" loading="lazy">
        </button>
      {%- endif -%}

      {%- if review_image_3 != blank -%}
        {%- assign image_3_src = review_image_3 | image_url: width: 900 -%}
        <button type="button" data-srp-summary-photo data-sprv-photo="{{ image_3_src }}" data-reviewer="{{ reviewer | escape }}" data-verified="{{ verified_label | escape }}" data-date="{{ review_date | escape }}" data-title="{{ review_title | escape }}" data-body="{{ review_body | escape }}" data-product="{{ product_name | escape }}"{% if product_image != blank %} data-product-image="{{ product_image }}"{% endif %} data-helpful="{{ helpful }}" aria-label="Open review photo 3">
          <img src="{{ image_3_src }}" alt="{{ review_image_alt | escape }}" width="{{ review_image_3.width }}" height="{{ review_image_3.height }}" loading="lazy">
        </button>
      {%- elsif review_image_3_url != blank -%}
        <button type="button" data-srp-summary-photo data-sprv-photo="{{ review_image_3_url | escape }}" data-reviewer="{{ reviewer | escape }}" data-verified="{{ verified_label | escape }}" data-date="{{ review_date | escape }}" data-title="{{ review_title | escape }}" data-body="{{ review_body | escape }}" data-product="{{ product_name | escape }}"{% if product_image != blank %} data-product-image="{{ product_image }}"{% endif %} data-helpful="{{ helpful }}" aria-label="Open review photo 3">
          <img src="{{ review_image_3_url | escape }}" alt="{{ review_image_alt | escape }}" width="900" height="675" loading="lazy">
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="sprv-card__content">
    <div class="sprv-card__meta">
      {%- if review_date != blank -%}<time datetime="{{ review_date | escape }}">{{ review_date | escape }}</time>{%- endif -%}
      <span class="sprv__stars" aria-label="{{ rating }} out of 5 stars">{% for star in (1..5) %}{% if star <= rating %}★{% else %}☆{% endif %}{% endfor %}</span>
    </div>
    {%- if review_title != blank -%}<h3>{{ review_title | escape }}</h3>{%- endif -%}
    {%- if review_body != blank -%}<p class="sprv-card__body" data-sprv-review-body>{{ review_body | escape | newline_to_br }}</p>{%- endif -%}
    <button class="sprv-card__expand" type="button" data-sprv-review-expand aria-expanded="false" hidden>Mehr anzeigen</button>
    {%- if product_name != blank -%}<p class="sprv-card__product">{{ product_name | escape }}</p>{%- endif -%}
    <p class="sprv-card__author"><strong>{{ reviewer | escape }}</strong>{% if verified_label != blank %} <span>{{ verified_label | escape }}</span>{% endif %}</p>
    {%- if country != blank -%}<p class="sprv-card__country">⚑ {{ country | escape }}</p>{%- endif -%}
    <div class="sprv-card__helpful">Was this helpful?
      <button type="button" data-sprv-helpful="up" aria-label="Helpful">♥ <span>{{ helpful }}</span></button>
      <button type="button" data-sprv-helpful="down" aria-label="Not helpful">♡ <span>0</span></button>
    </div>
  </div>
</article>
