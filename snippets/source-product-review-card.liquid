<article class="sprv-card" data-sprv-review-card data-has-photo="true">
  <div class="sprv-card__media{% if image_urls.size > 1 %} sprv-card__media--stack{% endif %}">
    {%- for image_url in image_urls -%}
      <button type="button" data-srp-summary-photo data-sprv-photo="{{ image_url }}" data-reviewer="{{ author | escape }}" data-verified="{{ verified_label | escape }}" data-date="{{ review_date | escape }}" data-title="{{ review_title | escape }}" data-body="{{ review_body | escape }}" data-product="{{ product_name | escape }}"{% if product_image != blank %} data-product-image="{{ product_image | escape }}"{% endif %} data-helpful="{{ helpful }}" aria-label="Open review photo {{ forloop.index }}">
        <img src="{{ image_url }}" alt="Save Water customer review" width="700" height="525" loading="lazy">
      </button>
    {%- endfor -%}
  </div>
  <div class="sprv-card__content">
    <div class="sprv-card__meta"><span class="sprv__stars">★★★★★</span><time>{{ review_date }}</time></div>
    <dl class="sprv-card__details">
      {%- for row in detail_rows -%}
        {%- assign columns = row | split: '::' -%}
        <div><dt>{{ columns[0] }}</dt><dd>{{ columns[1] }}</dd></div>
      {%- endfor -%}
    </dl>
    <div class="sprv-card__meters">
      {%- assign meter_labels = 'Wie bewertest du die Druckqualität?|Wie bewertest du die Verarbeitung?|Wie bewertest du das Preis-Leistungs-Verhältnis?' | split: '|' -%}
      {%- for label in meter_labels -%}
        <div><strong>{{ label }}</strong><span class="sprv-card__meter"><i></i><i></i><i></i><i></i><i></i></span><small><b>Schlecht</b><b>Perfekt</b></small></div>
      {%- endfor -%}
    </div>
    <h3>{{ review_title }}</h3>
    <p class="sprv-card__body">{{ review_body }}</p>
    {%- if product_name != blank -%}<p class="sprv-card__product">{{ product_name }}</p>{%- endif -%}
    <p class="sprv-card__author"><strong>{{ author }}</strong>{% if verified_label != blank %} <span>{{ verified_label }}</span>{% endif %}</p>
    {%- if country != blank -%}<p class="sprv-card__country">⚑ {{ country }}</p>{%- endif -%}
    <div class="sprv-card__helpful">Was this helpful?
      <button type="button" data-sprv-helpful="up" aria-label="Helpful">♥ <span>{{ helpful }}</span></button>
      <button type="button" data-sprv-helpful="down" aria-label="Not helpful">♡ <span>0</span></button>
    </div>
  </div>
</article>
