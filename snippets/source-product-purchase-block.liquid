{% case block.type %}
  {% when 'top_badge' %}
    {% assign selected_variant = product.selected_or_first_available_variant %}
    {% assign has_sale_badge = false %}
    {% assign sale_percentage = 0 %}
    {% assign has_trending_badge = false %}
    {% assign has_bestseller_badge = false %}
    {% assign has_new_badge = false %}
    {% assign has_limited_badge = false %}
    {% assign has_personalizable_badge = false %}
    {% if selected_variant.compare_at_price > selected_variant.price %}
      {% assign has_sale_badge = true %}
      {% assign sale_percentage = selected_variant.compare_at_price | minus: selected_variant.price | times: 100 | divided_by: selected_variant.compare_at_price | round %}
    {% endif %}
    {% for tag in product.tags %}
      {% assign normalized_tag = tag | downcase | strip %}
      {% if normalized_tag == 'trending' %}{% assign has_trending_badge = true %}{% endif %}
      {% if normalized_tag == 'bestseller' or normalized_tag == 'best seller' %}{% assign has_bestseller_badge = true %}{% endif %}
      {% if normalized_tag == 'neuheiten' or normalized_tag == 'new' %}{% assign has_new_badge = true %}{% endif %}
      {% if normalized_tag contains 'limited' %}{% assign has_limited_badge = true %}{% endif %}
      {% if normalized_tag contains 'personal' or normalized_tag contains 'custom' %}{% assign has_personalizable_badge = true %}{% endif %}
    {% endfor %}
    {% assign has_product_badge = false %}
    {% if has_sale_badge or has_trending_badge or has_bestseller_badge or has_new_badge or has_limited_badge or has_personalizable_badge %}
      {% assign has_product_badge = true %}
    {% endif %}
    <div class="spx-product__top-badges" data-analytics-block-type="top_badge" {{ block.shopify_attributes }}>
      {% if has_product_badge %}
        {% if has_sale_badge %}<span class="spx-product__top-badge spx-product__top-badge--sale">SPARE {{ sale_percentage }}%</span>{% endif %}
        {% if has_trending_badge %}<span class="spx-product__top-badge spx-product__top-badge--trending">Trending</span>{% endif %}
        {% if has_bestseller_badge %}<span class="spx-product__top-badge spx-product__top-badge--bestseller">Bestseller</span>{% endif %}
        {% if has_new_badge %}<span class="spx-product__top-badge spx-product__top-badge--new">New</span>{% endif %}
        {% if has_limited_badge %}<span class="spx-product__top-badge spx-product__top-badge--limited">Limited Edition</span>{% endif %}
        {% if has_personalizable_badge %}<span class="spx-product__top-badge spx-product__top-badge--personalizable">Personalizable</span>{% endif %}
      {% elsif block.settings.text != blank %}
        <span class="spx-product__top-badge spx-product__top-badge--trending">{{ block.settings.text }}</span>
      {% endif %}
    </div>

  {% when 'brand_banner' %}
    <div class="spx-product__brands" data-analytics-block-type="brand_banner" {{ block.shopify_attributes }}>
      <span class="spx-product__brand-logos">
        <img src="{{ 'source-bauhaus-logo.png' | asset_url }}" alt="Bauhaus" width="82" height="16">
        <span class="spx-product__brand-comma">,</span>
        <img src="{{ 'source-xxxlutz-logo.png' | asset_url }}" alt="XXXLutz" width="54" height="13">
      </span>
      <span class="spx-product__brands-copy">{{ block.settings.text }}</span>
    </div>

  {% when 'reviews' %}
    {% if false %}
    {% assign review_rating = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value %}
    {% assign review_count = product.metafields.reviews.rating_count.value %}
    {% if review_rating != blank and review_count != blank %}
      <p class="spx-product__reviews" aria-label="{{ review_rating }} out of 5 stars, {{ review_count }} {{ block.settings.label }}" data-analytics-block-type="reviews" {{ block.shopify_attributes }}>
        <span aria-hidden="true">★★★★★</span> {{ review_count }} {{ block.settings.label }}
      </p>
    {% endif %}

    {% endif %}
    {% assign review_rating = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | default: 4.9 %}
    {% assign review_count = product.metafields.reviews.rating_count.value | default: block.settings.count %}
    <p class="spx-product__reviews" aria-label="{{ review_rating }} out of 5 stars, {{ review_count }} {{ block.settings.label }}" data-analytics-block-type="reviews" {{ block.shopify_attributes }}>
      <span class="spx-product__review-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
      <span>{{ review_count }} {{ block.settings.label }}</span>
    </p>

  {% when 'title' %}
    {% assign panel_title = block.settings.heading %}
    {% if block.settings.use_product_title and product != blank %}{% assign panel_title = product.title %}{% endif %}
    <h1 data-analytics-block-type="title" {{ block.shopify_attributes }}>{{ panel_title }}</h1>

  {% when 'artist' %}
    {% assign artist_name = block.settings.name %}
    {% assign artist_url = block.settings.url %}
    {% if block.settings.use_product_vendor and product.vendor != blank %}
      {% assign artist_name = product.vendor %}
      {% assign artist_handle = product.vendor | handleize %}
      {% assign artist_url = routes.collections_url | append: '/' | append: artist_handle %}
    {% endif %}
    <p class="spx-product__artist" data-analytics-block-type="artist" {{ block.shopify_attributes }}>
      {{ block.settings.label }} <a href="{{ artist_url }}">{{ artist_name }}</a>
      {% if block.settings.show_atelier_badge %}
        <button class="spx-product__atelier-badge" type="button" data-spx-atelier aria-label="Learn about {{ block.settings.atelier_text }}">
          {{ block.settings.atelier_text }}
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      {% endif %}
    </p>

  {% when 'price' %}
    {% assign panel_price = block.settings.price_text %}
    {% if block.settings.use_product_price and product != blank %}{% assign panel_price = product.selected_or_first_available_variant.price | money %}{% endif %}
    <div data-analytics-block-type="price"{% if block.settings.use_product_price %} data-spx-dynamic-price{% endif %} {{ block.shopify_attributes }}>
      <p class="spx-product__price" data-spx-price-output>{{ panel_price }}</p>
      <p class="spx-product__shipping">{{ block.settings.shipping_text }}</p>
    </div>

  {% when 'variant_picker' %}
    {% unless product.has_only_default_variant %}
      <div class="spx-product__variant-picker" data-spx-variant-picker data-analytics-block-type="variant_picker" {{ block.shopify_attributes }}>
        {% assign has_native_material_option = false %}
        {% for option in product.options_with_values %}
          {% assign option_handle = option.name | handleize %}
          {% if option_handle contains 'material' %}{% assign has_native_material_option = true %}{% endif %}
        {% endfor %}

        {% assign linked_material_products = product.metafields.custom.material_products.value %}
        {% unless has_native_material_option %}
          {% if linked_material_products != blank %}
            {% assign current_material_is_linked = false %}
            {% assign current_material_label = product.metafields.custom.material_label.value | default: product.type | default: product.title %}
            {% for material_product in linked_material_products %}
              {% if material_product.id == product.id %}{% assign current_material_is_linked = true %}{% endif %}
            {% endfor %}
            <div class="spx-product__linked-materials spx-product__option-group" data-analytics-event="product_material_change">
              <p><strong>Material:</strong> <span>{{ current_material_label }}</span></p>
              <div class="spx-product__material-options" role="group" aria-label="Material">
                {% unless current_material_is_linked %}
                  <a class="spx-product__material-option is-selected" href="{{ product.url }}" aria-current="page">{{ current_material_label }}</a>
                {% endunless %}
                {% for material_product in linked_material_products %}
                  {% assign material_label = material_product.metafields.custom.material_label.value | default: material_product.type | default: material_product.title %}
                  <a class="spx-product__material-option{% if material_product.id == product.id %} is-selected{% endif %}" href="{{ material_product.url }}"{% if material_product.id == product.id %} aria-current="page"{% endif %}>{{ material_label }}</a>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endunless %}

        {% for option in product.options_with_values %}
          {% assign option_name_downcase = option.name | downcase %}
          {% assign option_handle = option.name | handleize %}
          {% assign is_size_option = false %}
          {% assign is_material_option = false %}
          {% assign is_frame_option = false %}
          {% if option_name_downcase contains 'size' or option_name_downcase contains 'größe' %}{% assign is_size_option = true %}{% endif %}
          {% if option_handle contains 'size' or option_handle contains 'gross' %}{% assign is_size_option = true %}{% endif %}
          {% if option_handle contains 'material' %}{% assign is_material_option = true %}{% endif %}
          {% if option_handle contains 'frame' or option_handle contains 'rahmen' %}{% assign is_frame_option = true %}{% endif %}
          {% assign option_display_order = 10 %}
          {% if is_material_option %}{% assign option_display_order = 1 %}{% elsif is_size_option %}{% assign option_display_order = 2 %}{% elsif is_frame_option %}{% assign option_display_order = 3 %}{% endif %}
          <div class="spx-product__option-group{% if is_size_option %} spx-product__size-group{% endif %}{% if is_material_option %} spx-product__material-group{% endif %}{% if is_frame_option %} spx-product__frame-group{% endif %}" style="--spx-option-order: {{ option_display_order }};" data-spx-variant-option data-option-index="{{ option.position | minus: 1 }}">
            <p>
              <strong>{{ option.name }}:</strong>
              <span data-spx-option-output>{{ option.selected_value }}</span>
              {% if is_size_option %}
                <span class="spx-product__size-tools">
                  {% if block.settings.show_size_guide %}
                    <button type="button" data-spx-size-guide aria-haspopup="dialog" aria-label="{{ block.settings.size_guide_label | default: 'Size guide' }}" title="{{ block.settings.size_guide_label | default: 'Size guide' }}">
                      <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 6v4m4-4v4m4-4v4m4-4v4"/></svg>
                    </button>
                  {% endif %}
                </span>
              {% endif %}
            </p>
            {% if block.settings.picker_type == 'dropdown' %}
              <select data-spx-variant-select aria-label="{{ option.name | escape }}">
                {% for value in option.values %}
                  <option value="{{ value | escape }}"{% if value == option.selected_value %} selected{% endif %}{% unless value.available %} disabled{% endunless %}>{{ value }}</option>
                {% endfor %}
              </select>
            {% else %}
              <div class="{% if is_size_option %}spx-product__option-grid{% elsif is_material_option %}spx-product__material-options{% elsif is_frame_option %}spx-product__frame-options{% else %}spx-product__option-row{% endif %}" role="group" aria-label="{{ option.name | escape }}">
                {% for value in option.values %}
                  {% assign option_value_label = value.name | default: value %}
                  {% if is_frame_option %}
                    {% assign frame_tone = 'natural' %}
                    {% assign frame_value_downcase = option_value_label | downcase %}
                    {% if frame_value_downcase contains 'none' or frame_value_downcase contains 'ohne' or frame_value_downcase contains 'no frame' %}{% assign frame_tone = 'none' %}{% endif %}
                    {% if frame_value_downcase contains 'white' or frame_value_downcase contains 'weiss' %}{% assign frame_tone = 'white' %}{% endif %}
                    {% if frame_value_downcase contains 'black' or frame_value_downcase contains 'schwarz' %}{% assign frame_tone = 'black' %}{% endif %}
                    {% if frame_value_downcase contains 'silver' or frame_value_downcase contains 'silber' %}{% assign frame_tone = 'silver' %}{% endif %}
                    {% if frame_value_downcase contains 'gold' %}{% assign frame_tone = 'gold' %}{% endif %}
                    <button type="button" class="spx-product__frame-option{% if value == option.selected_value %} is-selected{% endif %}" data-spx-variant-value data-option-value="{{ option_value_label | escape }}" aria-label="{{ option_value_label | escape }}" aria-pressed="{% if value == option.selected_value %}true{% else %}false{% endif %}" title="{{ option_value_label | escape }}"{% unless value.available %} disabled{% endunless %}><span class="spx-product__frame-swatch spx-product__frame-swatch--{{ frame_tone }}" aria-hidden="true"></span><span class="visually-hidden">{{ option_value_label }}</span></button>
                  {% elsif is_material_option %}
                    <button type="button" class="spx-product__material-option{% if value == option.selected_value %} is-selected{% endif %}" data-spx-variant-value data-option-value="{{ option_value_label | escape }}" aria-pressed="{% if value == option.selected_value %}true{% else %}false{% endif %}"{% unless value.available %} disabled{% endunless %}>{{ option_value_label }}</button>
                  {% else %}
                    <button type="button"{% if value == option.selected_value %} class="is-selected"{% endif %} data-spx-variant-value data-option-value="{{ option_value_label | escape }}" aria-pressed="{% if value == option.selected_value %}true{% else %}false{% endif %}"{% unless value.available %} disabled{% endunless %}>{{ option_value_label }}{% if is_size_option and block.settings.popular_size != blank and option_value_label == block.settings.popular_size %}<span class="spx-product__popular">{{ block.settings.popular_size_label | default: 'Bestseller' }}</span>{% endif %}</button>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-spx-variant-id>
        <script type="application/json" data-spx-variant-data>{{ product.variants | json }}</script>
      </div>
    {% endunless %}

  {% when 'buy_button' %}
    <form class="spx-product__cart-form" method="post" action="{{ routes.cart_add_url }}" data-spx-cart-form data-spx-cart-add-url="{{ routes.cart_add_url }}.js" data-spx-cart-url="{{ routes.cart_url }}.js" data-analytics-block-type="buy_button" {{ block.shopify_attributes }}>
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-spx-cart-variant-id>
      <input type="hidden" name="quantity" value="1">
      {% if block.settings.show_hanging_kit %}
        {% assign hanging_kit_property_name = block.settings.hanging_kit_property_name | default: 'Hanging kit' %}
        {% assign hanging_kit_property_value = block.settings.hanging_kit_property_value | default: 'Yes' %}
        <div class="spx-product__addon" data-spx-addon>
          <p class="spx-product__addon-heading">{{ block.settings.hanging_kit_heading | default: 'Optional' }}</p>
          <label class="spx-product__addon-control">
            <input type="checkbox" name="properties[{{ hanging_kit_property_name | escape }}]" value="{{ hanging_kit_property_value | escape }}" data-spx-addon-toggle data-spx-addon-variant-id="{{ block.settings.hanging_kit_variant_id | escape }}">
            <span class="spx-product__addon-switch" aria-hidden="true"></span>
            <span class="spx-product__addon-label">{{ block.settings.hanging_kit_label | default: 'Hanging kit' }}</span>
            {% if block.settings.hanging_kit_note != blank %}<span class="spx-product__addon-note">{{ block.settings.hanging_kit_note }}</span>{% endif %}
          </label>
        </div>
      {% endif %}
      <button class="spx-product__cart-button" type="submit" data-spx-cart-button data-analytics-event="product_add_to_cart"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>
        <span class="spx-product__cart-label" data-spx-cart-label>{{ block.settings.label }}</span>
        <span class="spx-product__cart-spinner" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="9"></circle></svg></span>
      </button>
      <p class="spx-product__cart-error" role="alert" data-spx-cart-error hidden></p>
    </form>

  {% when 'volume_discount' %}
    <section class="spx-product__sale" aria-label="Quantity discount promotion" data-analytics-block-type="volume_discount" {{ block.shopify_attributes }}>
      <p class="spx-product__sale-title">{{ block.settings.heading }}</p>
      <p>{{ block.settings.note }}</p>
      <div class="spx-product__discount-table" role="table" aria-label="Quantity discounts">
        <div class="spx-product__discount-row spx-product__discount-row--head" role="row"><span role="columnheader">Buy quantity</span><span role="columnheader">Discount</span></div>
        <div class="spx-product__discount-row" role="row"><span role="cell">Buy 1</span><span role="cell">Get 5% off</span></div>
        <div class="spx-product__discount-row" role="row"><span role="cell">Buy 2</span><span role="cell">Get 10% off</span></div>
        <div class="spx-product__discount-row" role="row"><span role="cell">Buy 3</span><span role="cell">Get 15% off</span></div>
        <div class="spx-product__discount-row" role="row"><span role="cell">Buy 4</span><span role="cell">Get 20% off</span></div>
        <div class="spx-product__discount-row" role="row"><span role="cell">Buy 5+</span><span role="cell">Get 25% off</span></div>
      </div>
    </section>

  {% when 'benefits' %}
    <ul class="spx-product__benefits" data-analytics-block-type="benefits" {{ block.shopify_attributes }}>
      <li><span class="spx-product__benefit-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg></span>{{ block.settings.benefit_1 }}</li>
      <li><span class="spx-product__benefit-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg></span>{{ block.settings.benefit_2 }}</li>
      <li class="is-highlight"><span class="spx-product__benefit-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg></span>{{ block.settings.benefit_3 }}</li>
    </ul>

  {% when 'payment_trust' %}
    <div data-analytics-block-type="payment_trust" {{ block.shopify_attributes }}>
      <div class="spx-product__payment-title"><span></span>{{ block.settings.heading }}<span></span></div>
      <div class="spx-product__payment-methods" aria-label="Accepted payment methods"><span class="is-amex">AMEX</span><span>Pay</span><span class="is-blik">blik</span><span>G Pay</span><span class="is-maestro">●●</span><span class="is-mastercard">●●</span><span class="is-paypal">P</span><span class="is-visa">VISA</span><span class="is-klarna">Klarna.</span></div>
      <p class="spx-product__payment-note"><svg aria-hidden="true" viewBox="0 0 20 20"><path d="M10 2.5 15.5 4v4.4c0 3.5-2.35 6.7-5.5 8.1-3.15-1.4-5.5-4.6-5.5-8.1V4L10 2.5Z"/></svg>{{ block.settings.note }}</p>
    </div>
{% endcase %}
