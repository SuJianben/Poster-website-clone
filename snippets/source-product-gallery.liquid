{% liquid
  assign selected_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media
  assign only_image = true
  for media in product.media
    unless media.media_type == 'image'
      assign only_image = false
    endunless
  endfor
%}

<media-gallery
  id="MediaGallery-{{ section.id }}"
  class="product__media-gallery block relative"
  role="region"
  aria-label="{{ product.title | escape }}"
  data-media-layout="vertical-carousel"
  data-only-image="{{ only_image }}"
  data-enable-image-zoom="true"
  data-enable-desktop-slider="true"
  data-enable-mobile-thumbnails="true"
  data-media-item-gap="8"
  data-media-item-gap-mobile="12"
  data-context="product"
  style="--media-item-gap: 8px; --media-item-gap-mobile: 12px;"
>
  <div id="GalleryStatus-{{ section.id }}" class="visually-hidden" role="status"></div>
  <div class="product__media-gallery-viewer-wrap relative swiper-show-nav-on-hover">
    <div id="GalleryViewer-{{ section.id }}" class="product__media-gallery-viewer blocks-radius swiper">
      <div id="Slider-Gallery-{{ section.id }}" class="product__media-list swiper-wrapper">
        {% for media in product.media %}
          {% liquid
            assign media_loading = 'lazy'
            assign media_fetchpriority = 'low'
            if media.id == selected_media.id
              assign media_loading = 'eager'
              assign media_fetchpriority = 'high'
            endif
          %}
          <div
            id="Slide-{{ section.id }}-{{ media.id }}"
            class="product__media-item swiper-slide{% if media.id == selected_media.id %} is-active{% endif %}"
            data-media-id="{{ media.id }}"
            data-media-type="{{ media.media_type }}"
            data-media-index="{{ forloop.index0 }}"
            {% if media.media_type == 'image' %}
              data-src="{{ media | image_url: width: 2400 }}"
              data-pswp-width="{{ media.preview_image.width }}"
              data-pswp-height="{{ media.preview_image.height }}"
            {% endif %}
          >
            <div class="product__media-item-container relative flex overflow-hidden blocks-radius media-type-{{ media.media_type }}" style="--aspect-ratio: 1;">
              {% if media.media_type == 'image' %}
                <motion-element class="block product__media media-wrapper" data-motion="zoom-out-sm">
                  {{ media.preview_image
                    | image_url: width: 1946
                    | image_tag:
                      widths: '400, 620, 690, 810, 980, 1240, 1380, 1620, 1946',
                      sizes: '(max-width: 767px) calc(100vw - 3rem), calc(((min(1460px, 100vw) * 0.585) - 4.5rem) / 1)',
                      loading: media_loading,
                      fetchpriority: media_fetchpriority,
                      class: 'product__media-image'
                  }}
                </motion-element>
                <div class="product__media-icon btn btn--white btn--small btn--icon btn--icon-circle" aria-hidden="true">
                  <span class="btn__text flex items-center">
                    <svg class="icon icon-zoom icon--medium" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.875" cy="10.875" r="7.875"></circle><path d="m16.443 16.445 4.557 4.557"></path></svg>
                  </span>
                </div>
                <button
                  class="product__media-zoom btn--inherit js-photoswipe--zoom"
                  type="button"
                  data-media-type="image"
                  data-media-index="{{ forloop.index0 }}"
                  aria-label="Zoom {{ product.title | escape }}"
                ></button>
              {% elsif media.media_type == 'video' or media.media_type == 'external_video' %}
                <video-element class="block w-full h-full">
                  {{ media | media_tag: image_size: '1600x', controls: true, preload: 'metadata' }}
                </video-element>
              {% else %}
                <product-model class="block w-full h-full">
                  {{ media | media_tag: image_size: '1600x', toggleable: true }}
                </product-model>
              {% endif %}
            </div>
          </div>
        {% else %}
          <div class="product__media-item swiper-slide">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg product__media-image' }}
          </div>
        {% endfor %}
      </div>
    </div>

    {% if product.media.size > 1 %}
      <div class="swiper-controls swiper-controls--nav-floating swiper-controls--grouped-mobile swiper-controls--pagination-fraction justify-center hidden md:flex">
        <button type="button" class="btn swiper-button swiper-button--drop-shadow swiper-button--blank-mobile swiper-button-prev" name="previous" aria-label="Previous slide">
          <span class="btn__text"><svg class="icon icon-slider-prev rtl-flip-x icon--medium icon--thick" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.75 16.25 6.5 10l6.25-6.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
        </button>
        <button type="button" class="btn swiper-button swiper-button--drop-shadow swiper-button--blank-mobile swiper-button-next" name="next" aria-label="Next slide">
          <span class="btn__text"><svg class="icon icon-slider-next rtl-flip-x icon--medium icon--thick" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m7.5 3.741 6.25 6.25-6.25 6.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
        </button>
      </div>
    {% endif %}
  </div>

  {% if product.media.size > 1 %}
    <div id="GalleryThumbnails-{{ section.id }}" class="product__media-gallery-thumbails swiper">
      <button type="button" class="swiper-button-prev-thumb" aria-label="Scroll up">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="18 15 12 9 6 15"></polyline></svg>
      </button>
      <div id="Slider-Thumbnails-{{ section.id }}" class="thumbnail-list swiper-wrapper">
        {% for media in product.media %}
          <div class="product__thumbs-item swiper-slide" data-target="{{ media.id }}" data-media-position="{{ forloop.index }}">
            <div class="product__thumbs-container relative blocks-radius-md media-wrapper cursor-pointer">
              <div class="product__thumbs-inner" style="--aspect-ratio: {{ media.preview_image.aspect_ratio | default: 1 }}">
                {{ media.preview_image
                  | image_url: width: 400
                  | image_tag:
                    widths: '70, 84, 100, 140, 168, 200, 300, 400',
                    sizes: '(max-width: 460px) calc((100vw - 30px) / 4), (max-width: 767px) calc((100vw - 30px) / 5), (max-width: 1023px) 70px, 84px',
                    loading: 'lazy'
                }}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      <button type="button" class="swiper-button-next-thumb" aria-label="Scroll down">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </button>
    </div>
  {% endif %}
</media-gallery>
