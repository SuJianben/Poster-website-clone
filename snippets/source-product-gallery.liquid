<media-gallery
  id="MediaGallery-{{ section.id }}"
  role="region"
  class="product__media-gallery block relative"
  aria-label="Galerie-Viewer"
  data-source-product-gallery
  data-media-count="{{ product.media.size }}"
  data-media-layout="vertical-carousel"
  style="--media-item-gap: 8px; --media-item-gap-mobile: 12px"
>
  {% if product.media.size > 0 %}
    <div class="visually-hidden" role="status" data-source-product-gallery-status></div>
    <div class="product__media-gallery-viewer-wrap relative swiper-show-nav-on-hover">
      <div class="product__media-gallery-viewer blocks-radius swiper">
        <div class="product__media-list flex swiper-wrapper" data-source-product-media-list aria-live="polite">
          {% for media in product.media %}
            <div
              tabindex="-1"
              class="product__media-item swiper-slide{% if forloop.first %} is-active{% endif %}"
              data-source-product-slide
              data-media-index="{{ forloop.index0 }}"
              data-media-id="{{ media.id }}"
              {% unless forloop.first %}hidden{% endunless %}
            >
              <div class="product__media-item-container relative flex overflow-hidden blocks-radius media-type-image" style="--aspect-ratio: 1;">
                <div class="block product__media media-wrapper">
                  {% if media.preview_image != blank %}
                    <img
                      src="{{ media.preview_image | image_url: width: 1946 }}"
                      srcset="{{ media.preview_image | image_url: width: 400 }} 400w, {{ media.preview_image | image_url: width: 690 }} 690w, {{ media.preview_image | image_url: width: 980 }} 980w, {{ media.preview_image | image_url: width: 1380 }} 1380w, {{ media.preview_image | image_url: width: 1946 }} 1946w"
                      sizes="(max-width: 767px) calc(100vw - 3rem), calc(((min(1460px, 100vw) * 0.585) - 4.5rem) / 1)"
                      width="{{ media.preview_image.width }}"
                      height="{{ media.preview_image.height }}"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                      {% if forloop.first %}fetchpriority="high"{% endif %}
                      alt="{{ media.alt | default: product.title | escape }}"
                    >
                  {% endif %}
                </div>
                <div class="product__media-icon btn btn--white btn--small btn--icon btn--icon-circle" aria-hidden="true">
                  <svg class="icon icon-zoom icon--medium" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="10.875" cy="10.875" r="7.875"></circle><path d="m16.44 16.45 4.56 4.55"></path>
                  </svg>
                </div>
                <button class="product__media-zoom btn--inherit" type="button" data-source-product-zoom data-media-index="{{ forloop.index0 }}" aria-haspopup="dialog">
                  <span class="visually-hidden">Öffnen Sie das Medium {{ forloop.index }} im Modalformat</span>
                </button>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      <div class="swiper-controls swiper-controls--nav-floating swiper-controls--grouped-mobile justify-center hidden md:flex">
        <button type="button" class="btn swiper-button swiper-button--drop-shadow swiper-button-prev" data-source-product-prev aria-label="Nach links schieben">
          <svg viewBox="0 0 20 20" fill="none"><path d="M12.75 16.25 6.5 10l6.25-6.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="btn swiper-button swiper-button--drop-shadow swiper-button-next" data-source-product-next aria-label="Nach rechts schieben">
          <svg viewBox="0 0 20 20" fill="none"><path d="m7.5 3.74 6.25 6.25-6.25 6.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>

    {% if product.media.size > 1 %}
      <div class="product__media-gallery-thumbails swiper">
        <button type="button" class="swiper-button-prev-thumb" data-source-product-thumb-prev aria-label="Nach oben scrollen">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="18 15 12 9 6 15"></polyline></svg>
        </button>
        <div class="thumbnail-list swiper-wrapper" data-source-product-thumbs>
          {% for media in product.media %}
            <div class="product__thumbs-item swiper-slide{% if forloop.first %} swiper-slide-thumb-active{% endif %}" data-media-position="{{ forloop.index }}">
              <button
                class="product__thumbs-container relative blocks-radius-md media-wrapper cursor-pointer"
                type="button"
                data-source-product-thumb
                data-media-index="{{ forloop.index0 }}"
                aria-label="Bild {{ forloop.index }} anzeigen"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                <span class="product__thumbs-inner" style="--aspect-ratio: 1">
                  <img src="{{ media.preview_image | image_url: width: 400 }}" alt="" loading="lazy" width="400" height="400">
                </span>
              </button>
            </div>
          {% endfor %}
        </div>
        <button type="button" class="swiper-button-next-thumb" data-source-product-thumb-next aria-label="Nach unten scrollen">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
      </div>
    {% endif %}

    <dialog class="source-product-lightbox" data-source-product-lightbox aria-label="Produktbild vergrößert">
      <button class="source-product-lightbox__close" type="button" data-source-product-lightbox-close aria-label="Schließen">×</button>
      <button class="source-product-lightbox__arrow source-product-lightbox__arrow--prev" type="button" data-source-product-lightbox-prev aria-label="Previous image">‹</button>
      <img data-source-product-lightbox-image alt="" width="1946" height="1946">
      <button class="source-product-lightbox__arrow source-product-lightbox__arrow--next" type="button" data-source-product-lightbox-next aria-label="Next image">›</button>
    </dialog>
  {% else %}
    <div class="source-product-gallery-empty">{{ 'product-1' | placeholder_svg_tag }}</div>
  {% endif %}
</media-gallery>
