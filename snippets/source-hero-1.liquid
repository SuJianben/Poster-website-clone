{% liquid
  assign fallback_product = all_products['royal-duck-2-0-limited']
  assign hero_product = section.settings.product | default: fallback_product
  assign hero_link = section.settings.link | default: '/collections/bestseller-wandbilder'
  assign primary_badge = section.settings.primary_badge | default: 'Trending'
  assign secondary_badge = section.settings.secondary_badge | default: 'Limited Edition'
  assign desktop_aspect_ratio = 2.2583333333

  if section.settings.desktop_video != blank
    assign desktop_aspect_ratio = 2
  endif
%}


<div id="shopify-section-{{ section.id }}" class="shopify-section" data-source-home-reveal-anchor>
  <style data-shopify>
    #shopify-section-{{ section.id }} .page-width--full { --page-padding: 0; }

    #shopify-section-{{ section.id }} .source-hero__desktop-video {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .source-hero__image-fallback--with-video {
      display: none;
    }

    @media screen and (max-width: 767px), (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .source-hero__desktop-video {
        display: none;
      }

      #shopify-section-{{ section.id }} .source-hero__image-fallback--with-video {
        display: block;
      }
    }
  </style>
  <link href="https://cdn.shopify.com/s/files/1/1004/8690/5937/files/dcc-2ad60c0c4c2e-section-slideshow-with-product.css?v=73116212149192475991780837159" rel="stylesheet" type="text/css" media="all">


  <div class="section section-{{ section.id }} section--slideshow-with-product page-width page-width--full" data-id="{{ section.id }}" role="region" aria-roledescription="Karussell">
    <slideshow-with-product class="block relative swiper slideshow-with-product-wrapper slideshow-with-product-height--adapt" aria-live="polite" aria-atomic="true" data-autoplay="7000" data-section-id="{{ section.id }}" style="--swiper-autoplay-delay: 8000ms;" data-container="full" data-border-radius="10" data-zoom="10%">
      <div class="swiper-wrapper">
        <div class="swiper-slide" role="group" data-index="0" aria-roledescription="Gleiten" data-type="slide" aria-label="1 von 1" tabindex="-1" data-color-scheme="color-scheme-inverse">
          <div class="slideshow-with-product__item-wrap relative flex flex-wrap w-full z-0" style="position: relative; --aspect-ratio: {{ desktop_aspect_ratio }}; --aspect-ratio-mobile: 0.8;">
            <div class="slideshow-with-product__bg bg-image overflow-hidden z--1">
              <div class="slideshow-with-product__slide-bg absolute inset-full">
                {% if section.settings.desktop_video != blank %}
                  {{ section.settings.desktop_video | video_tag: class: 'source-hero__desktop-video', autoplay: true, loop: true, muted: true, playsinline: true, preload: 'metadata', image_size: '2400x' }}
                {% endif %}
                <motion-element class="w-full h-full block" data-motion="zoom-out" hold>
                  <picture class="media media--height media-wrapper block w-full h-full relative overflow-hidden{% if section.settings.desktop_video != blank %} source-hero__image-fallback--with-video{% endif %}">
                    {% if section.settings.mobile_image != blank %}
                      <source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}" width="{{ section.settings.mobile_image.width }}" height="{{ section.settings.mobile_image.height }}">
                    {% else %}
                      <source media="(max-width: 767px)" srcset="https://cdn.shopify.com/s/files/1/1004/8690/5937/files/dcc-f3c0c947c6e8-B1_DE.jpg?v=1780383180&width=1000" width="1080" height="1350">
                    {% endif %}
                    {% if section.settings.desktop_image != blank %}
                      {{ section.settings.desktop_image | image_url: width: 2400 | image_tag: alt: section.settings.desktop_image.alt | default: 'DOTCOMCANVAS®', loading: 'eager', fetchpriority: 'high', sizes: '100vw', is: 'image-lazy' }}
                    {% else %}
                      <img src="https://cdn.shopify.com/s/files/1/1004/8690/5937/files/dcc-fd7bb66c8521-21_9_20DE.jpg?v=1780208892&width=2439" alt="DOTCOMCANVAS®" width="2439" height="1080" loading="eager" fetchpriority="high" sizes="100vw" is="image-lazy">
                    {% endif %}
                  </picture>
                </motion-element>
              </div>
