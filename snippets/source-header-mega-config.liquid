{% if section.settings.menu != blank %}
  <style>
    @media (min-width: 1024px) {
      .source-mega-layout { display:grid; grid-template-columns:170px minmax(0,1fr); min-height:300px; }
      .source-mega-sidebar { display:flex; flex-direction:column; gap:14px; padding:28px 28px 30px 0; border-right:1px solid #ece7df; }
      .source-mega-sidebar a, .source-mega-grid a { color:#222; font-size:14px; line-height:1.35; text-decoration:none; }
      .source-mega-sidebar a:hover, .source-mega-grid a:hover { color:#b42318; }
      .source-mega-content { padding:28px 0 30px 38px; }
      .source-mega-heading { display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; color:#111; font-size:15px; font-weight:700; }
      .source-mega-heading a { color:inherit; text-decoration:none; }
      .source-mega-grid { display:grid; grid-template-columns:repeat(3,minmax(150px,220px)); justify-content:center; gap:18px 28px; margin:0; padding:0; list-style:none; }
      .source-mega-card { display:flex; flex-direction:column; gap:8px; color:#222; font-size:13px; text-decoration:none; }
      .source-mega-card__media { display:block; width:220px; height:150px; overflow:hidden; background:#f3f1ed; }
      .source-mega-card__media img { display:block; width:100%; height:100%; object-fit:contain; transition:transform .25s ease; }
      .source-mega-card:hover .source-mega-card__media img { transform:scale(1.03); }
    }
    @media (max-width: 1023px) {
      .source-mega-sidebar { display:none; }
      .source-mega-content { padding:0; }
      .source-mega-heading { display:none; }
    }
  </style>
  <template data-source-header-mega-config>
    {% for link in section.settings.menu.links %}
      {% if link.links.size > 0 %}
        <template data-source-header-mega-panel data-menu-index="{{ forloop.index0 }}">
          <div class="mega-menu v-scrollable">
            <div class="mega-menu__container color-scheme-1">
              <div class="page-width mega-menu__wrapper source-mega-wrapper" style="max-width:1280px;margin:0 auto;padding-left:24px;padding-right:24px;">
                <div class="source-mega-layout">
                  <aside class="source-mega-sidebar" aria-label="Serier">
                    {% for child in link.links %}
                      <a href="{{ child.url }}">{{ child.title }}</a>
                    {% endfor %}
                  </aside>
                  <div class="source-mega-content">
                    <div class="source-mega-heading">
                      <a href="{{ link.url }}">{{ link.title }}</a>
                      <a href="{{ link.url }}">Visa allt&nbsp;→</a>
                    </div>
                    <ul class="source-mega-grid" role="list">
                      {% for child in link.links %}
                        {% assign mega_collection = child.object %}
                        {% assign mega_image = mega_collection.image | default: mega_collection.featured_image %}
                        {% if mega_image == blank and mega_collection.products_count > 0 %}
                          {% assign mega_image = mega_collection.products.first.featured_image %}
                        {% endif %}
                        <li>
                          <a class="source-mega-card" href="{{ child.url }}">
                            {% if mega_image != blank %}
                              <span class="source-mega-card__media">{{ mega_image | image_url: width: 420 | image_tag: loading: 'lazy', alt: child.title }}</span>
                            {% else %}
                              <span class="source-mega-card__media"></span>
                            {% endif %}
                            <span>{{ child.title }}</span>
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </template>
      {% endif %}
    {% endfor %}
  </template>
{% endif %}
