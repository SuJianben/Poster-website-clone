{% liquid
  assign source_header_menu = section.settings.menu
  if source_header_menu == blank
    assign source_header_menu = linklists['main-menu']
  endif
%}
<style>
  @media (min-width: 1024px) {
    .source-mega-wrapper { max-width: 100%; padding: 0 2.5rem; }
    .source-mega-layout { display:grid; grid-template-columns:minmax(150px, .8fr) minmax(0, 3.2fr); min-height:260px; }
    .source-mega-sidebar { display:flex; flex-direction:column; gap:12px; padding:28px 28px 30px 0; border-right:1px solid #ece7df; }
    .source-mega-sidebar__title, .source-mega-title { color:#111; font-size:13px; font-weight:700; letter-spacing:.02em; text-transform:uppercase; }
    .source-mega-sidebar a, .source-mega-grid a { color:#222; font-size:14px; line-height:1.35; text-decoration:none; transition:color .15s ease; }
    .source-mega-sidebar a:hover, .source-mega-grid a:hover, .source-mega-view-all:hover { color:#b42318; }
    .source-mega-content { padding:28px 0 30px 38px; }
    .source-mega-heading-row { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:18px; }
    .source-mega-title { font-size:15px; }
    .source-mega-view-all { color:#111; font-size:12px; font-weight:700; text-decoration:none; }
    .source-mega-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px 34px; margin:0; padding:0; list-style:none; }
    .source-mega-card { display:flex; flex-direction:column; gap:8px; color:#222; font-size:13px; text-decoration:none; }
    .source-mega-card__media { display:block; aspect-ratio:1.45; overflow:hidden; background:#f3f1ed; }
    .source-mega-card__media img { display:block; width:100%; height:100%; object-fit:cover; transition:transform .25s ease; }
    .source-mega-card:hover .source-mega-card__media img { transform:scale(1.03); }
  }
  @media (max-width: 1023px) {
    .source-mega-sidebar { display:none; }
    .source-mega-content { padding:0; }
    .source-mega-heading-row { display:none; }
  }
</style>
{% capture source_header_navigation %}
[
  {% for link in source_header_menu.links %}
    {
      "title": {{ link.title | json }},
      "url": {{ link.url | json }},
      "has_children": {{ link.links.size | plus: 0 | json }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
{% endcapture %}
<div
  hidden
  data-source-header-config
  data-logo="{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 800 }}{% endif %}"
  data-logo-width="{{ section.settings.logo_width | default: 400 }}"
  data-logo-width-mobile="{{ section.settings.logo_width_mobile | default: 200 }}"
  data-logo-link="{{ section.settings.logo_link | default: routes.root_url }}"
  data-shop-name="{{ shop.name | escape }}"
  data-search-placeholder="{{ section.settings.search_placeholder | default: 'Wonach suchst du?' | escape }}"
  data-navigation="{{ source_header_navigation | strip_newlines | escape }}"
></div>

{% if section.settings.logo == blank %}
  <style data-source-header-logo-fallback>
    .header-section .header__logo > a.header__logo--image {
      max-width: min({{ section.settings.logo_width | default: 400 }}px, calc(100vw - 11rem));
    }

    .header-section .header__logo > a.header__logo--image > img.logo {
      display: none !important;
    }

    .header-section .header__logo > a.header__logo--image::after {
      display: block;
      max-width: 100%;
      overflow: hidden;
      color: currentColor;
      content: {{ shop.name | json }};
      font: inherit;
      letter-spacing: 0;
      line-height: 1.1;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    @media (max-width: 1023px) {
      .header-section .header__logo > a.header__logo--image {
        max-width: min({{ section.settings.logo_width_mobile | default: 200 }}px, calc(100vw - 8rem));
      }
    }
  </style>
{% endif %}

{% comment %}
  The captured header markup contains a visual fallback menu from the reference
  theme. Render a lightweight copy from the selected Shopify menu so mobile and
  desktop always use the same links and labels.
{% endcomment %}
{% if source_header_menu != blank %}
  <template data-source-header-desktop-menu>
    <ul class="flex flex-wrap" role="list">
      {% for link in source_header_menu.links %}
        {% assign source_menu_index = forloop.index0 %}
        <li
          class="inline-flex items-center"
          data-source-desktop-menu-index="{{ source_menu_index }}"
          {% if source_menu_index == 2 %}
            style="--hl-link-color: #9c6161;"
          {% elsif source_menu_index == 3 %}
            style="--hl-link-color: #d71a00;"
          {% endif %}
        >
          {% if link.links.size > 0 %}
            <details
              id="SourceMegaMenu-{{ section.id }}-{{ forloop.index }}"
              is="details-mega"
              trigger="hover"
              level="top"
            >
              <summary data-link="{{ link.url }}" class="z-2 font-navigation">
                {% if forloop.first %}
                  <span class="menu__item flex items-center relative hightlight-link hightlight-link--button">
                    <span class="flex items-center btn btn--primary">
                      <span class="btn__text flex items-center menu__item-text">
                        {{ link.title }}
                        <svg class="icon icon-caret-down icon--2xs icon--thick" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M16.25 7.5L10 13.75L3.75 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </span>
                    </span>
                  </span>
                {% else %}
                  <span class="menu__item flex items-center relative">
                    <span class="flex items-center menu__item-text reversed-link">
                      {{ link.title }}
                      <svg class="icon icon-caret-down icon--2xs icon--thick" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M16.25 7.5L10 13.75L3.75 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </span>
                {% endif %}
              </summary>
              <div class="mega-menu v-scrollable">
                <div class="mega-menu__container color-scheme-1">
                  <div class="page-width mega-menu__wrapper source-mega-wrapper">
                    <div class="source-mega-layout">
                      <aside class="source-mega-sidebar" aria-label="Snabblänkar">
                        <strong class="source-mega-sidebar__title">Snabblänkar</strong>
                        {% for quick_link in source_header_menu.links %}
                          {% unless quick_link.title == link.title %}
                            <a href="{{ quick_link.url }}">{{ quick_link.title }}</a>
                          {% endunless %}
                        {% endfor %}
                      </aside>
                      <div class="source-mega-content">
                        <div class="source-mega-heading-row">
                          <a class="source-mega-title" href="{{ link.url }}">{{ link.title }}</a>
                          <a class="source-mega-view-all" href="{{ link.url }}">Visa allt&nbsp;→</a>
                        </div>
                        <ul class="source-mega-grid" role="list">
                          {% for child in link.links %}
                            <li>
                              <a class="source-mega-card" href="{{ child.url }}">
                                {% assign mega_collection = child.object %}
                                {% assign mega_image = mega_collection.image | default: mega_collection.featured_image %}
                                {% if mega_image == blank and mega_collection.products_count > 0 %}{% assign mega_image = mega_collection.products.first.featured_image %}{% endif %}
                                {% if mega_image != blank %}<span class="source-mega-card__media">{{ mega_image | image_url: width: 420 | image_tag: loading: 'lazy', alt: child.title }}</span>{% endif %}
                                <span>{{ child.title }}</span>
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </details>
          {% else %}
            <a
              href="{{ link.url }}"
              class="menu__item flex relative z-2 font-navigation{% if source_menu_index == 2 or source_menu_index == 3 %} hightlight-link hightlight-link--star_twinkle{% endif %}"
            >
              <span class="reversed-link">{{ link.title }}</span>
              {% if source_menu_index == 2 or source_menu_index == 3 %}
                <svg class="star star-1" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0L7.854 4.146L12 6L7.854 7.854L6 12L4.146 7.854L0 6L4.146 4.146L6 0Z" fill="currentColor"/></svg>
                <svg class="star star-2" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0L7.854 4.146L12 6L7.854 7.854L6 12L4.146 7.854L0 6L4.146 4.146L6 0Z" fill="currentColor"/></svg>
                <svg class="star star-3" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0L7.854 4.146L12 6L7.854 7.854L6 12L4.146 7.854L0 6L4.146 4.146L6 0Z" fill="currentColor"/></svg>
              {% endif %}
            </a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </template>

  <template data-source-header-mobile-menu>
    <ul class="flex-grow" role="list">
      {% for link in source_header_menu.links %}
        <li class="menu-drawer__item" data-source-mobile-menu-index="{{ forloop.index0 }}">
          {% if link.links.size > 0 %}
            <details is="menu-drawer-details" level="top" data-source-mobile-menu-details>
              <summary class="menu-drawer__item-link menu-drawer__item-link-heading flex items-center justify-between">
                {% if forloop.first %}
                  <span class="relative hightlight-link hightlight-link--button"><span class="flex items-center btn btn--primary"><span class="btn__text flex items-center">{{ link.title }}</span></span></span>
                {% else %}
                  <span class="menu-drawer__item-link-text">{{ link.title }}</span>
                {% endif %}
                <svg class="icon icon-caret-right rtl-flip-x icon--2xs icon--thick" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7.5 3.75L13.75 10L7.5 16.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <div class="menu-drawer__submenu absolute z-1 flex flex-col w-full h-full" data-parent>
                <button type="button" class="menu-drawer__item-back-link font-navigation flex items-center gap-2 w-full" aria-label="Back to {{ link.title | escape }}">
                  <svg class="icon icon-caret-left rtl-flip-x icon--small icon--thick" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.5 16.25L6.25 10L12.5 3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {{ link.title }}
                </button>
                <ul class="flex flex-col h-full v-scrollable" data-parent role="list">
                  {% if link.url != blank %}
                    <li class="menu-drawer__item menu-drawer__item--sidebar" level="child"><a href="{{ link.url }}" class="menu-drawer__item-link flex items-center justify-between">View all {{ link.title }}</a></li>
                  {% endif %}
                  {% for child in link.links %}
                    <li class="menu-drawer__item menu-drawer__item--sidebar" level="child">
                      {% if child.links.size > 0 %}
                        <details is="accordion-details" class="accordion-details">
                          <summary class="menu-drawer__item-link menu-drawer__item-link-heading accordion-details__summary flex items-center justify-between">
                            <span>{{ child.title }}</span>
                            <svg class="icon icon-plus-toggle icon--2xs icon--thick" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path class="horizontal" d="M3.125 10H16.875" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path class="vertical" d="M10 3.125V16.875" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          </summary>
                          <div class="flex flex-col w-full">
                            <ul class="source-mobile-menu-collection-grid w-full" role="list">
                              {% if child.url != blank %}
                                <li class="menu-drawer__item source-mobile-menu-collection-item--text"><a href="{{ child.url }}" class="menu-drawer__item-link flex items-center justify-between">View all {{ child.title }}</a></li>
                              {% endif %}
                              {% for grandchild in child.links %}
                                {% if grandchild.type == 'collection_link' %}
                                  {% assign menu_collection = grandchild.object %}
                                  {% assign menu_collection_image = menu_collection.image | default: menu_collection.featured_image %}
                                  {% if menu_collection_image == blank and menu_collection.products_count > 0 %}
                                    {% assign menu_collection_image = menu_collection.products.first.featured_image %}
                                  {% endif %}
                                  <li class="menu-drawer__item source-mobile-menu-collection-item">
                                    <a href="{{ grandchild.url }}" class="source-mobile-menu-collection-card">
                                      <span class="source-mobile-menu-collection-card__media">
                                        {% if menu_collection_image != blank %}
                                          {{ menu_collection_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '240,360,480,600', sizes: '(max-width: 1023px) 45vw', alt: grandchild.title }}
                                        {% endif %}
                                      </span>
                                      <span class="source-mobile-menu-collection-card__title">{{ grandchild.title }}</span>
                                    </a>
                                  </li>
                                {% else %}
                                  <li class="menu-drawer__item source-mobile-menu-collection-item--text"><a href="{{ grandchild.url }}" class="menu-drawer__item-link flex items-center justify-between">{{ grandchild.title }}</a></li>
                                {% endif %}
                              {% endfor %}
                            </ul>
                          </div>
                        </details>
                      {% else %}
                        <a href="{{ child.url }}" class="menu-drawer__item-link flex items-center justify-between">{{ child.title }}</a>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </details>
          {% else %}
            <a href="{{ link.url }}" class="menu-drawer__item-link menu-drawer__item-link-heading flex items-center justify-between{% if forloop.index0 == 2 or forloop.index0 == 3 %} hightlight-link hightlight-link--star_twinkle{% endif %}"{% if forloop.index0 == 2 %} style="--hl-link-color: #9c6161;"{% elsif forloop.index0 == 3 %} style="--hl-link-color: #d71a00;"{% endif %}>
              <span>{{ link.title }}</span>
              {% if forloop.index0 == 2 or forloop.index0 == 3 %}
                <svg class="star star-1" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0L7.854 4.146L12 6L7.854 7.854L6 12L4.146 7.854L0 6L4.146 4.146L6 0Z" fill="currentColor"/></svg>
                <svg class="star star-2" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0L7.854 4.146L12 6L7.854 7.854L6 12L4.146 7.854L0 6L4.146 4.146L6 0Z" fill="currentColor"/></svg>
                <svg class="star star-3" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0L7.854 4.146L12 6L7.854 7.854L6 12L4.146 7.854L0 6L4.146 4.146L6 0Z" fill="currentColor"/></svg>
              {% endif %}
            </a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </template>
{% endif %}
{% render 'source-header-mega-config', section: section %}
