{% assign source_footer_logo_width = section.settings.logo_width | default: 95 %}
{% assign source_footer_logo_width_mobile = section.settings.logo_width_mobile | default: 90 %}
{% assign source_footer_logo_alt = section.settings.logo_alt | default: shop.name %}

<div
  class="section section--padding color-scheme-inverse source-footer-custom"
  data-section-index="4"
  style="--section-padding-top: 0px; --section-padding-bottom: 0px;"
>
  <style>
    #shopify-section-{{ section.id }} .massive-footer-logo-container {
      width: 100%;
      position: relative;
      display: flex;
      justify-content: center;
      align-items: flex-end;
      overflow: hidden;
      padding-top: 0;
      background-color: transparent;
    }

    #shopify-section-{{ section.id }} .massive-footer-logo-link {
      display: block;
      width: var(--source-footer-logo-width, 95%);
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .massive-footer-logo-link .massive-footer-logo-image {
      width: 100%;
      max-width: none;
    }

    #shopify-section-{{ section.id }} .massive-footer-logo-image {
      width: var(--source-footer-logo-width, 95%);
      max-width: min(1600px, 100%);
      height: auto;
      display: block;
      margin-bottom: 2%;
      object-fit: contain;
    }

    #shopify-section-{{ section.id }} .massive-footer-logo-text {
      width: 100%;
      margin: 0;
      color: #4a3b32;
      font-size: 16vw;
      font-weight: 900;
      line-height: 0.75;
      letter-spacing: -0.05em;
      text-align: center;
      text-transform: none;
      white-space: nowrap;
    }

    @media screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} .massive-footer-logo-container {
        padding-top: 0;
      }

      #shopify-section-{{ section.id }} .massive-footer-logo-image {
        width: var(--source-footer-logo-width-mobile, 90%);
      }

      #shopify-section-{{ section.id }} .massive-footer-logo-link {
        width: var(--source-footer-logo-width-mobile, 90%);
      }

      #shopify-section-{{ section.id }} .massive-footer-logo-text {
        font-size: 15vw;
      }
    }
  </style>

  <div
    class="massive-footer-logo-container"
    style="--source-footer-logo-width: {{ source_footer_logo_width }}%; --source-footer-logo-width-mobile: {{ source_footer_logo_width_mobile }}%;"
  >
    {% if section.settings.logo_image != blank %}
      {% if section.settings.logo_link != blank %}
        <a class="massive-footer-logo-link" href="{{ section.settings.logo_link }}" aria-label="{{ source_footer_logo_alt | escape }}">
      {% endif %}

      {{
        section.settings.logo_image
        | image_url: width: 2200
        | image_tag:
          class: 'massive-footer-logo-image',
          widths: '480, 720, 960, 1280, 1600, 2200',
          loading: 'lazy',
          alt: source_footer_logo_alt
      }}

      {% if section.settings.logo_link != blank %}
        </a>
      {% endif %}
    {% else %}
      <p class="massive-footer-logo-text">{{ source_footer_logo_alt }}</p>
    {% endif %}
  </div>
</div>
