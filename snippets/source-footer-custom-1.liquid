{% raw %}
<section id="shopify-section-sections--28031812927754__custom_liquid_f9hRqg" class="shopify-section shopify-section-group-footer-group section"><div
  class="section section--padding color-scheme-inverse"
  data-section-index="4"
  style="--section-padding-top: 0px;--section-padding-bottom: 0px;"
>
  <style>
  /* --- CONTAINER FÜR DAS RIESIGE LOGO --- */
  .massive-footer-logo-container {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    overflow: hidden;
    padding-top: 0; /* Abstand nach oben zu den Footer-Links */
    background-color: transparent; /* Gleiche Farbe wie dein Footer-Hintergrund */
  }

  /* --- WENN DU EIN BILD/SVG NUTZT --- */
  .massive-footer-logo-image {
    width: 95%; /* Etwas Platz am Rand, mach 100% für komplett Edge-to-Edge */
    max-width: 1600px; /* Verhindert, dass es auf riesigen Monitoren unscharf wird */
    height: auto;
    display: block;
    margin-bottom: 2%; /* Zieht das Logo eng an den unteren Rand wie im Screenshot */
    object-fit: contain;
  }

  /* --- WENN DU NUR TEXT NUTZT --- */
  .massive-footer-logo-text {
    font-size: 16vw; /* Skaliert dynamisch mit der Bildschirmbreite */
    font-weight: 900; /* Sehr fett */
    line-height: 0.75; /* Zieht den Text in der Höhe eng zusammen */
    text-transform: none;
    letter-spacing: -0.05em; /* Buchstaben rücken näher zusammen */
    color: #4a3b32; /* Dunkelbraun wie im Screenshot - ÄNDERE DIESE FARBE NACH DEINEM WUNSCH */
    margin: 0;
    text-align: center;
    white-space: nowrap;
    width: 100%;
  }

  /* Mobile Anpassungen */
  @media screen and (max-width: 768px) {
    .massive-footer-logo-container {
      padding-top: 0px;
    }
    .massive-footer-logo-text {
      font-size: 15vw; /* Auf dem Handy anpassen, damit alles drauf passt */
    }
    .massive-footer-logo-image {
      width: 90%; /* Auf Mobile komplett bis zum Rand */
    }
  }
</style>

<div class="massive-footer-logo-container">
  
  
  
  <img src="https://cdn.shopify.com/s/files/1/0601/1253/5810/files/DOTCOMCANVAS_Logo_weiss_4.0_b72e12bf-29e0-4e16-934d-b7c402b10524.png?v=1774272498" alt="DOTCOMCANVAS®" class="massive-footer-logo-image">





</div>
</div>


</section>
