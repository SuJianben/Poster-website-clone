{% assign delivery_start = 'now' | date: '%s' | plus: 432000 | date: '%B %e' %}
{% assign delivery_end = 'now' | date: '%s' | plus: 604800 | date: '%B %e' %}
<div class="product__block product__block--trust">
  <ul class="custom-trust-list">
    {% if has_personalizable %}
      <li>
        <span class="custom-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg></span>
        <span>Individually designed for you</span>
      </li>
    {% endif %}
    <li>
      <span class="custom-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></span>
      <span>Immediately Ready to hang</span>
    </li>
    <li>
      <span class="custom-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></span>
      <span>Free worldwide shipping over €49</span>
    </li>
    <li class="custom-trust-highlight">
      <span class="custom-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></span>
      <span>Estimated delivery: {{ delivery_start | strip }} - {{ delivery_end | strip }}</span>
    </li>
  </ul>
</div>
