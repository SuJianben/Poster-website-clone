<div class="shopify-section shopify-section-group-header-group">
  <style>
    .shopify-section-group-header-group .section--scrolling-promotion {
      --section-padding-top: 18px;
      --section-padding-bottom: 16px;
      --h-spacing: 32px;
      --h-spacing-mobile: 19.2px;
      --duration: 15s;
    }
  </style>
  <div class="section section--padding section--scrolling-promotion color-scheme-3">
    <scrolling-promotion data-section-type="scrolling-promotion" data-pause-on-hover class="scrolling-promotion scrolling-promotion--left">
      <div class="promotion">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% if block.settings.text != blank %}
              <div class="promotion__item promotion__item-text" {{ block.shopify_attributes }} style="--text-opacity: 1.0;">
                <div class="block promotion__item-wrap self-center">
                  <div class="promotion__text h4">{{ block.settings.text }}</div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        {% else %}
          {% assign fallback_promotions = '✨ 5% - 25% Rabatt Sommer Sale|🔥 Mehr kaufen, mehr sparen: 5 % auf alles • bis zu 25 % bei 5+ Bildern|📦 Kostenloser Versand' | split: '|' %}
          {% for text in fallback_promotions %}
            <div class="promotion__item promotion__item-text" style="--text-opacity: 1.0;">
              <div class="block promotion__item-wrap self-center">
                <div class="promotion__text h4">{{ text }}</div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </scrolling-promotion>
  </div>
</div>
