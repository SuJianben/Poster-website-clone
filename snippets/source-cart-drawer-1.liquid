{{ 'source-cart.css' | asset_url | stylesheet_tag }}

<cart-drawer
  id="CartDrawer"
  class="drawer cart-drawer drawer--right"
  data-section-id="source-cart-drawer"
  hidden
>
  <div class="fixed-overlay" aria-controls="CartDrawer"></div>
  <div class="drawer__inner color-scheme-1">
    <div id="CartDrawer-source-cart-drawer" class="drawer__content flex flex-col h-full w-full">
      <div class="drawer__header">
        <div class="cart-drawer__message color-scheme-inverse text-center">Schneller und Sicherer Versand!</div>
        <div class="drawer__header-inner cart-drawer__header flex items-center justify-between gap-3">
          <h2 class="drawer__heading h4">
            <span>Ihr Warenkorb</span>
            <cart-count class="cart-count cart-count--blank" data-type="blank">({{ cart.item_count }})</cart-count>
          </h2>
          <button class="drawer__close-btn z-1 static" aria-controls="CartDrawer" type="button" aria-label="Schließen">
            <svg aria-hidden="true" focusable="false" class="icon icon-close icon--large icon--thick" fill="none" viewBox="0 0 24 24">
              <path d="M18.75 5.13496L5.25 18.8544" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M18.75 18.8544L5.25 5.13496" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>

      <div id="CartDrawerEmpty-source-cart-drawer" class="drawer__body flex-grow v-scrollable{% if cart.item_count > 0 %} hidden{% endif %}" data-source-cart-empty>
        <div class="cart-drawer__empty text-center flex flex-col gap-6 md:gap-8">
          <div class="grid gap-3"><p class="h4">Ihr Warenkorb ist derzeit leer.</p></div>
          <a class="btn btn--primary self-center" href="{{ routes.all_products_collection_url }}"><span class="btn__text">Weiter einkaufen</span></a>
        </div>
      </div>

      <div class="drawer__body flex-grow v-scrollable flex flex-col{% if cart.item_count == 0 %} hidden{% endif %}" data-source-cart-body>
        <free-shipping-goal data-cart-total="{{ cart.items_subtotal_price }}" data-minimum-amount="49" class="free-shipping-goal grid gap-2 w-full no-js-hidden">
          <span class="free-shipping-goal__label free-shipping-goal__label--success">Du hast Anspruch auf kostenlosen Versand.</span>
          <span class="free-shipping-goal__label free-shipping-goal__label--default">Geben Sie <strong data-left-to-spend></strong> mehr aus, um kostenlosen Versand zu erhalten!</span>
          <progress-bar class="progress-bar"></progress-bar>
        </free-shipping-goal>
        <div id="CartDrawerBody-source-cart-drawer" class="flex flex-col gap-4 flex-grow">
          <cart-items class="flex-grow">
            <ul role="list" class="flex flex-col gap-4" data-source-cart-items>
              {% for item in cart.items %}
                <li class="cart-item flex flex-col" data-source-cart-line="{{ forloop.index }}">
                  <div class="cart-item__product flex items-start gap-3">
                    <a class="cart-item__media blocks-radius media-wrapper" href="{{ item.url }}" tabindex="-1">
                      {% if item.image %}{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '80,100,160,200', sizes: '(max-width: 767px) 80px, 100px', alt: item.image.alt | default: item.product.title }}{% endif %}
                    </a>
                    <div class="cart-item__details flex-grow flex flex-col gap-3">
                      <div class="flex justify-between gap-3">
                        <div class="grid flex-1">
                          <div class="block"><a href="{{ item.url }}" class="cart-item__title text-pcard-title reversed-link">{{ item.product.title }}</a></div>
                          <div class="cart-item__options">
                            {% for option in item.options_with_values %}<div class="cart-item__option-value text-sm text-subtext"><strong>{{ option.name }}:</strong> {{ option.value }}</div>{% endfor %}
                            {% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% unless property.last == blank or first_character == '_' %}<div class="cart-item__option-value text-sm text-subtext"><strong>{{ property.first }}:</strong> {{ property.last }}</div>{% endunless %}{% endfor %}
                          </div>
                        </div>
                        <button type="button" class="cart-item__remove flex items-center justify-center relative btn-remove" data-source-cart-remove="{{ forloop.index }}" aria-label="{{ item.product.title | escape }} entfernen">
                          <span class="flex"><svg aria-hidden="true" class="icon icon-close icon--small icon--thick" fill="none" viewBox="0 0 24 24"><path d="M18.75 5.13496L5.25 18.8544" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M18.75 18.8544L5.25 5.13496" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span>
                        </button>
                      </div>
                      <div class="cart-item__action flex items-center justify-between gap-3">
                        <quantity-input class="cart-quantity quantity self-end">
                          <button type="button" name="minus" class="quantity__button" aria-label="Menge verringern"><span aria-hidden="true">−</span></button>
                          <input class="quantity__input" type="number" value="{{ item.quantity }}" min="0" step="1" data-source-cart-quantity="{{ forloop.index }}" aria-label="Menge für {{ item.product.title | escape }}">
                          <button type="button" name="plus" class="quantity__button" aria-label="Menge erhöhen"><span aria-hidden="true">+</span></button>
                        </quantity-input>
                        <div class="cart-item__prices text-right flex flex-col gap-2"><span class="price__regular">{{ item.final_line_price | money }}</span></div>
                      </div>
                    </div>
                  </div>
                </li>
              {% endfor %}
            </ul>
          </cart-items>
        </div>
      </div>

      <div id="CartDrawerFooter-source-cart-drawer" class="drawer__footer cart-drawer__footer flex flex-col{% if cart.item_count == 0 %} hidden{% endif %}" data-source-cart-footer>
        <div class="drawer__footer-body drawer__footer-inner-padding">
          <div class="grid gap-1">
            <div class="totals flex justify-between items-center">
              <span class="totals__subtotal font-body-bolder">Zwischensumme</span>
              <span class="font-body-bolder" data-source-cart-total>{{ cart.total_price | money }}</span>
            </div>
            <div class="totals flex justify-between items-center"><span>Versand</span><span class="font-body-bolder">Kostenlos</span></div>
            <div class="tax-note">Steuer inbegriffen. Versand und Rabatte werden im nächsten Schritt berechnet.</div>
          </div>
          <form action="{{ routes.cart_url }}" method="post" class="drawer__footer-buttons w-full">
            <button class="btn btn--primary w-full flex items-center justify-center gap-2" type="submit" name="checkout"><span class="btn__text">JETZT SICHER ZUR KASSE</span></button>
          </form>
        </div>
        <div class="cart-trust-badges text-center w-full"><p>Bestelle ohne Risiko - 100% Geld-zurück-Garantie</p></div>
      </div>
    </div>
  </div>
</cart-drawer>
