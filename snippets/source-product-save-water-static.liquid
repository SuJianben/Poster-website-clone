                    <script>
                      document.addEventListener('DOMContentLoaded', function() {
                        const drawer = document.querySelector('.atelier-drawer');
                        const overlay = document.querySelector('.atelier-drawer-overlay');
                        
                        if (drawer && overlay && drawer.parentElement !== document.body) {
                          document.body.appendChild(overlay);
                          document.body.appendChild(drawer);
                        }

                        document.body.addEventListener('click', function(e) {
                          if (e.target.closest('.js-open-atelier-drawer')) {
                            const activeDrawer = document.querySelector('.atelier-drawer');
                            const activeOverlay = document.querySelector('.atelier-drawer-overlay');
                            
                            if(activeDrawer && activeOverlay) {
                              activeDrawer.classList.add('is-open');
                              activeOverlay.classList.add('is-visible');
                              document.body.style.overflow = 'hidden';
                            }
                          }
                          if (e.target.closest('.js-close-atelier-drawer')) {
                            const activeDrawer = document.querySelector('.atelier-drawer');
                            const activeOverlay = document.querySelector('.atelier-drawer-overlay');
                            
                            if(activeDrawer && activeOverlay) {
                              activeDrawer.classList.remove('is-open');
                              activeOverlay.classList.remove('is-visible');
                              document.body.style.overflow = '';
                            }
                          }
                        });
                      });
