<script>
  /* --- JS FIX: KORRIGIERT "GRÖSSEN" ZU "Größe" --- */
  document.addEventListener('DOMContentLoaded', function() {
    const labels = document.querySelectorAll('legend, .form__label');
    labels.forEach(label => {
      if(label.innerHTML.includes('GRÖSSEN')) {
        label.innerHTML = label.innerHTML.replace(/GRÖSSEN/g, 'Größe');
      } else if(label.innerHTML.includes('Größen')) {
        label.innerHTML = label.innerHTML.replace(/Größen/g, 'Größe');
      }
    });
  });

  /* --- JS FIX: AUTO-SELECT ERSTE SICHTBARE VARIANTE BEI US/CA --- */
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = "template--28031812763914__main";
    const allVariantInputs = Array.from(document.querySelectorAll(`input[type="radio"][data-section="${sectionId}"]`));

    // Nach Optionsgruppe sortieren
    const groups = {};
    allVariantInputs.forEach(inp => {
      if (!groups[inp.name]) groups[inp.name] =[];
      groups[inp.name].push(inp);
    });

    for (const name in groups) {
      const inputs = groups[name];
      const checkedInput = inputs.find(inp => inp.checked);

      // Falls aktuelle Auswahl durch Länderauswahl versteckt ist, oder gar nichts gewählt wurde
      if (!checkedInput || checkedInput.classList.contains('hidden-by-unit')) {
        const firstVisible = inputs.find(inp => !inp.classList.contains('hidden-by-unit') && !inp.disabled);
        if (firstVisible) {
          firstVisible.checked = true;
          // Theme Aktualisierung triggern
          firstVisible.dispatchEvent(new Event('change', { bubbles: true }));
        }
      } else {
        // Falls die normale Variante gewählt ist, triggern um UI mit Shop-Formular synchron zu halten
        checkedInput.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }
  });

