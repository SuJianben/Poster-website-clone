<style>
  /* --- SCHWEBENDES DESIGN DER PFEILE (FIXED BORDER & SLIDE-EFFECT) --- */
  .swiper-button-prev-thumb, 
  .swiper-button-next-thumb {
    display: none; 
    position: absolute !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    z-index: 99 !important;
    
    /* Hintergrund reinweiß und absolut KEIN Rand */
    background: #ffffff !important; 
    border: none !important; /* Entfernt den 1px Rand */
    outline: none !important; /* Entfernt den Fokus-Rand beim Klicken */
    
    /* Größe 50px */
    border-radius: 50% !important;
    width: 50px !important;
    height: 50px !important;
    min-width: 50px !important;
    min-height: 50px !important;
    
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    
    /* Starker Schatten */
    box-shadow: 0 6px 16px rgba(0,0,0,0.4) !important;
    
    color: #000 !important;
    margin: 0 !important;
    padding: 0 !important;
    
    /* Animation-Setup */
    overflow: hidden !important; 
    transition: color 0.3s ease !important;
    -webkit-appearance: none !important; /* Verhindert Safari-Standard-Styles */
  }

  /* Der schwarze Hintergrund (Slide-Effekt) */
  .swiper-button-prev-thumb::before, 
  .swiper-button-next-thumb::before {
    content: "" !important;
    position: absolute !important;
    top: 0 !important;
    left: -101% !important; /* Minimal mehr als 100%, um Blitzer zu vermeiden */
    width: 100% !important;
    height: 100% !important;
    background: #000000 !important;
    transition: left 0.3s ease !important;
    z-index: -1 !important;
    border-radius: 50% !important;
  }

  .swiper-button-prev-thumb:hover::before, 
  .swiper-button-next-thumb:hover::before {
    left: 0 !important;
  }

  .swiper-button-prev-thumb:hover, 
  .swiper-button-next-thumb:hover {
    color: #ffffff !important;
    box-shadow: 0 8px 20px rgba(0,0,0,0.6) !important;
  }

  /* Pfeil-Icon */
  .swiper-button-prev-thumb svg,
  .swiper-button-next-thumb svg {
    display: block !important;
    position: relative !important;
    z-index: 2 !important;
    width: 24px !important;
    height: 24px !important;
    stroke-width: 3 !important; 
    stroke: currentColor !important;
    fill: none !important;
    margin: auto !important;
    transition: stroke 0.3s ease !important;
  }

  /* Unsichtbar wenn nicht scrollbar */
  .swiper-button-disabled {
    opacity: 0 !important; 
    visibility: hidden !important; 
    pointer-events: none !important; 
  }

  @media (min-width: 768px) {
    .swiper-button-prev-thumb, 
    .swiper-button-next-thumb {
      display: flex !important;
    }
    
    .swiper-button-prev-thumb { top: 10px !important; }
    .swiper-button-next-thumb { bottom: 10px !important; }
  }
</style>
