<script>
  (function() {
    const updateBorder = () => {
      const infoBox = document.querySelector('.js-product-info-box');
      const saleBadge = document.querySelector('.price--on-sale'); // Prüft ob der Preis-Container die Sale-Klasse hat
      
      if (!infoBox) return;

      if (saleBadge) {
        // Variante ist im Sale
        infoBox.style.setProperty('--top-border-color', '#cc0033');
        infoBox.style.setProperty('--top-border-width', '2px');
      } else {
        // Variante ist NICHT im Sale -> Zurück zur Tag-Farbe
        const bc = infoBox.getAttribute('data-base-color');
        const bw = infoBox.getAttribute('data-base-width');
        infoBox.style.setProperty('--top-border-color', bc);
        infoBox.style.setProperty('--top-border-width', bw);
      }
    };

    // 1. Ausführen wenn die Seite fertig geladen ist
    window.addEventListener('load', updateBorder);

    // 2. Ausführen wenn sich im Preis-Bereich etwas ändert (Variantenwechsel)
    const priceContainer = document.querySelector('.product__info-container');
    if (priceContainer) {
      const observer = new MutationObserver((mutations) => {
        updateBorder();
      });
      observer.observe(priceContainer, { childList: true, subtree: true });
    }
  })();
</script>
