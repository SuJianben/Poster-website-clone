<div id="shopify-section-{{ section.id }}" class="shopify-section">
  <link href="https://cdn.shopify.com/s/files/1/1004/8690/5937/files/dcc-7b40eebf3333-component-grid-banner.css?v=184135893269335431591780837030" rel="stylesheet" type="text/css" media="all">
  <div class="section section--padding color-scheme-10 page-width page-width--fixed" style="--section-padding-top: 30px; --section-padding-bottom: 80px;" data-id="{{ section.id }}">
    <div class="section__header s__header section__header--vertical spacing--normal rich-text rich-text--tight md:text-center text-center flex flex-col items-center md:items-center">
      <div class="section__header--text s__header--text rich-text rich-text--tight flex-1"><h2 class="section__heading rich-text__heading h1"><motion-element class="block" data-motion="fade-up" data-motion-delay="50">{{ section.settings.heading }}</motion-element></h2></div>
      {% if section.settings.button_label != blank %}<motion-element class="section__header--buttons s__header--buttons rich-text__button block" data-motion="fade-up" data-motion-delay="100"><a class="btn btn--primary btn--with-icon"{% if section.settings.button_link != blank %} href="{{ section.settings.button_link }}"{% endif %}><span class="btn__text">{{ section.settings.button_label }}</span><span class="btn__icon order-last svg-icon svg-icon--caret-right icon--small icon--thick inline-flex"><svg class="icon icon-caret-right" viewBox="0 0 20 20" fill="none"><path d="M7.5 3.75L13.75 10L7.5 16.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a></motion-element>{% endif %}
    </div>
    <div class="grid-banner swipe-mobile"><div class="grid-banner__inner f-grid f-grid--gap-2xs f-grid-auto-rows--medium f-grid--row-gap-2xs swipe-mobile__inner" style="--f-columns-md: 2; --f-columns-lg: 5;">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          {% capture card %}<div class="card-media card-media--auto-height card-media--content-bottom-center card-media--medium relative overflow-hidden hover-wrapper color-scheme-1 blocks-radius"><div class="card-media__media-wrapper relative overflow-hidden block w-full h-full"><motion-element class="block h-full" data-motion="zoom-out-sm"><picture class="card-media__media media-wrapper h-full" style="--aspect-ratio: 0.75; --aspect-ratio-mobile: 0.75;">{{ block.settings.image | image_url: width: 1200 | image_tag: alt: section.settings.heading, loading: 'lazy', class: 'motion-reduce absolute inset-0 w-full h-full hover-scale-up', sizes: '(max-width: 767px) 80vw, 30vw', is: 'image-lazy' }}</picture></motion-element></div></div>{% endcapture %}
          <div class="f-column grid-banner__item w-full" style="--cell-c-span: {{ block.settings.column_span }}; --cell-r-span: {{ block.settings.row_span }};" {{ block.shopify_attributes }}>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}" class="card-media--link focus-inset" aria-label="{{ section.settings.heading | escape }}">{{ card }}</a>{% else %}{{ card }}{% endif %}</div>
        {% endif %}
      {% endfor %}
    </div></div>
  </div>
</div>
