<div class="product__block product__block--collapsible_tab source-product-accordion source-product-accordion--upward{% if mobile_only %} source-product-mobile-only{% endif %}">
  <details id="SourceProductDetails-{{ product.id }}" class="accordion-details" is="accordion-group">
    <summary class="accordion-details__summary flex items-center justify-between">
      <h2 class="h5 inline-richtext">Produktdetaljer</h2>
      <span class="source-product-accordion-icon" aria-hidden="true"></span>
    </summary>
    <div id="SourceProductDetailsContent-{{ product.id }}" class="accordion-details__content rte text-subtext accordion-product-details">
      {% if product.description != blank %}{{ product.description }}{% endif %}
    </div>
  </details>
</div>
<div class="product__block product__block--collapsible_tab source-product-accordion source-product-accordion--downward{% if mobile_only %} source-product-mobile-only{% endif %}">
  <details id="SourceProductShipping-{{ product.id }}" class="accordion-details" is="accordion-group">
    <summary class="accordion-details__summary flex items-center justify-between">
      <h2 class="h5 inline-richtext">Leverans och returer</h2>
      <span class="source-product-accordion-icon" aria-hidden="true"></span>
    </summary>
    <div id="SourceProductShippingContent-{{ product.id }}" class="accordion-details__content rte text-subtext">
      <h3>Leverans</h3>
      <ul><li><strong>Fraktkostnad:</strong> Fri frakt inom Sverige på beställningar över 499 kr.</li><li><strong>Säkerhet:</strong> Snabb och trygg leverans med spårning.</li><li><strong>Leveranstid:</strong> 2–5 arbetsdagar.</li></ul>
      <h3>Returer och byten</h3>
      <p>Du kan returnera eller byta din beställning inom 30 dagar från mottagandet. Personliga produkter kan inte returneras om de inte är defekta.</p>
    </div>
  </details>
</div>
