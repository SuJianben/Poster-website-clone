{% assign collection_button_label = section.settings.collection_label | default: 'Zur Kollektion' %}
<div id="shopify-section-{{ section.id }}" class="shopify-section">
  {{ 'source-featured-collection-base.css' | asset_url | stylesheet_tag }}
  <style data-shopify>
    .section-{{ section.id }} { --section-padding-top: 50px; --section-padding-bottom: 40px; --f-columns-mobile: 2; --f-columns-lg: 5; --f-columns-md: 3; --f-columns-xl: 5; }
    .section-{{ section.id }} .collection-action-bottom .btn { min-width: 160px; justify-content: center; gap: 7px; }
  </style>
  <div class="section section-{{ section.id }} featured-collection source-bestsellers-section section--padding color-scheme-1" data-id="{{ section.id }}">
    <div class="section__container page-width page-width--full">
      <div class="section__wrapper" is="product-tabs" data-section-id="{{ section.id }}">
        <div class="section__header s__header rich-text rich-text--tight md:text-center text-center flex flex-col md:items-center">
          <div class="section__header--text s__header--text rich-text rich-text--tight flex-1">
            <h2 class="rich-text__heading inline-richtext hd2"><motion-element data-motion="fade-up" data-motion-delay="50" class="block">{{ section.settings.heading_prefix }} <em is="highlight-text" class="highlight-text relative inline-block font-normal highlight-text--thick-underline animate" style="--hl-style-color: 230, 217, 197, 1.0;">{{ section.settings.heading_highlight }}</em></motion-element></h2>
          </div>
          <motion-element class="section__header--buttons flex-1 block" data-motion="fade-up" data-motion-delay="100">
            <div class="tabs-nav swipe-mobile swipe-mobile--auto-cols no-js-hidden"><div class="tabs-nav__inner flex flex-wrap md:justify-center swipe-mobile__inner" role="tablist">
              {% for block in section.blocks %}
                {% assign tab_label = block.settings.label | default: block.settings.collection.title %}
                <button class="tabs__btn focus-inset btn btn--underline{% if forloop.first %} active{% endif %}" role="tab" data-index="{{ forloop.index0 }}" data-source-bestsellers-desktop-block="{{ block.id }}" data-source-editor-tab="{{ block.id }}" {{ block.shopify_attributes }}>{{ tab_label }}</button>
              {% endfor %}
            </div></div>
          </motion-element>
        </div>
        <div class="section__content tabs__panels">
          {% for block in section.blocks %}
            {% assign collection_link = block.settings.custom_link | default: block.settings.collection.url %}
            {% assign button_link = section.settings.collection_button_link | default: collection_link %}
            {% capture panel %}
              <div class="tabs__panel featured-collection__content" data-index="{{ forloop.index0 }}" data-id="{{ block.id }}">
                <featured-collection class="block relative swiper swiper-equal-height overflow-visible f-grid--gap-medium swipe-mobile swipe-mobile--2-cols" data-block-id="{{ block.id }}" data-enable-slider="true" data-items="5" data-tablet-items="3" data-laptop-items="5" data-pagination-type="progressbar" data-navigation-position="bottom" id="product-list-{{ block.id }}">
                  <div class="featured-collection__items products-list f-grid f-grid--gap-medium f-grid--row-gap-inherit swiper-wrapper swipe-mobile__inner">
                    {% render 'source-product-shelf-promo-card', image: block.settings.promo_image, heading: block.settings.promo_heading, button_label: block.settings.promo_button_label, link: block.settings.promo_link, fallback_link: collection_link %}
                    {% if block.settings.collection != blank %}
                      {% for product in block.settings.collection.products limit: 12 %}{% if product.featured_image != blank %}{% render 'source-bestsellers-product-card', product: product %}{% endif %}{% endfor %}
                    {% endif %}
                  </div>
                </featured-collection>
                <div class="swiper-controls swiper-controls--grouped swiper-controls--pagination-progressbar hidden md:flex">
                  <button class="swiper-button swiper-button-prev btn" name="previous" aria-label="Nach links schieben"><span class="btn__text"><svg class="icon icon-caret-left rtl-flip-x icon--medium icon--thick" viewBox="0 0 20 20" fill="none"><path d="M12.5 16.25L6.25 10L12.5 3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></button>
                  <div class="swiper-pagination"></div>
                  <button class="swiper-button swiper-button-next btn" name="next" aria-label="Nach rechts schieben"><span class="btn__text"><svg class="icon icon-caret-right rtl-flip-x icon--medium icon--thick" viewBox="0 0 20 20" fill="none"><path d="M7.5 3.75L13.75 10L7.5 16.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></button>
                </div>
                <scroll-progress-bar class="md:hidden" target="product-list-{{ block.id }}"><div class="progress-container"><div class="progress-bar no-empty"></div></div></scroll-progress-bar>
                {% if block.settings.collection != blank %}<div class="collection-action-bottom flex justify-end"><a class="btn btn--primary btn--with-icon" href="{{ button_link }}"><span class="btn__text">{{ collection_button_label }}</span><span class="btn__icon order-last svg-icon svg-icon--arrow-right icon--small icon--thick inline-flex"><svg class="icon icon-arrow-right" viewBox="0 0 18 18" fill="none"><path d="M2.8125 9H15.1875" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M10.125 3.9375L15.1875 9L10.125 14.0625" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a></div>{% endif %}
              </div>
            {% endcapture %}
            {% if forloop.first %}{{ panel }}{% else %}<template data-index="{{ forloop.index0 }}">{{ panel }}</template>{% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
  <section class="source-mobile-bestsellers" data-mobile-bestsellers>
    <header class="source-mobile-bestsellers__header">
      <h2>{{ section.settings.heading_prefix }} <em is="highlight-text" class="highlight-text relative inline-block font-normal highlight-text--thick-underline animate" style="--hl-style-color: 230, 217, 197, 1.0;">{{ section.settings.heading_highlight }}</em></h2>
      <div class="source-mobile-bestsellers__tabs" role="tablist">
        {% for block in section.blocks %}
          {% assign tab_label = block.settings.label | default: block.settings.collection.title %}
          <button class="source-mobile-bestsellers__tab{% if forloop.first %} is-active{% endif %}" type="button" data-mobile-tab="{{ forloop.index0 }}" data-source-bestsellers-mobile-block="{{ block.id }}" data-source-editor-tab="{{ block.id }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">{{ tab_label }}</button>
        {% endfor %}
      </div>
    </header>

    {% for block in section.blocks %}
      <div class="source-mobile-bestsellers__panel{% if forloop.first %} is-active{% endif %}" data-mobile-panel="{{ forloop.index0 }}">
        <div class="source-mobile-bestsellers__track">
          {% if block.settings.collection != blank %}
            {% for product in block.settings.collection.products limit: 12 %}
              {% if product.featured_image != blank %}
                {% render 'source-bestsellers-product-card', product: product %}
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
        <div class="source-mobile-bestsellers__progress" aria-hidden="true"><span></span></div>
        {% if block.settings.collection != blank %}
          {% assign collection_link = block.settings.custom_link | default: block.settings.collection.url %}
          {% assign button_link = section.settings.collection_button_link | default: collection_link %}
          <a class="source-mobile-bestsellers__action" href="{{ button_link }}">{{ collection_button_label }} <span aria-hidden="true">→</span></a>
        {% endif %}
      </div>
    {% endfor %}
  </section>
</div>
<style>
  @media screen and (max-width: 767.98px) {
    .source-bestsellers-section {
      display: none !important;
    }

    .source-mobile-bestsellers {
      display: block;
      padding: 28px 16px 32px;
      background: #fff;
      color: #111;
    }

    .source-mobile-bestsellers__header {
      text-align: center;
    }

    .source-mobile-bestsellers__header h2 {
      margin: 0 0 16px;
      font-size: 31px;
      font-weight: 800;
      line-height: 1.1;
    }

    .source-mobile-bestsellers__header h2 .highlight-text {
      position: relative;
      display: table;
      width: fit-content;
      margin: 0 auto;
      isolation: isolate;
    }

    .source-mobile-bestsellers__header h2 .highlight-text::after {
      position: absolute;
      right: -2px;
      bottom: 5px;
      left: -2px;
      z-index: -1;
      height: 6px;
      background: rgba(var(--hl-style-color));
      content: "";
    }

    .source-mobile-bestsellers__tabs {
      display: flex;
      gap: 26px;
      overflow-x: auto;
      padding: 0 0 11px;
      scrollbar-width: none;
      white-space: nowrap;
    }

    .source-mobile-bestsellers__tabs::-webkit-scrollbar {
      display: none;
    }

    .source-mobile-bestsellers__tab {
      position: relative;
      flex: 0 0 auto;
      padding: 0;
      border: 0;
      background: transparent;
      color: #666;
      font: inherit;
      font-size: 14px;
      font-weight: 500;
      line-height: 1;
    }

    .source-mobile-bestsellers__tab::after {
      position: absolute;
      right: 0;
      bottom: 10px;
      left: 0;
      height: 1px;
      background: currentColor;
      content: "";
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .source-mobile-bestsellers__tab.is-active {
      color: #111;
      font-weight: 600;
    }

    .source-mobile-bestsellers__tab.is-active::after {
      transform: scaleX(1);
    }

    .source-mobile-bestsellers__panel {
      display: none;
    }

    .source-mobile-bestsellers__panel.is-active {
      display: block;
    }

    .source-mobile-bestsellers__panel.source-mobile-bestsellers__panel--entering .source-mobile-bestsellers__track > .f-column {
      animation: source-mobile-bestsellers-rise 1250ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .source-mobile-bestsellers__panel.source-mobile-bestsellers__panel--entering .source-mobile-bestsellers__track > .f-column:nth-child(2) {
      animation-delay: 160ms;
    }

    .source-mobile-bestsellers__panel.source-mobile-bestsellers__panel--entering .source-mobile-bestsellers__track > .f-column:nth-child(3) {
      animation-delay: 260ms;
    }

    @keyframes source-mobile-bestsellers-rise {
      from {
        opacity: 0;
        transform: translateY(18px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .source-mobile-bestsellers__track {
      display: flex;
      gap: 14px;
      overflow-x: auto;
      padding: 10px 0 16px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .source-mobile-bestsellers__track::-webkit-scrollbar {
      display: none;
    }

    .source-mobile-bestsellers__track > .f-column {
      display: block !important;
      box-sizing: border-box !important;
      flex: 0 0 calc((100% - 14px) / 2) !important;
      width: calc((100% - 14px) / 2) !important;
      max-width: calc((100% - 14px) / 2) !important;
      min-width: 0 !important;
      scroll-snap-align: start;
    }

    .source-mobile-bestsellers .product-card__image-wrapper,
    .source-mobile-bestsellers .product-card__image,
    .source-mobile-bestsellers .product-card__image img {
      aspect-ratio: 1 / 1 !important;
    }

    .source-mobile-bestsellers .product-card__image-wrapper,
    .source-mobile-bestsellers .product-card__image {
      height: auto !important;
      overflow: hidden !important;
    }

    .source-mobile-bestsellers .product-card__image img {
      display: block !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
    }

    .source-mobile-bestsellers .product-card__info {
      padding-top: 9px;
    }

    .source-mobile-bestsellers .product-card__atelier-badges {
      margin-bottom: 10px !important;
    }

    .source-mobile-bestsellers .atelier-badge {
      max-width: 100%;
      font-size: 7px;
      white-space: nowrap;
    }

    .source-mobile-bestsellers .product-card__title {
      font-size: 12px;
      line-height: 1.35;
      text-transform: uppercase;
    }

    .source-mobile-bestsellers .product-card__material,
    .source-mobile-bestsellers .f-price-item {
      font-size: 12px !important;
    }

    .source-mobile-bestsellers__progress {
      height: 2px;
      margin: 2px 0 20px;
      background: transparent;
    }

    .source-mobile-bestsellers__progress span {
      display: block;
      width: 18%;
      height: 100%;
      background: #111;
      transition: width 180ms linear;
    }

    .source-mobile-bestsellers__action {
      display: flex;
      width: max-content;
      min-width: 160px;
      min-height: 40px;
      align-items: center;
      justify-content: center;
      gap: 7px;
      margin: 0 auto;
      padding: 0 18px;
      border-radius: 8px;
      background: #000;
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
    }

    .source-mobile-bestsellers__action span {
      font-size: 20px;
      line-height: 1;
    }

    .source-bestsellers-section .featured-collection__items > .f-column {
      flex: 0 0 calc((100% - 12px) / 2) !important;
      width: calc((100% - 12px) / 2) !important;
      max-width: calc((100% - 12px) / 2) !important;
    }

    .source-bestsellers-section .product-card__image-wrapper,
    .source-bestsellers-section .product-card__image {
      aspect-ratio: 1 / 1 !important;
      height: auto !important;
      overflow: hidden !important;
    }

    .source-bestsellers-section .product-card__image img {
      display: block !important;
      width: 100% !important;
      height: 100% !important;
      min-height: 0 !important;
      max-height: none !important;
      object-fit: cover !important;
    }
  }

  @media screen and (min-width: 768px) {
    .source-mobile-bestsellers {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .source-mobile-bestsellers__panel.source-mobile-bestsellers__panel--entering .source-mobile-bestsellers__track > .f-column {
      animation: none;
    }
  }
</style>
