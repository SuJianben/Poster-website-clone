{% liquid
  assign secondary_image = product.media[1].preview_image
  assign is_little_artists = false
  assign card_image_style = blank
  if product.tags contains 'Little Artists Big Dreams'
    assign is_little_artists = true
    assign card_image_style = 'object-fit: contain !important; object-position: center center;'
  endif
  assign material = product.type | default: 'Canvas'
  assign is_on_sale = false
  assign display_price = product.price_min
  assign display_compare_at_price = product.compare_at_price_max
  if product.compare_at_price_max > product.price_min
    assign is_on_sale = true
  endif
  if promotion_discount != blank and promotion_discount > 0
    assign promotion_multiplier = 100 | minus: promotion_discount
    assign display_compare_at_price = product.price_min
    assign display_price = product.price_min | times: promotion_multiplier | divided_by: 100
    assign is_on_sale = true
  endif
  assign is_trending = false
  if product.tags contains 'Trending'
    assign is_trending = true
  elsif promotion_discount != blank and promotion_discount > 0
    assign is_trending = true
  endif

  assign atelier_edition_value = product.metafields.custom.atelier_edition.value | default: ''
  assign atelier_edition_key = atelier_edition_value | downcase | strip
  assign atelier_product_tags = product.tags | join: '|' | downcase
  assign has_atelier_edition_metafield = false
  case atelier_edition_key
    when 'limited', 'limited atelier exclusive', 'limited-atelier', 'limited_atelier'
      assign atelier_edition_key = 'limited'
      assign has_atelier_edition_metafield = true
    when 'atelier', 'atelier exclusive', 'silver'
      assign atelier_edition_key = 'atelier'
      assign has_atelier_edition_metafield = true
    when 'essentials', 'essential'
      assign atelier_edition_key = 'essentials'
      assign has_atelier_edition_metafield = true
  endcase
  if has_atelier_edition_metafield == false
    if atelier_product_tags contains 'limited atelier exclusive'
      assign atelier_edition_key = 'limited'
    elsif atelier_product_tags contains 'atelier exclusive'
      assign atelier_edition_key = 'atelier'
    elsif edition_badge != blank
      assign edition_badge_key = edition_badge | downcase | strip
      if edition_badge_key contains 'limited'
        assign atelier_edition_key = 'limited'
      elsif edition_badge_key contains 'atelier'
        assign atelier_edition_key = 'atelier'
      else
        assign atelier_edition_key = 'essentials'
      endif
    else
      assign atelier_edition_key = 'essentials'
    endif
  endif
  case atelier_edition_key
    when 'limited', 'limited atelier exclusive', 'limited-atelier', 'limited_atelier'
      assign atelier_edition_key = 'limited'
      assign atelier_edition_label = 'LIMITED ATELIER EXCLUSIVE'
    when 'atelier', 'atelier exclusive', 'silver'
      assign atelier_edition_key = 'atelier'
      assign atelier_edition_label = 'ATELIER EXCLUSIVE'
    else
      assign atelier_edition_key = 'essentials'
      assign atelier_edition_label = 'ESSENTIALS'
  endcase
%}

<div class="f-column swiper-slide">
  <div class="product-card product-card-style-standard color-inherit{% if is_little_artists %} product-card--little-artists{% endif %}">
    <div class="product-card__wrapper h-full">
      <div class="product-card__image-wrapper{% if secondary_image != blank %} has-second-image{% endif %} color-scheme-1 bg-none">
        <a href="{{ product.url }}" aria-label="{{ product.title | escape }}" tabindex="-1">
          <motion-element data-motion="zoom-out-sm" class="block">
            <div class="media-wrapper product-card__image product-card__image--main loaded" style="--aspect-ratio: 1/1;">
              {% if product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 1080 | image_tag: alt: product.title, loading: 'lazy', class: 'motion-reduce', style: card_image_style, sizes: '(max-width: 767px) calc((100vw - 30px) / 2), (max-width: 1023px) calc((100vw - 30px) / 3), calc(100vw / 5)', is: 'image-lazy' }}
              {% endif %}
            </div>
            {% if secondary_image != blank %}
              <div class="media-wrapper product-card__image product-card__image--second inset-full hidden md:block loaded" style="--aspect-ratio: 1/1;">
                {{ secondary_image | image_url: width: 900 | image_tag: alt: product.title, loading: 'lazy', class: 'motion-reduce', style: card_image_style, sizes: '(max-width: 767px) calc((100vw - 30px) / 2), (max-width: 1023px) calc((100vw - 30px) / 3), calc(100vw / 5)', is: 'image-lazy' }}
              </div>
            {% endif %}
          </motion-element>
        </a>
        {% if is_trending or product.tags contains 'Bestseller' or product.tags contains 'Limited Edition' or product.tags contains 'Personalisierbar' or product.tags contains 'Neuheiten' or is_on_sale %}
          <div class="product-card__badge">
            {% if promotion_discount != blank and promotion_discount > 0 %}<span class="f-badge f-badge--sale" aria-hidden="true">−{{ promotion_discount }}%</span>{% elsif is_on_sale %}<span class="f-badge f-badge--sale" aria-hidden="true">−{{ product.compare_at_price_max | minus: product.price_min | times: 100 | divided_by: product.compare_at_price_max }}%</span>{% endif %}
            {% if is_trending %}<span class="f-badge f-badge--custom f-badge--trending">Populärt</span>{% endif %}
            {% if product.tags contains 'Bestseller' %}<span class="f-badge f-badge--custom f-badge--bestseller">Bästsäljare</span>{% endif %}
            {% if product.tags contains 'Limited Edition' %}<span class="f-badge f-badge--custom f-badge--limited-edition">Begränsad upplaga</span>{% endif %}
            {% if product.tags contains 'Personalisierbar' %}<span class="f-badge f-badge--custom f-badge--personalisierbar">Personligt motiv</span>{% endif %}
            {% if product.tags contains 'Neuheiten' %}<span class="f-badge f-badge--custom f-badge--new">Neu</span>{% endif %}
          </div>
        {% endif %}
      </div>
      <div class="product-card__info text-center">
        <div class="product-card__atelier-badges" style="margin-bottom: 16px; display: flex; flex-wrap: wrap; gap: 4px; justify-content: center;">
          <button class="atelier-badge js-open-atelier-drawer-card atelier-badge--{% if atelier_edition_key == 'atelier' %}silver{% else %}{{ atelier_edition_key }}{% endif %}" type="button" aria-haspopup="dialog" aria-controls="atelier-drawer-title" data-atelier-title="{{ product.metafields.custom.atelier_title.value | escape }}" data-atelier-description="{{ product.metafields.custom.atelier_description.value | escape }}">{{ atelier_edition_label }}<svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="margin-left:3px;"><polyline points="9 18 15 12 9 6"></polyline></svg></button>
        </div>
        <h3 class="product-card__title text-pcard-title" style="min-height: 0; margin-bottom: 2px;"><a class="reversed-link block" href="{{ product.url }}"><span class="reversed-link__text">{{ product.title }}</span></a></h3>
        <p class="product-card__material" style="color: #9a9a9a; font-size: 13px; font-weight: 400; margin: 0 0 2px 0; line-height: 1.2; text-transform: uppercase;">{{ material }}</p>
        <div class="f-price f-price--center{% if is_on_sale %} f-price--on-sale{% endif %}">
          <div class="f-price__regular"><span class="f-price-item f-price-item--regular">{% if product.price_varies %}Ab {% endif %}{% if is_on_sale %}{{ display_compare_at_price | money }}{% else %}{{ display_price | money }}{% endif %}</span></div>
          {% if is_on_sale %}
            <div class="f-price__sale">
              <span class="f-price-item f-price-item--sale">{% if product.price_varies %}Ab {% endif %}{{ display_price | money }}</span>
              <span class="f-price-item f-price-item--regular"><s>{{ display_compare_at_price | money }}</s></span>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
